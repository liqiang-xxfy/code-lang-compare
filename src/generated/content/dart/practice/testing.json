age   # 连分支一起统计</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">dart test </span><span style=\"color:var(--shiki-token-keyword)\">--</span><span style=\"color:var(--shiki-foreground)\">coverage</span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\">coverage </span><span style=\"color:var(--shiki-token-keyword)\">--</span><span style=\"color:var(--shiki-foreground)\">coverage</span><span style=\"color:var(--shiki-token-keyword)\">-</span><span style=\"color:var(--shiki-foreground)\">package</span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\">my_pkg</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\"># 之后用 lcov 的工具把 .info 转成 </span><span style=\"color:var(--shiki-token-constant)\">HTML</span><span style=\"color:var(--shiki-foreground)\"> 报告</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\"># 注意：两个选项</span><span style=\"color:var(--shiki-token-keyword)\">**</span><span style=\"color:var(--shiki-foreground)\">都存在</span><span style=\"color:var(--shiki-token-keyword)\">**</span><span style=\"color:var(--shiki-foreground)\">而且语义不同：一个是目录、一个是文件</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\"># 覆盖率目前只支持在虚拟机或浏览器上跑的测试</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\"># 覆盖率只回答「哪些代码被执行过」，不等于断言有效</span></span></code></pre>",
