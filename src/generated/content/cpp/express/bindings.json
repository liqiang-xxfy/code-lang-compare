\"line\"><span style=\"color:var(--shiki-token-keyword)\">namespace</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">int</span><span style=\"color:var(--shiki-foreground)\"> hidden </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> 3</span><span style=\"color:var(--shiki-foreground)\">; }</span><span style=\"color:var(--shiki-token-comment)\">        // 匿名命名空间：现在的推荐写法</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">struct</span><span style=\"color:var(--shiki-token-function)\"> S</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  int</span><span style=\"color:var(--shiki-foreground)\"> member;</span><span style=\"color:var(--shiki-token-comment)\">                          // 类作用域</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  void</span><span style=\"color:var(--shiki-token-function)\"> f</span><span style=\"color:var(--shiki-foreground)\">() { </span><span style=\"color:var(--shiki-token-keyword)\">int</span><span style=\"color:var(--shiki-foreground)\"> local; (</span><span style=\"color:var(--shiki-token-keyword)\">void</span><span style=\"color:var(--shiki-foreground)\">)local; }</span><span style=\"color:var(--shiki-token-comment)\"> // 函数/块作用域</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">void</span><span style=\"color:var(--shiki-token-function)\"> loop</span><span style=\"color:var(--shiki-foreground)\">() { label</span><span style=\"color:var(--shiki-token-punctuation)\">:</span><span style=\"color:var(--shiki-token-keyword)\"> goto</span><span style=\"color:var(--shiki-foreground)\"> la