n style=\"color:var(--shiki-foreground)\">)   </span><span style=\"color:var(--shiki-token-comment)\">// 推断为 Map&#x3C;String, Int></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">fun</span><span style=\"color:var(--shiki-token-function)\"> double</span><span style=\"color:var(--shiki-foreground)\">(n: </span><span style=\"color:var(--shiki-token-function)\">Int</span><span style=\"color:var(--shiki-foreground)\">) </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> n </span><span style=\"color:var(--shiki-token-keyword)\">*</span><span style=\"color:var(--shiki-token-constant)\"> 2</span><span style=\"color:var(--shiki-token-comment)\">          // 表达式体：连返回类型都能推断</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">fun</span><span style=\"color:var(--shiki-token-function)\"> area</span><span style=\"color:var(--shiki-foreground)\">(r: </span><span style=\"color:var(--shiki-token-function)\">Double</span><span style=\"color:var(--shiki-foreground)\">): </span><span style=\"color:var(--shiki-token-function)\">Double</span><span style=\"color:var(--shiki-foreground)\"> {       </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 块体的返回类型不能省，必须写出来</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  return</span><span style=\"color:var(--shiki-token-constant)\"> 3.14</span><span style=\"color:var(--shiki-token-keyword)\"> *</span><span style=\"color:var(--shiki-foreground)\"> r </span><span style=\"color:var(--shiki-token-keyword)\">*</span><span style=\"color:var(--shiki-foreground)\"> r</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">val</span><span style=\"color:var(--shiki-foreground)\"> n </span><span style=\"color:var(--