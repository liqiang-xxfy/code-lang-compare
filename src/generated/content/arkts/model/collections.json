ki-token-constant)\">m</span><span style=\"color:var(--shiki-foreground)\">.size;                              </span><span style=\"color:var(--shiki-token-comment)\">// 大小直接读</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">m</span><span style=\"color:var(--shiki-token-function)\">.forEach</span><span style=\"color:var(--shiki-foreground)\">((v</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-foreground)\"> k) </span><span style=\"color:var(--shiki-token-keyword)\">=></span><span style=\"color:var(--shiki-foreground)\"> { });            </span><span style=\"color:var(--shiki-token-comment)\">// 遍历回调带着键值类型</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 想拿对象当字典，两条路 —— 键任意时用 Record，键固定时声明形状</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> loose</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> Record</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-constant)\">string</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-constant)\"> number</span><span style=\"color:var(--shiki-foreground)\">> </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> {};   </span><span style=\"color:var(--shiki-token-comment)\">// 官方给的动态键形态</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">loose[</span><span style=\"color:var(--shiki-token-string-expression)\">\"anyKey\"</span><span style=\"color:var(--shiki-foreground)\">] </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-foreground)\">;                        </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 读出来是 number | undefined，用前得判空</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">interface</span><span style=\"color:var(--shiki-token-function)\"> Scores</span><span style=\"color:var(--shiki-foreground)\"> { Ada</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> number</span><span style=\"color:var(--shiki-foreground)\">; Bob</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> number</span><span style=\"color:var(--shiki-foreground)\"> }   </span><span style=\"color:var(--shiki-token-comment)\">// 键在声明里逐个写死</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> s</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> Scores</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-foreground)\"> { Ada</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> 90</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-foreground)\"> Bob</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> 85</span><span style=\"color:var(--shiki-foreground)\"> };</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// s.Carol = 70;                     // —— ⚠ 没声明的键加不上去</span></span></code></pre>",
