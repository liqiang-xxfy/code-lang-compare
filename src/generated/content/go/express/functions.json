>func</span><span style=\"color:var(--shiki-foreground)\">() </span><span style=\"color:var(--shiki-token-keyword)\">int</span><span style=\"color:var(--shiki-foreground)\"> {              </span><span style=\"color:var(--shiki-token-comment)\">// 返回闭包 = 造出一个私有状态</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  c </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-token-constant)\"> 0</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  return</span><span style=\"color:var(--shiki-token-keyword)\"> func</span><span style=\"color:var(--shiki-foreground)\">() </span><span style=\"color:var(--shiki-token-keyword)\">int</span><span style=\"color:var(--shiki-foreground)\"> { c</span><span style=\"color:var(--shiki-token-keyword)\">++</span><span style=\"color:var(--shiki-foreground)\">; </span><span style=\"color:var(--shiki-token-keyword)\">return</span><span style=\"color:var(--shiki-foreground)\"> c }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">for</span><span style=\"color:var(--shiki-foreground)\"> _, v </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-token-keyword)\"> range</span><span style=\"color:var(--shiki-foreground)\"> xs {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  go</span><span style=\"color:var(--shiki-token-keyword)\"> func</span><span style=\"color:var(--shiki-foreground)\">() { fmt.</span><span style=\"color:var(--shiki-token-function)\">Println</span><span style=\"color:var(--shiki-foreground)\">(v) }()             </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 1.22 起每次迭代是新变量，安全</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<spa