      "code": "console.info(\"1 同步\");\nsetTimeout(() => console.info(\"5 宏任务\"));\nPromise.resolve().then(() => console.info(\"3 微任务\"));\n\nasync function f(): Promise<void> {\n  console.info(\"2 await 之前是同步的\");   // ⚠ 这一行不在微任务里\n  await null;\n  console.info(\"4 await 之后进微任务队列\");\n}\nf();\n\n// 结果：1 → 2 → 3 → 4 → 5\n// 官方的说法只有一句：宏任务跑完先跑微任务",
