 // 只写类型，拿到零值</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">type</span><span style=\"color:var(--shiki-token-function)\"> Point</span><span style=\"color:var(--shiki-token-keyword)\"> struct</span><span style=\"color:var(--shiki-foreground)\"> { X, Y </span><span style=\"color:var(--shiki-token-keyword)\">float64</span><span style=\"color:var(--shiki-foreground)\"> }   </span><span style=\"color:var(--shiki-token-comment)\">// 字段必须写类型</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> MaxRetry</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-constant)\"> 3</span><span style=\"color:var(--shiki-token-comment)\">         // 常量可以不带类型（无类型常量）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> Limit</span><span style=\"color:var(--shiki-token-keyword)\"> int</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-constant)\"> 10</span><span style=\"color:var(--shiki-token-comment)\">       // 也可以写类型</span></span></code></pre>",
