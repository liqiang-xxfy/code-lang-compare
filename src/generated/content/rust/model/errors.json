      "code": "use std::error::Error;\nuse std::fmt;\n\n#[derive(Debug)]\nenum ParseError {\n  Empty,\n  BadChar(char),\n}\n\nimpl fmt::Display for ParseError {          // 给人看的信息\n  fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {\n    match self {\n      ParseError::Empty => write!(f, \"输入为空\"),\n      ParseError::BadChar(c) => write!(f, \"非法字符：{}\", c),\n    }\n  }\n}\n\nimpl Error for ParseError {}                // 让它可以被当作标准错误传递\n\nfn parse(s: &str) -> Result<i32, Box<dyn Error>> {   // 统一的错误出口\n  if s.is_empty() { return Err(Box::new(ParseError::Empty)); }\n  Ok(0)\n}",
