or:var(--shiki-foreground)\">}; </span><span style=\"color:var(--shiki-token-keyword)\">return</span><span style=\"color:var(--shiki-foreground)\"> v; }</span><span style=\"color:var(--shiki-token-comment)\">   // 这个没事：返回值优化/移动</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 视图类的东西必须看住源头：</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-foreground)\">string_view sv </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-token-function)\">string</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"临时\"</span><span style=\"color:var(--shiki-foreground)\">);</span><span style=\"color:var(--shiki-token-comment)\">   // ⚠ 语句一结束源字符串就没了 → 悬垂</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-foreground)\">span</span><span style=\"color:var(--shiki-token-keyword)\">&#x3C;int></span><span style=\"color:var(--shiki-foreground)\"> sp </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> v;</span><span style=\"color:var(--shiki-token-comment)\">                        // ⚠ v 一扩容或销毁，sp 就废了</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 迭代器也一样：容器结构一变（push_back 可能扩容），旧迭代器全失效</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">auto</span><span style=\"color:var(--shiki-foreground)\"> it </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> v</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">begin</span><span style=\"color:var(--shiki-foreground)\">();</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">v</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">push_back</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">4</span><span style=\"color:var(--shiki-foreground)\">);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">*</span><span style=\"color:var(--shiki-foreground)\">it;</span><span style=\"color:var(--shiki-token-comment)\">                                          // ⚠ 实跑：读到的是垃圾值</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 唯一能让编译器帮你盯一点的是**常量引用延长临时对象寿命**：</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-foreground)\"> std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-foreground)\">string</span><span style=\"color:var(--shiki-token-keyword)\">&#x26;</span><span style=\"color:var(--shiki-foreground)\"> s </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-token-function)\">string</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"活得久一点\"</span><span style=\"color:var(--shiki-foreground)\">);</span><span style=\"color:var(--shiki-token-comment)\">   // 合法，直到 s 出作用域</span></span></code></pre>",
