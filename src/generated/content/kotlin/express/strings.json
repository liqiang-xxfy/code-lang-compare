          // 三引号：原样保留，转义符不生效</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-string-expression)\">  第一行</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-string-expression)\">  第二行 \\n 这里是真的反斜杠 n</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-string-expression)\">\"\"\"</span><span style=\"color:var(--shiki-foreground)\">.</span><span style=\"color:var(--shiki-token-function)\">trimIndent</span><span style=\"color:var(--shiki-foreground)\">()              </span><span style=\"color:var(--shiki-token-comment)\">// 配套方法：去掉公共缩进</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">val</span><span style=\"color:var(--shiki-foreground)\"> path </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> \"C:\\\\Users\"</span><span style=\"color:var(--shiki-token-comment)\">         // 普通字符串里写 Windows 路径要双写反斜杠</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">val</span><span style=\"color:var(--shiki-foreground)\"> rp </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> \"\"\"C:\\Users\"\"\"</span><span style=\"color:var(--shiki-token-comment)\">        // 三引号里不用 —— 这正是它最常用的一处</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">val</span><span style=\"color:var(--shiki-foreground)\"> concat </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> \"a\"</span><span style=\"color:var(--shiki-token-keyword)\"> +</span><span style=\"color:var(--shiki-token-string-expression)\"> \"b\"</span><span style=\"color:var(--shiki-token-comment)\">         // + 也能拼，但可读性不如模板</span></span></code></pre>",
