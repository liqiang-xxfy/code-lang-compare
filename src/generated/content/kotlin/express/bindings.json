      "code": "val x = 1\nrun {\n  val x = 2                 // ⚠ 合法，但编译器会警告 name shadowed\n  println(x)\n}\n\n// val x = 3                 // —— ⚠ 编译错误：同一作用域里重复声明\n\nclass Inner(val x: Int) { }  // 属性遮蔽外层同名变量：同样只警告\n\nfun f(items: List<String>) {\n  items.forEach { it ->      // ⚠ it 是默认参数名，显式写出来就会遮蔽外层\n    println(it)\n  }\n}",
