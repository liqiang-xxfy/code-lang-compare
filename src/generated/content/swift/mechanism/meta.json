tyle=\"color:var(--shiki-token-comment)\">// 不接收返回值也不警告</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">@objc</span><span style=\"color:var(--shiki-token-keyword)\"> func</span><span style=\"color:var(--shiki-token-function)\"> legacy</span><span style=\"color:var(--shiki-foreground)\">() { }                     </span><span style=\"color:var(--shiki-token-comment)\">// 暴露给 ObjC 运行时</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">@escaping</span><span style=\"color:var(--shiki-token-comment)\">                                   // 标闭包参数会逃逸</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">@propertyWrapper</span><span style=\"color:var(--shiki-token-comment)\">                            // 声明属性包装器（见下）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 最接近「装饰器」的是**属性包装器** ——</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 它能把「读写一个属性」这件事包进一个类型里：</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">@propertyWrapper</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">struct</span><span style=\"color:var(--shiki-token-function)\"> Clamped</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  var</span><span style=\"color:var(--shiki-foreground)\"> wrappedValue: </span><span style=\"color:var(--shiki-token-constant)\">Int</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">didSet</span><span style=\"color:var(--shiki-foreground)\"> { wrappedValue </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-function)\"> min</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color