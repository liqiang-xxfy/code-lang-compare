      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-comment)\"># 运行期：鸭子类型，只看有没有那个方法</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">def</span><span style=\"color:var(--shiki-token-function)\"> area</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-parameter)\">shape</span><span style=\"color:var(--shiki-foreground)\">):</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">    return</span><span style=\"color:var(--shiki-foreground)\"> shape</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">area</span><span style=\"color:var(--shiki-token-punctuation)\">()</span><span style=\"color:var(--shiki-token-comment)\">          # 不检查类型</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\"># 结构化类型：Protocol（给检查器看，不要求继承）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">from</span><span style=\"color:var(--shiki-foreground)\"> typing </span><span style=\"color:var(--shiki-token-keyword)\">import</span><span style=\"color:var(--shiki-foreground)\"> Protocol</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">class</span><span style=\"color:var(--shiki-token-function)\"> Shape</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-function)\">Protocol</span><span style=\"color:var(--shiki-foreground)\">):</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">    def</span><span style=\"color:var(--shiki-token-function)\"> area</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-parameter)\">self</span><span style=\"color:var(--shiki-foreground)\">) </span><span style=\"color:var(--shiki-token-punctuation)\">-></span><span style=\"color:var(--shiki-token-constant)\"> float</span><span style=\"color:var(--shiki-foreground)\">: ...</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">def</span><span style=\"color:var(--shiki-token-function)\"> area2</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-parameter)\">shape</span><span style=\"color:var(--shiki-token-punctuation)\">:</span><span style=\"color:var(--shiki-foreground)\"> Shape) </span><span style=\"color:var(--shiki-token-punctuation)\">-></span><span style=\"color:var(--shiki-token-constant)\"> float</span><span style=\"color:var(--shiki-foreground)\">: ...   </span><span style=\"color:var(--shiki-token-comment)\"># 形状对就行，无需 implements</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\"># 名义类型：ABC（要求继承）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">from</span><span style=\"color:var(--shiki-foreground)\"> abc </span><span style=\"color:var(--shiki-token-keyword)\">import</span><span style=\"color:var(--shiki-foreground)\"> ABC</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-foreground)\"> abstractmethod</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">class</span><span style=\"color:var(--shiki-token-function)\"> Reader</span><span style=\"color:var(--shiki-foreground)\">(ABC):</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">    @abstractmethod</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">    def</span><span style=\"color:var(--shiki-token-function)\"> read</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-parameter)\">self</span><span style=\"color:var(--shiki-foreground)\">) </span><span style=\"color:var(--shiki-token-punctuation)\">-></span><span style=\"color:var(--shiki-token-constant)\"> str</span><span style=\"color:var(--shiki-foreground)\">: ...</span></span></code></pre>",
