yle=\"color:var(--shiki-token-keyword)\"> &#x26;</span><span style=\"color:var(--shiki-foreground)\">v { }               </span><span style=\"color:var(--shiki-token-comment)\">// for 是 IntoIterator 的语法糖，等价于 iter()</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">for</span><span style=\"color:var(--shiki-foreground)\"> x </span><span style=\"color:var(--shiki-token-keyword)\">in</span><span style=\"color:var(--shiki-foreground)\"> v { }                </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 这个写法会拿走 v 的所有权，之后不能再用 v</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">struct</span><span style=\"color:var(--shiki-token-function)\"> Countdown</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-function)\">u32</span><span style=\"color:var(--shiki-foreground)\">);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">impl</span><span style=\"color:var(--shiki-token-function)\"> Iterator</span><span style=\"color:var(--shiki-token-keyword)\"> for</span><span style=\"color:var(--shiki-token-function)\"> Countdown</span><span style=\"color:var(--shiki-foreground)\"> {  </span><span style=\"color:var(--shiki-token-comment)\">// 实现 Iterator 就能用上全套适配器</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  type</span><span style=\"color:var(--shiki-token-function)\"> Item</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-function)\"> u32</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  fn</span><span style=\"color:var(--shiki-token-function)\"> next</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">&#x26;mut</span><span style=\"color:var(--shiki-foreground)\"> self) </span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-function)\"> Option</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-function)\">u32</span><span style=\"color:var(--shiki-foreground)\">> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">    if</span><span style=\"color:var(--shiki-foreground)\"> self</span><span style=\"color:var(--shiki-token-keyword)\">.</span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-token-keyword)\"> ==</span><span style=\"color:var(--shiki-token-constant)\"> 0</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-function)\">None</span><span style=\"color:var(--shiki-foreground)\"> } </span><span style=\"color:var(--shiki-token-keyword)\">else</span><span style=\"color:var(--shiki-foreground)\"> { self</span><span style=\"color:var(--shiki-token-keyword)\">.</span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-token-keyword)\"> -=</span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-foreground)\">; </span><span style=\"color:var(--shiki-token-function)\">Some</span><span style=\"color:var(--shiki-foreground)\">(self</span><span style=\"color:var(--shiki-token-keyword)\">.</span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-token-keyword)\"> +</span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-foreground)\">) }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span></code></pre>",
