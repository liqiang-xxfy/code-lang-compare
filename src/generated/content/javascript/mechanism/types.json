pan><span style=\"color:var(--shiki-token-string-expression)\">\"kind\"</span><span style=\"color:var(--shiki-token-keyword)\"> in</span><span style=\"color:var(--shiki-foreground)\"> x) { }         </span><span style=\"color:var(--shiki-token-comment)\">// 按属性存在性判断</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// TS 在这些检查之后会**自动收窄**类型，不用额外写断言：</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">//   function f(x: string | number) {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">//     if (typeof x === \"string\") x.toUpperCase();  // 这里 x 被收窄成 string</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">//   }</span></span></code></pre>",
