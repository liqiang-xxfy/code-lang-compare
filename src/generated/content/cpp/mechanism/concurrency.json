pan style=\"color:var(--shiki-foreground)\">mutex</span><span style=\"color:var(--shiki-token-keyword)\">></span><span style=\"color:var(--shiki-token-function)\"> ul</span><span style=\"color:var(--shiki-foreground)\">(m);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">  cv</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">wait</span><span style=\"color:var(--shiki-foreground)\">(ul</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-foreground)\"> []{ </span><span style=\"color:var(--shiki-token-keyword)\">return</span><span style=\"color:var(--shiki-token-keyword)\"> !</span><span style=\"color:var(--shiki-token-constant)\">q</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">empty</span><span style=\"color:var(--shiki-foreground)\">(); });</span><span style=\"color:var(--shiki-token-comment)\"> // 醒来要重新检查条件</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  Message msg </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-token-function)\">move</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">q</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">front</span><span style=\"color:var(--shiki-foreground)\">()); </span><span style=\"color:var(--shiki-token-constant)\">q</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">pop</span><span style=\"color:var(--shiki-foreground)\">();</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  return</span><span style=\"color:var(--shiki-foreground)\"> msg;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 想直接要通道得引第三方库，或者等 C++26 的 sender/receiver</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 标准库还给了 std::promise / std::future（单次结果传递）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 另有一条「不用锁」的路线：每个线程一份数据、最后合并 ——</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 在很多场景下比搭通道更简单也更快</span></span></code></pre>",
