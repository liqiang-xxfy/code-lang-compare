      "code": "protocol Drawable {\n  func draw() -> String              // 只写签名\n  var area: Double { get }           // 属性要求也能写\n}\n\n// ⚠ 协议可以带**默认实现**（通过协议扩展）—— 这是 Swift 的标志性能力\nextension Drawable {\n  func describe() -> String { \"面积 \\(area)\" }\n}\n\n// 类型要**显式声明**遵守（名义类型系统）\nstruct Circle: Drawable {\n  var r: Double\n  func draw() -> String { \"○\" }\n  var area: Double { 3.14 * r * r }\n}\n\n// 给改不了源码的类型补协议：在扩展里写\nextension String: Drawable {           // 示例（真实项目里很少这么干）\n  func draw() -> String { self }\n  var area: Double { 0 }\n}\n\n// 组合多个协议\nfunc render(_ item: Drawable & CustomStringConvertible) { }\n\n// `some` 与 `any` 是两种用法（见 duck-typing 那一格）\nfunc make() -> some Drawable { Circle(r: 1) }    // 编译器知道具体类型\nlet boxed: any Drawable = Circle(r: 1)           // 运行期才知道，多一层装箱\n\n// 协议还能被类**继承式**遵守（`: Drawable` 写在父类后面）",
