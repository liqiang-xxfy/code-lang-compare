ken-keyword)\">for</span><span style=\"color:var(--shiki-foreground)\"> (</span><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> i</span><span style=\"color:var(--shiki-token-keyword)\"> in</span><span style=\"color:var(--shiki-foreground)\"> xs) {}              </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 遍历的是**下标**（字符串 \"0\"）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">for</span><span style=\"color:var(--shiki-foreground)\"> (</span><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> k</span><span style=\"color:var(--shiki-token-keyword)\"> in</span><span style=\"color:var(--shiki-foreground)\"> obj) {}             </span><span style=\"color:var(--shiki-token-comment)\">// 遍历对象的键，顺序有约定但别依赖</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">while</span><span style=\"color:var(--shiki-foreground)\"> (n </span><span style=\"color:var(--shiki-token-keyword)\">></span><span style=\"color:var(--shiki-token-constant)\"> 0</span><span style=\"color:var(--shiki-foreground)\">) { n</span><span style=\"color:var(--shiki-token-keyword)\">--</span><span style=\"color:var(--shiki-foreground)\">; }</span></span></code></pre>",
