n style=\"color:var(--shiki-foreground)\">)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 每个 case 结束自动跳出 —— 不需要 break，也不会意外穿透</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">switch</span><span style=\"color:var(--shiki-foreground)\"> {                        </span><span style=\"color:var(--shiki-token-comment)\">// 不带表达式，就当成 if-else 链用</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">case</span><span style=\"color:var(--shiki-foreground)\"> n </span><span style=\"color:var(--shiki-token-keyword)\">&#x3C;</span><span style=\"color:var(--shiki-token-constant)\"> 0</span><span style=\"color:var(--shiki-foreground)\">:</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  fmt.</span><span style=\"color:var(--shiki-token-function)\">Println</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"负\"</span><span style=\"color:var(--shiki-foreground)\">)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">case</span><span style=\"color:var(--shiki-foreground)\"> n </span><span style=\"color:var(--shiki-token-keyword)\">==</span><span style=\"color:var(--shiki-token-constant)\"> 0</span><span style=\"color:var(--shiki-foreground)\">:</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  fmt.</span><span style=\"color:var(--shiki-token-function)\">Println</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"零\"</span><span style=\"color:var(--shiki-foreground)\">)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">switch</span><span style=\"color:var(--shiki-foreground)\"> v </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-foreground)\"> x.(</span><span style=\"color:var(--shiki-token-keyword)\">type</span><span style=\"color:var(--shiki-foreground)\">) {          </span><span style=\"color:var(--shiki-token-comment)\">// 类型开关：按接口的动态类型分支</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">case</span><span style=\"color:var(--shiki-token-keyword)\"> string</span><span style=\"color:var(--shiki-foreground)\">:</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  fmt.</span><span style=\"color:var(--shiki-token-function)\">Println</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"字符串\"</span><span style=\"color:var(--shiki-foreground)\">, v)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">case</span><span style=\"color:var(--shiki-token-keyword)\"> int</span><span style=\"color:var(--shiki-foreground)\">:</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  fmt.</span><span style=\"color:var(--shiki-token-function)\">Println</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"整数\"</span><span style=\"color:var(--shiki-foreground)\">, v)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span></code></pre>",
