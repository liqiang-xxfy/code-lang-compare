      "code": "std::variant<int, std::string> v = \"hi\";\n\n// 取之前必须问「现在是哪个」\nif (auto* s = std::get_if<std::string>(&v)) {\n  s->size();                // 拿到指针才敢用\n}\n\n// visit 让编译器逼你处理每一种可能\nstd::visit([](auto&& x) {\n  using T = std::decay_t<decltype(x)>;\n  if constexpr (std::is_same_v<T, int>) { /* 整数分支 */ }\n  else { /* 字符串分支 */ }\n}, v);\n\n// 基类指针向下转型，失败得到 nullptr 而不是异常\nif (auto* d = dynamic_cast<Derived*>(base)) { d->extra; }",
