style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"状态不对：</span><span style=\"color:var(--shiki-token-keyword)\">${</span><span style=\"color:var(--shiki-foreground)\">e.message</span><span style=\"color:var(--shiki-token-keyword)\">}</span><span style=\"color:var(--shiki-token-string-expression)\">\"</span><span style=\"color:var(--shiki-foreground)\">)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">} </span><span style=\"color:var(--shiki-token-keyword)\">catch</span><span style=\"color:var(--shiki-foreground)\"> (e: </span><span style=\"color:var(--shiki-token-function)\">Exception</span><span style=\"color:var(--shiki-foreground)\">) {            </span><span style=\"color:var(--shiki-token-comment)\">// 多个 catch 从上往下匹配</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">  println</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"别的错\"</span><span style=\"color:var(--shiki-foreground)\">)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 不关心异常对象时可以只写类型</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">try</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-function)\">risky</span><span style=\"color:var(--shiki-foreground)\">() } </span><span style=\"color:var(--shiki-token-keyword)\">catch</span><span style=\"color:var(--shiki-foreground)\"> (_: </span><span style=\"color:var(--shiki-token-function)\">Exception</span><span style=\"color:var(--shiki-foreground)\">) { }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ catch 到的异常类型必须显式写，没有「捕获全部」的简写</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 但 Exception 已经是很宽的兜底了</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 取消协程时抛的 CancellationException 也会被 catch(Exception) 接住 ——</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 协程代码里吞掉它会让取消失效，要单独放行</span></span></code></pre>",
