      "code": "var ages = {'Ada': 30, 'Bob': 25};    // 花括号加冒号 = 映射\nvar mut = <String, int>{};            // ⚠ 空的 {} 是**映射**不是集合，要标注类型\nvar withDefaults = {...ages, 'Eve': 40};   // 展开合并，后面的覆盖前面\nmut['a'] = 1;                         // 下标赋值就是插入\nmut.putIfAbsent('b', () => 2);        // 没有才放\nmut.update('a', (v) => v + 1);        // 有则更新，没有会抛\nmut.update('z', (v) => v + 1, ifAbsent: () => 0);   // 给兜底\n\nages['Ada'];                          // 30\nages['Nobody'];                       // null —— 所以返回类型是 int?\nages.containsKey('Ada');              // 判有没有，比拿 null 可靠\nages.keys; ages.values; ages.entries;\n\nfor (var entry in ages.entries) {     // 遍历\n  print('${entry.key}=${entry.value}');\n}\n\n// 默认实现保持**插入顺序**（底层是哈希表加链表），遍历顺序可预期",
