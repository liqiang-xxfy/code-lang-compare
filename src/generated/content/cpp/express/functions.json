tyle=\"color:var(--shiki-token-function)\"> sink</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-function)\">T</span><span style=\"color:var(--shiki-token-keyword)\">&#x26;&#x26;</span><span style=\"color:var(--shiki-foreground)\"> v);</span><span style=\"color:var(--shiki-token-comment)\">      // 转发引用（万能引用）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 数组参数会**退化成指针** —— 拿不到长度，要额外传</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">void</span><span style=\"color:var(--shiki-token-function)\"> takesArray</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">int</span><span style=\"color:var(--shiki-foreground)\"> arr[]) { </span><span style=\"color:var(--shiki-token-keyword)\">sizeof</span><span style=\"color:var(--shiki-foreground)\">(arr); }</span><span style=\"color:var(--shiki-token-comment)\">   // sizeof 得到的是指针大小</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 标准做法是传 std::span / 传首尾指针 / 传容器引用</span></span></code></pre>",
