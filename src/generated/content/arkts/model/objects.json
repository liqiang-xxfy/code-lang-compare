      "code": "class User {\n  name: string = \"\";\n  constructor(name: string)                // 重载签名：只声明，不实现\n  constructor(id: number)\n  constructor(v: string | number) {        // 唯一的实现体\n    this.name = typeof v === \"string\" ? v : `#${v}`;\n  }\n  static from(name: string): User { return new User(name); }   // 另一种造法：静态工厂\n}\n\nconst u = new User(\"Ada\");          // 按参数匹配合适的签名\nconst w = new User(42);\n// ⚠ 形状相同的字面量不能冒充 —— 类型对不对由名字决定",
