      "code": "const xs: number[] = [1, 2, 3];\nxs.push(4);                     // const 只锁绑定，内容照样能改\nconst ro: readonly number[] = xs;    // 只读视图：编译期禁止改写\n// ro.push(5);                  // —— ⚠ 编译错误：只读数组没有 push\n// ro[0] = 9;                   // —— ⚠ 编译错误：只读视图不能改元素\n\nconst ys = xs;                  // ⚠ 只是别名 —— 改 ys 会改到 xs\nconst zs = [...xs];             // 浅拷贝：顶层独立\nconst objs = [{ n: 1 }];\nconst copy = [...objs];\ncopy[0].n = 9;                  // ⚠ 浅拷贝只到第一层，objs 里那个对象也被改了\n\nconst frozen = Object.freeze(xs);   // 冻结在运行时；接住返回值才拿到只读类型",
