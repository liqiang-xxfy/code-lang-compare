      "code": "let a: string = \"hi\";\n// a = null;                  // —— ⚠ strictNullChecks 下编译错误\n\ndeclare const raw: string | null;   // 外部来的数据：类型里就可能是空\nlet b: string | null = raw;         // 空是类型的一部分，必须显式写出来\n// b.length;                  // —— ⚠ 错误：可能为 null\nb?.length;                    // 可选链：为 null 时整个表达式是 undefined\nlet s: string = b ?? \"默认\";   // 空值合并：只在 null/undefined 时取右边\n\nfunction f(x?: string) { }    // 可选参数的类型是 string | undefined\nf(undefined);                 // 合法：等价于不传\n// f(null);                   // —— ⚠ 错误：null 不能传给可选参数",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">let</span><span style=\"color:var(--shiki-foreground)\"> a</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> string</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-string-expression)\"> \"hi\"</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// a = null;                  // —— ⚠ strictNullChecks 下编译错误</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">declare</span><span style=\"color:var(--shiki-token-keyword)\"> const</span><span style=\"color:var(--shiki-token-constant)\"> raw</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> string</span><span style=\"color:var(--shiki-token-keyword)\"> |</span><span style=\"color:var(--shiki-token-constant)\"> null</span><span style=\"color:var(--shiki-foreground)\">;   </span><span style=\"color:var(--shiki-token-comment)\">// 外部来的数据：类型里就可能是空</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">let</span><span style=\"color:var(--shiki-foreground)\"> b</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> string</span><span style=\"color:var(--shiki-token-keyword)\"> |</span><span style=\"color:var(--shiki-token-constant)\"> null</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-foreground)\"> raw;         </span><span style=\"color:var(--shiki-token-comment)\">// 空是类型的一部分，必须显式写出来</span></span>\n<span class=\"line\"><span style=\"color:var(--sh