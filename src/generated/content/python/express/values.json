      "code": "n = 42                     # 整型是任意精度，不会溢出\nbig = 10 ** 100            # 照样精确\nf = 1.5                    # 浮点是 IEEE 754 双精度\ns = 'text'                 # 单双引号等价\nt = f\"你好，{name}\"         # f-string 插值\nxs = [1, 2, 3]             # list：可变序列\ntup = (1, 2)               # tuple：不可变序列\nd = {\"a\": 1}               # dict：键值对\nst = {1, 2}                # set：去重",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-foreground)\">n </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> 42</span><span style=\"color:var(--shiki-token-comment)\">                     # 整型是任意精度，不会溢出</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">big </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> 10</span><span style=\"color:var(--shiki-token-keyword)\"> **</span><span style=\"color:var(--shiki-token-constant)\"> 100</span><span style=\"color:var(--shiki-token-comment)\">            # 照样精确</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">f </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> 1.5</span><span style=\"color:var(--shiki-token-comment)\">                    # 浮点是 IEEE 754 双精度</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">s </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> 'text'</span><span style=\"color:var(--shiki-token-comment)\">                 # 单双引号等价</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">t </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-keyword)\"> f</span><span style=\"color:var(--shiki-token-string-expression)\">\"你好，</span><span style=\"color:var(--shiki-token-constant)\">{</span><span style=\"color:var(--shiki-foreground)\">name</span><span style=\"color:var(--shiki-token-constant)\">}</span><span style=\"color:var(--shiki-token-string-expression)\">\"</span><span style=\"color:var(--shiki-token-comment)\">         # f-string 插值</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">xs </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> [</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-constant)\"> 2</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-constant)\"> 3</span><span style=\"color:var(--shiki-foreground)\">]             </span><span style=\"color:var(--shiki-token-comment)\"># list：可变序列</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">tup </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> (</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-constant)\"> 2</span><span style=\"color:var(--shiki-foreground)\">)               </span><span style=\"color:var(--shiki-token-comment)\"># tuple：不可变序列</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">d </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-punctuation)\"> {</span><span style=\"color:var(--shiki-token-string-expression)\">\"a\"</span><span style=\"color:var(--shiki-token-punctuation)\">:</span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-token-punctuation)\">}</span><span style=\"color:var(--shiki-token-comment)\">               # dict：键值对</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">st </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-punctuation)\"> {</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-constant)\"> 2</span><span style=\"color:var(--shiki-token-punctuation)\">}</span><span style=\"color:var(--shiki-token-comment)\">                # set：去重</span></span></code></pre>",
