      "code": "class User { id: number = 0; name: string = \"\" }\n\nlet xs: number[] = [1, 2, 3];\n// ⚠ 没有推导式语法 —— 批量构造靠数组方法链\nlet doubles: number[] = xs.map((x: number): number => x * 2);\nlet evens: number[] = xs.filter((x: number): boolean => x % 2 === 0);\n\n// 造映射：Object.fromEntries 被禁用，只能用 Map 逐个填\nlet users: User[] = [];\nlet byId: Map<number, User> = new Map<number, User>();\nfor (const u of users) {\n  byId.set(u.id, u);              // for...of 可用，for...in 不行\n}",
