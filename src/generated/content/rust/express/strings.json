      "code": "let s = String::from(\"hello\");\nlet joined = s.clone() + \" world\";       // ⚠ + 会消耗左边，得先 clone\nlet built = format!(\"{}-{}\", a, b);      // 更常用的拼接方式\n\nlet n = s.len();                          // ⚠ 字节数，不是字符数\nlet chars = s.chars().count();            // 字符（码点）数\nlet up = s.to_uppercase();                // 返回新 String，原地类型没有 toUpperCase\n\n// let c = s[0];                          // —— ⚠ 编译错误：不能用下标取字符\nlet first = s.chars().next().unwrap();    // 要取字符走 chars()\n// let part = &s[0..1];                   // —— ⚠ 若切在字符中间会 panic\n\nfor part in \"a,b,c\".split(',') { }        // 返回迭代器，不是数组\nlet trimmed = \"  hi  \".trim();",
