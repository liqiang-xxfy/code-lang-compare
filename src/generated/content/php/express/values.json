      "code": "// 整数：四种进制 + 数字分隔符\n$dec = 1234;\n$hex = 0x1A;                    // 十六进制 = 26\n$oct = 0o123;                   // 0o 前缀（8.1 起）；旧式写法是前导 0\n$old = 0123;                    // ⚠ 前导 0 = 八进制，所以这是 83 不是 123\n$bin = 0b1111;                  // = 15\n$big = 1_234_567;               // 7.4 起可用下划线分组\n\n// ⚠ 但「前导 0 是八进制」**只对字面量成立** —— 字符串不会\necho \"0123\" + 0;                // 这是 123\n\n// ⚠ 整数溢出**静默变 float**，不报错\necho PHP_INT_MAX + 1;           // 9.2233720368548E+18（float）\n\n// 浮点：两种写法都能写成 float\n$f1 = 1.2e3;                    // = 1200.0\n$f2 = 0.1 + 0.2;                // ⚠ 0.30000000000000004 —— 二进制浮点的老问题\n\n// ⚠ 关键字大小写不敏感：这三种写法是同一个值\n$t = TRUE; $n = Null; $n2 = NULL;\n\n// 字符串里 `+` **不做拼接**（拼接是 `.`）\n// echo \"a\" + \"b\";              // —— ⚠ 8.0 起抛 TypeError: Unsupported operand types",
