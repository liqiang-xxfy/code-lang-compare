      "code": "var code = 2;\nswitch (code) {                       // 传统 switch 语句\n  case 1:\n    print(\"一\");                       // ⚠ 执行完直接跳出，**不需要 break**\n  case 2:\n  case 3:                             // 空的 case 会「落」到下一个\n    print(\"二或三\");                    // 写 break 也合法，只是多余\n  default:\n    print(\"其他\");\n}\n\n// Dart 3：switch 表达式 + 模式匹配\nvar name = switch (code) {\n  1 => \"一\",\n  2 || 3 => \"二或三\",                  // 逻辑或模式\n  >= 4 && <= 9 => \"个位数\",            // 关系模式\n  _ => \"其他\",                         // 通配\n};\n\n// 密封类上漏分支会**编译不过** —— 穷尽性检查\nsealed class Shape { }\nclass Circle extends Shape { }\nclass Square extends Shape { }\n\nString describe(Shape s) => switch (s) {\n  Circle() => \"圆\",                    // 这里不写 default 也合法\n  Square() => \"方\",\n};\n\n// if-case：在普通 if 里用模式\nif ([1, 2] case [int a, int b]) print(a + b);",
