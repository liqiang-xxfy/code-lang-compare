tyle=\"color:var(--shiki-foreground)\"> { self</span><span style=\"color:var(--shiki-token-keyword)\">.</span><span style=\"color:var(--shiki-foreground)\">age }        </span><span style=\"color:var(--shiki-token-comment)\">// 想要只读就用方法暴露</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  pub</span><span style=\"color:var(--shiki-token-keyword)\"> fn</span><span style=\"color:var(--shiki-token-function)\"> set_age</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">&#x26;mut</span><span style=\"color:var(--shiki-foreground)\"> self, a</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> u32</span><span style=\"color:var(--shiki-foreground)\">) { self</span><span style=\"color:var(--shiki-token-keyword)\">.</span><span style=\"color:var(--shiki-foreground)\">age </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> a; }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 外部：User { name: \"Ada\".into(), age: 30 }  // —— ⚠ 编译错误，age 私有</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 只能走 User::new(...) 之类的入口</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 派生 getter 的库：getset / derive_getters</span></span></code></pre>",
