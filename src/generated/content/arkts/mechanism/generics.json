      "code": "function last<T>(x: T[]): T {        // 函数可以泛型\n  return x[x.length - 1];\n}\n\nclass Box<T> {                       // 类和接口也可以\n  value: T;\n  constructor(v: T) { this.value = v; }\n}\n\ninterface Pair<K, V> { first: K; second: V }\n\nconst n: number = last([1, 2, 3]);   // 实参能推断出来，不必写 <number>\nconst b = new Box(\"hi\");\nconst p: Pair<string, number> = { first: \"a\", second: 1 };\n\n// 类型参数可以带默认值\ninterface Cache<T = string> { get(key: string): T | undefined }\n\n// ⚠ 但推断是**受限**的：不能只靠返回类型推出 T，缺了实参就编译报错\n// function empty<T>(): T[] { return [] }\n// const e = empty();                // —— ⚠ 编译错误：得写成 empty<string>()",
