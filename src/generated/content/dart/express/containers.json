color:var(--shiki-foreground)\">mut.</span><span style=\"color:var(--shiki-token-function)\">update</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">'z'</span><span style=\"color:var(--shiki-foreground)\">, (v) </span><span style=\"color:var(--shiki-token-keyword)\">=></span><span style=\"color:var(--shiki-foreground)\"> v </span><span style=\"color:var(--shiki-token-keyword)\">+</span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-foreground)\">, ifAbsent</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-foreground)\"> () </span><span style=\"color:var(--shiki-token-keyword)\">=></span><span style=\"color:var(--shiki-token-constant)\"> 0</span><span style=\"color:var(--shiki-foreground)\">);   </span><span style=\"color:var(--shiki-token-comment)\">// 给兜底</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">ages[</span><span style=\"color:var(--shiki-token-string-expression)\">'Ada'</span><span style=\"color:var(--shiki-foreground)\">];                          </span><span style=\"color:var(--shiki-token-comment)\">// 30</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">ages[</span><span style=\"color:var(--shiki-token-string-expression)\">'Nobody'</span><span style=\"color:var(--shiki-foreground)\">];                       </span><span style=\"color:var(--shiki-token-comment)\">// null —— 所以返回类型是 int?</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">ages.</span><span style=\"color:var(--shiki-token-function)\">containsKey</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">'Ada'</span><span style=\"color:var(--shiki-foreground)\">);              </span><span style=\"color:var(--shiki-token-comment)\">// 判有没有，比拿 null 可靠</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">ages.keys; ages.values; ages.entries;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">for</span><span style=\"color:var(--shiki-foreground)\"> (</span><span style=\"color:var(--shiki-token-keyword)\">var</span><span style=\"color:var(--shiki-foreground)\"> entry </span><span style=\"color:var(--shiki-token-keyword)\">in</span><span style=\"color:var(--shiki-foreground)\"> ages.entries) {     </span><span style=\"color:var(--shiki-token-comment)\">// 遍历</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">  print</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">'</span><span style=\"color:var(--shiki-token-string-expression)\">${entry.key}</span><span style=\"color:var(--shiki-token-string-expression)\">=</span><span style=\"color:var(--shiki-token-string-expression)\">${entry.value}</span><span style=\"color:var(--shiki-token-string-expression)\">'</span><span style=\"color:var(--shiki-foreground)\">);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 默认实现保持**插入顺序**（底层是哈希表加链表），遍历顺序可预期</span></span></code></pre>",
