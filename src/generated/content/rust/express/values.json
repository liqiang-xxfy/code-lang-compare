keyword)\">.</span><span style=\"color:var(--shiki-token-function)\">push</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-token-function)\">u8</span><span style=\"color:var(--shiki-foreground)\">);                  </span><span style=\"color:var(--shiki-token-comment)\">// 由这一行反推出 Vec&#x3C;u8></span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">let</span><span style=\"color:var(--shiki-foreground)\"> parsed</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> u32</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-string-expression)\"> \"42\"</span><span style=\"color:var(--shiki-token-keyword)\">.</span><span style=\"color:var(--shiki-token-function)\">parse</span><span style=\"color:var(--shiki-foreground)\">()</span><span style=\"color:var(--shiki-token-keyword)\">.</span><span style=\"color:var(--shiki-token-function)\">unwrap</span><span style=\"color:var(--shiki-foreground)\">(); </span><span style=\"color:var(--shiki-token-comment)\">// 必须标出目标类型才能解析</span></span></code></pre>",
