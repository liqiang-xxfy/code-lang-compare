      "code": "const a = 'text';                 // 单双引号完全等价\nconst b = \"text\";\nconst name = \"Ada\";\nconst t = `你好，${name}`;         // 反引号：插值 + 可换行\nconst esc = 'it\\'s';              // 转义照旧\nconst ch = \"a\";                   // ⚠ 没有字符类型：长度 1 的 string 就是它\n\n// 类型层多出来的一块：模板字面量类型 —— 把字符串的**形状**写进类型\ntype Id = `id-${number}`;\nconst ok: Id = \"id-42\";           // 通过\n// const bad: Id = \"42\";          // —— ⚠ 编译错误：不以 id- 开头\ntype Getter<K extends string> = `get${Capitalize<K>}`;   // 类型里也能拼接",
