/span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-foreground)\">;            </span><span style=\"color:var(--shiki-token-comment)\">// 也可以显式标注</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// let z;                     // —— ⚠ 编译错误：局部变量声明时就得有值</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">interface</span><span style=\"color:var(--shiki-token-function)\"> Point</span><span style=\"color:var(--shiki-foreground)\"> { x</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> number</span><span style=\"color:var(--shiki-foreground)\">; y</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> number</span><span style=\"color:var(--shiki-foreground)\"> }   </span><span style=\"color:var(--shiki-token-comment)\">// 描述形状，编译后消失</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">class</span><span style=\"color:var(--shiki-token-function)\"> Circle</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  radius</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> number</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-constant)\"> 0</span><span style=\"color:var(--shiki-foreground)\">;         </span><span style=\"color:var(--shiki-token-comment)\">// 字段要写类型，或由初值推断</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">  area</span><span style=\"color:var(--shiki-foreground)\">()</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> number</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">return</span><span style=\"color:var(--shiki-token-constant)\"> 3.14</span><span style=\"color:var(--shiki-token-keyword)\"> *</span><span style=\"color:var(--shiki-token-constant)\"> this</span><span style=\"color:var(--shiki-foreground)\">.radius </span><span style=\"color:var(--shiki-token-keyword)\">*</span><span style=\"color:var(--shiki-token-constant)\"> this</span><span style=\"color:var(--shiki-foreground)\">.radius }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span></code></pre>",
