">),</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">      ParseError</span><span style=\"color:var(--shiki-token-keyword)\">::</span><span style=\"color:var(--shiki-token-function)\">BadChar</span><span style=\"color:var(--shiki-foreground)\">(c) </span><span style=\"color:var(--shiki-token-keyword)\">=></span><span style=\"color:var(--shiki-token-function)\"> write!</span><span style=\"color:var(--shiki-foreground)\">(f, </span><span style=\"color:var(--shiki-token-string-expression)\">\"非法字符：{}\"</span><span style=\"color:var(--shiki-foreground)\">, c),</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">    }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">impl</span><span style=\"color:var(--shiki-token-function)\"> Error</span><span style=\"color:var(--shiki-token-keyword)\"> for</span><span style=\"color:var(--shiki-token-function)\"> ParseError</span><span style=\"color:var(--shiki-foreground)\"> {}                </span><span style=\"color:var(--shiki-token-comment)\">// 让它可以被当作标准错误传递</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">fn</span><span style=\"color:var(--shiki-token-function)\"> parse</span><span style=\"color:var(--shiki-foreground)\">(s</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-keyword)\"> &#x26;</span><span style=\"color:var(--shiki-token-function)\">str</span><span style=\"color:var(--shiki-foreground)\">) </span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-function)\"> Result</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-function)\">i32</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-function)\">Box</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-keyword)\">dyn</span><span style=\"color:var(--shiki-token-function)\"> Error</span><span style=\"color:var(--shiki-foreground)\">>> {   </span><span style=\"color:var(--shiki-token-comment)\">// 统一的错误出口</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  if</span><span style=\"color:var(--shiki-foreground)\"> s</span><span style=\"color:var(--shiki-token-keyword)\">.</span><span style=\"color:var(--shiki-token-function)\">is_empty</span><span style=\"color:var(--shiki-foreground)\">() { </span><span style=\"color:var(--shiki-token-keyword)\">return</span><span style=\"color:var(--shiki-token-function)\"> Err</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-function)\">Box</span><span style=\"color:var(--shiki-token-keyword)\">::</span><span style=\"color:var(--shiki-token-function)\">new</span><span style=\"color:var(--shiki-foreground)\">(ParseError</span><span style=\"color:var(--shiki-token-keyword)\">::</span><span style=\"color:var(--shiki-token-function)\">Empty</span><span style=\"color:var(--shiki-foreground)\">)); }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">  Ok</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-foreground)\">)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span></code></pre>",
