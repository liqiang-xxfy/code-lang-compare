      "code": "function area(r: number): number { return 3.14 * r * r }   // 签名必须写\n\nlet x = 1;                  // 推断出 number\nlet y: number = 1;          // 显式标注\nlet z;                      // ⚠ 隐式 any：赋值前访问会被拦下\n\ninterface Point { x: number; y: number }   // 描述形状，编译后消失\n\nconst K = 10;               // 类型是字面量 10，比 number 更窄\nlet m: 1 | 2 | 3 = 1;       // 联合字面量：只接受这三个值",
