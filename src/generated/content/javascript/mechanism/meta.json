span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> f</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-keyword)\"> new</span><span style=\"color:var(--shiki-token-function)\"> Function</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"return this\"</span><span style=\"color:var(--shiki-foreground)\">)();  </span><span style=\"color:var(--shiki-token-comment)\">// 沙箱逃逸的经典一步</span></span></code></pre>",
