>.</span><span style=\"color:var(--shiki-token-function)\">end</span><span style=\"color:var(--shiki-foreground)\">(); </span><span style=\"color:var(--shiki-token-keyword)\">++</span><span style=\"color:var(--shiki-foreground)\">it) { }</span><span style=\"color:var(--shiki-token-comment)\">   // 手写形态</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 标准库容器、C 数组、initializer_list、以及 **任何提供了</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// begin/end 的自己的类型** 都能 range-for</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// C++20 ranges：把「管道」做进了标准库，而且是**惰性**的</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">for</span><span style=\"color:var(--shiki-foreground)\"> (</span><span style=\"color:var(--shiki-token-keyword)\">auto</span><span style=\"color:var(--shiki-foreground)\"> i </span><span style=\"color:var(--shiki-token-punctuation)\">:</span><span style=\"color:var(--shiki-foreground)\"> std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-foreground)\">views</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-token-function)\">iota</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-foreground)\">) </span><span style=\"color:var(--shiki-token-keyword)\">|</span><span style=\"color:var(--shiki-foreground)\"> std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-foreground)\">views</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-token-function)\">take</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">3</span><s