      "code": "fun sum(vararg nums: Int): Int = nums.sum()   // 函数体内它是 IntArray（不装箱）\n\nsum(1, 2, 3)                 // 直接列出来\nval arr = intArrayOf(1, 2, 3)\nsum(*arr)                    // ⚠ 展开运算符 *：把数组摊成参数\n\nfun log(prefix: String, vararg items: String) { }\nlog(\"x\", \"a\", \"b\")\nlog(\"x\")                     // 一个都不给也合法\n\n// ⚠ 一个函数只能有一个 vararg 参数\n// vararg 之后的参数必须用命名参数传\nfun f(vararg a: Int, last: String) { }\nf(1, 2, last = \"末尾\")",
