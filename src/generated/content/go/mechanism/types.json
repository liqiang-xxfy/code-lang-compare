ki-token-keyword)\">func</span><span style=\"color:var(--shiki-foreground)\"> (</span><span style=\"color:var(--shiki-token-function)\">Robot</span><span style=\"color:var(--shiki-foreground)\">) </span><span style=\"color:var(--shiki-token-function)\">Quack</span><span style=\"color:var(--shiki-foreground)\">() </span><span style=\"color:var(--shiki-token-keyword)\">string</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">return</span><span style=\"color:var(--shiki-token-string-expression)\"> \"哔\"</span><span style=\"color:var(--shiki-foreground)\"> }   </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 没写任何声明，Robot 就是 Quacker</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">func</span><span style=\"color:var(--shiki-token-function)\"> useIt</span><span style=\"color:var(--shiki-foreground)\">(q </span><span style=\"color:var(--shiki-token-function)\">Quacker</span><span style=\"color:var(--shiki-foreground)\">) { </span><span style=\"color:var(--shiki-token-function)\">println</span><span style=\"color:var(--shiki-foreground)\">(q.</span><span style=\"color:var(--shiki-token-function)\">Quack</span><span style=\"color:var(--shiki-foreground)\">()) }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">useIt</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-function)\">Duck</span><span style=\"color:var(--shiki-foreground)\">{})</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">useIt</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-function)\">Robot</span><span style=\"color:var(--shiki-foreground)\">{})             </span><span style=\"color:var(--shiki-token-comment)\">// 编译期检查：有 Quack() 就通过</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 具名类型仍然是具名的：两个字段相同的 struct 是不同类型</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">type</span><span style=\"color:var(--shiki-token-function)\"> A</span><span style=\"color:var(--shiki-token-keyword)\"> struct</span><span style=\"color:var(--shiki-foreground)\">{ X </span><span style=\"color:var(--shiki-token-keyword)\">int</span><span style=\"color:var(--shiki-foreground)\"> }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">type</span><span style=\"color:var(--shiki-token-function)\"> B</span><span style=\"color:var(--shiki-token-keyword)\"> struct</span><span style=\"color:var(--shiki-foreground)\">{ X </span><span style=\"color:var(--shiki-token-keyword)\">int</span><span style=\"color:var(--shiki-foreground)\"> }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// var a A = B{1}          // —— ⚠ 编译错误，要显式转换 A(B{1})</span></span></code></pre>",
