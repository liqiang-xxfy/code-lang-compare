      "lang": "typescript",
      "code": "const m = new Map<string, number>();   // 运行时就是 JavaScript 的 Map\nm.set(\"Ada\", 90);\nm.get(\"nope\");                         // number | undefined —— 类型逼你处理「键不在」\n// m.set(1, 2);                        // —— ⚠ 编译错误：键的类型是 string\n\n// 同一个「字典」，三种类型层的表达\nconst counts: Record<string, number> = { Ada: 90 };   // 键与值的类型写全\ninterface Scores { [name: string]: number }           // 索引签名：键是任意 string\nconst strict: Record<\"a\" | \"b\", number> = { a: 1, b: 2 };   // 键收窄成字面量联合\n// const bad: Record<\"a\" | \"b\", number> = { c: 1 };   // —— ⚠ 编译错误：c 不是允许的键",
