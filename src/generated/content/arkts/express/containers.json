      "code": "const xs: number[] = [1, 2, 3];        // 元素类型写在类型位置\nconst ys: Array<number> = [4, 5];      // 与 number[] 等价的另一种写法\nxs.push(4);                            // 增删改查方法与 JavaScript 相同\nconst doubled = xs.map((x) => x * 2);  // 回调参数自动带上元素类型\nconst first: number = xs[0];           // 下标读到的类型是确定的\n// xs.push(\"x\");                       // —— ⚠ 编译错误：元素类型是 number\n// let loose: any[] = [];              // —— ⚠ 编译错误：any 被禁用，没有兜底类型",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> xs</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> number</span><span style=\"color:var(--shiki-foreground)\">[] </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> [</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-constant)\"> 2</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-constant)\"> 3</span><span style=\"color:var(--shiki-foreground)\">];        </span><span style=\"color:var(--shiki-token-comment)\">// 元素类型写在类型位置</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> ys</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> Array</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-constant)\">number</span><span style=\"color:var(--shiki-foreground)\">> </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> [</span><span style=\"color:var(--shiki-token-constant)\">4</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-constant)\"> 5</span><span style=\"color:var(--shiki-foreground)\">];      </span><span style=\"color:var(--shiki-token-comment)\">// 与 number[] 等价的另一种写法</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">xs</span><span style=\"color:var(--shiki-token-function)\">.push</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">4</span><span style=\"color:var(--shiki-foreground)\">);                            </span><span style=\"color:var(--shiki-token-comment)\">// 增删改查方法与 JavaScript 相同</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> doubled</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-constant)\"> xs</span><span style=\"color:var(--shiki-token-function)\">.map</span><span style=\"color:var(--shiki-foreground)\">((x) </span><span style=\"color:var(--shiki-token-keyword)\">=></span><span style=\"color:var(--shiki-foreground)\"> x </span><span style=\"color:var(--shiki-token-keyword)\">*</span><span style=\"color:var(--shiki-token-constant)\"> 2</span><span style=\"color:var(--shiki-foreground)\">);  </span><span style=\"color:var(--shiki-token-comment)\">// 回调参数自动带上元素类型</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> first</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> number</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-foreground)\"> xs[</span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-foreground)\">];           </span><span style=\"color:var(--shiki-token-comment)\">// 下标读到的类型是确定的</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// xs.push(\"x\");                       // —— ⚠ 编译错误：元素类型是 number</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// let loose: any[] = [];              // —— ⚠ 编译错误：any 被禁用，没有兜底类型</span></span></code></pre>",
