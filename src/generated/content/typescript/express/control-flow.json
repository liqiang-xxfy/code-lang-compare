r(--shiki-foreground)\"> (n </span><span style=\"color:var(--shiki-token-keyword)\">&#x3C;</span><span style=\"color:var(--shiki-token-constant)\"> 3</span><span style=\"color:var(--shiki-foreground)\">);                </span><span style=\"color:var(--shiki-token-comment)\">// 至少执行一次</span></span></code></pre>",
