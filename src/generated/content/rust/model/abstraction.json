e=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 多个 trait 混入：都给默认方法，实现方挑着用</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">trait</span><span style=\"color:var(--shiki-token-function)\"> Loggable</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">fn</span><span style=\"color:var(--shiki-token-function)\"> log</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">&#x26;</span><span style=\"color:var(--shiki-foreground)\">self) { </span><span style=\"color:var(--shiki-token-function)\">println!</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"log\"</span><span style=\"color:var(--shiki-foreground)\">); } }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">impl</span><span style=\"color:var(--shiki-token-function)\"> Greet</span><span style=\"color:var(--shiki-token-keyword)\"> for</span><span style=\"color:var(--shiki-token-function)\"> Admin</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">fn</span><span style=\"color:var(--shiki-token-function)\"> name</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">&#x26;</span><span style=\"color:var(--shiki-foreground)\">self) </span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-function)\"> String</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-string-expression)\">\"admin\"</span><span style=\"color:var(--shiki-token-keyword)\">.</span><span style=\"color:var(--shiki-token-function)\">into</span><span style=\"color:var(--shiki-foreground)\">() } }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">impl</span><span style=\"color:var(--shiki-token-function)\"> Loggable</span><span style=\"color:var(--shiki-token-keyword)\"> for</span><span style=\"color:var(--shiki-token-function)\"> Admin</span><span style=\"color:var(--shiki-foreground)\"> {}</span></span></code></pre>",
