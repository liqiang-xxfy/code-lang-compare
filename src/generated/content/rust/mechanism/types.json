      "code": "fn area(r: f64) -> f64 { 3.14159 * r * r }   // 函数签名必须写全\n\nlet x = 1;                                   // 局部变量可以推断\nlet v: Vec<u8> = Vec::new();                 // 推不出来时必须标注\nlet n: u32 = \"42\".parse().unwrap();          // 目标类型是推断的输入\n\nstruct Point { x: f64, y: f64 }              // 字段必须写类型\nconst MAX: usize = 100;                      // 常量必须写类型\nstatic GLOBAL: i32 = 0;                      // static 也一样",
