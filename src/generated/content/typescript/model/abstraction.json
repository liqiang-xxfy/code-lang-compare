      "code": "interface Shape {                  // 只描述形状，不要求谁显式实现\n  name: string;\n  area(): number;\n}\n\nclass Circle {                     // ⚠ 没写 implements，形状对就算 Shape\n  name = \"圆\";\n  area(): number { return 3.14 * 1 * 1 }\n}\n\nfunction total(xs: Shape[]): number { return xs.reduce((s, x) => s + x.area(), 0) }\ntotal([new Circle()]);             // 结构化：编译期按形状核对\n\ninterface Point { x: number }\ninterface Point { y: number }      // 同名接口自动合并成 { x, y }；type 不能合并",
