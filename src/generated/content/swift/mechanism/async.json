n style=\"color:var(--shiki-token-punctuation)\">)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">let</span><span style=\"color:var(--shiki-token-punctuation)\"> (</span><span style=\"color:var(--shiki-token-function)\">x, y</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-keyword)\"> await</span><span style=\"color:var(--shiki-token-punctuation)\"> (</span><span style=\"color:var(--shiki-token-function)\">a, b</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-token-comment)\">                    // 两个一起等</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 三处与别的语言不同的取舍：</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ ① **没有 `.then` 式链** —— 组合靠「顺序写 await」或者结构化并发，</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 所以不像有的语言那样有一整套组合子 API</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ ② **任务有父子关系**：父任务取消会连带取消子任务</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ ③ **失败的处理**：任务里抛的错误在 `await` 处重新抛出，</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 所以 `try await` 是常见写法，不会静默丢掉</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 想让「可能失败」变成值，标准库有 Result（见 model/errors）</span></span></code></pre>",
