      "code": "// ⚠ 闭包**不会自动继承**父作用域的变量 —— 必须用 `use` 显式引入\n$n = 10;\n$f = function () use ($n) { return $n; };\n$n = 20;\necho $f();                      // ⚠ 10 —— 捕获的是**定义时**的值\n\n// `use (&$n)` 才是按引用\n$g = function () use (&$n) { return $n; };\necho $g();                      // 20\n\n// ⚠ 箭头函数 `fn`（7.4 起）：自动按值捕获，**而且改不到外层**\n$h = fn() => $n;                // 用到哪个就自动捕获哪个\necho $h();                      // 20\n$bad = fn() => $n++;            // ⚠ 合法但无效：捕获的是副本，外面还是 20\n$bad();\necho $n;                        // 20\n\n// 想在箭头函数里改外层，只能退回普通闭包 + `use (&$n)`\n$ok = function () use (&$n) { $n++; };\n\n// `static function` 不绑定 $this —— 在类里用它避免意外持有对象\n$s = static function () { return \"没有 \\$this\"; };\n\n// 类里定义的闭包会自动绑定当前 $this，可以 $c->bindTo($other) 换绑定\n// 闭包不能序列化",
