      "code": "// ⚠ PHP **没有声明关键字** —— 没有 var / let / const，变量就是「$ 开头的名字」\n$count = 0;                     // 第一次赋值就等于「声明」\n\n// ⚠ 名字的大小写规则在同一门语言里有**两套**：\n$name = \"Ada\";                  // 变量名**区分大小写**\n$Name = \"Bob\";                  // ⚠ 所以这与上一行是两个不同的变量\n\nfunction greet(string $who): string { return \"你好，$who\"; }\necho GREET(\"Ada\");              // 函数名**不区分大小写** —— 这样也能调\n\n// 读一个从没赋过值的变量：值当 null，同时报一条 Warning\necho $neverSet;                 // ⚠ Warning: Undefined variable $neverSet\necho $neverSet ?? \"默认\";       // ?? 走的是 isset 语义，不报警告\n\n// 还有「变量变量」：名字本身可以是另一个变量的值\n$key = \"name\";\necho $$key;                     // 等同于 $name",
