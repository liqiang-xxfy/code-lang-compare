      "lang": "typescript",
      "code": "// 语言层没有并发单元 —— TypeScript 只给已有的东西加类型\nconst w = new Worker(\"./worker.js\");        // 线程由宿主提供（浏览器 / Node）\nw.postMessage({ n: 42 });                   // 跨线程传的是副本，不是共享\nw.onmessage = (e: MessageEvent) => { console.info(e.data); };\n\n// 语言层唯一的「并发」：事件循环上的异步任务\nasync function tick(): Promise<void> {\n  await Promise.resolve();   // 只是让出到微任务队列，没有第二条线程\n}",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 语言层没有并发单元 —— TypeScript 只给已有的东西加类型</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> w</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-keyword)\"> new</span><span style=\"color:var(--shiki-token-function)\"> Worker</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"./worker.js\"</span><span style=\"color:var(--shiki-foreground)\">);        </span><span style=\"color:var(--shiki-token-comment)\">// 线程由宿主提供（浏览器 / Node）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">w</span><span style=\"color:var(--shiki-token-function)\">.postMessage</span><span style=\"color:var(--shiki-foreground)\">({ n</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> 42</span><span style=\"color:var(--shiki-foreground)\"> });                   </span><span style=\"color:var(--shiki-token-comment)\">// 跨线程传的是副本，不是共享</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">w</span><span style=\"color:var(--shiki-foreground)\">.</span><span style=\"color:var(--shiki-token-function)\">onmessage</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-foreground)\"> (e</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> MessageEvent</span><span style=\"color:var(--shiki-foreground)\">) </span><span style=\"color:var(--shiki-token-keyword)\">=></span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-constant)\">console</span><span style=\"color:var(--shiki-token-function)\">.info</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">e</span><span style=\"color:var(--shiki-foreground)\">.data); };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 语言层唯一的「并发」：事件循环上的异步任务</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">async</span><span style=\"color:var(--shiki-token-keyword)\"> function</span><span style=\"color:var(--shiki-token-function)\"> tick</span><span style=\"color:var(--shiki-foreground)\">()</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> Promise</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-constant)\">void</span><span style=\"color:var(--shiki-foreground)\">> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  await</span><span style=\"color:var(--shiki-token-constant)\"> Promise</span><span style=\"color:var(--shiki-token-function)\">.resolve</span><span style=\"color:var(--shiki-foreground)\">();   </span><span style=\"color:var(--shiki-token-comment)\">// 只是让出到微任务队列，没有第二条线程</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span></code></pre>",
