:var(--shiki-token-constant)\"> raw</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-string-expression)\"> `第一行</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-string-expression)\">第二行`</span><span style=\"color:var(--shiki-foreground)\">;                           </span><span style=\"color:var(--shiki-token-comment)\">// 模板字符串保留换行</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> esc</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-string-expression)\"> 'it\\'s'</span><span style=\"color:var(--shiki-foreground)\">;              </span><span style=\"color:var(--shiki-token-comment)\">// 转义照旧</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 没有 char 类型 —— 'a' 就是长度 1 的字符串</span></span></code></pre>",
