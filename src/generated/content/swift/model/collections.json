tyle=\"color:var(--shiki-token-punctuation)\">[</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-token-punctuation)\">]</span><span style=\"color:var(--shiki-token-comment)\">                           // 2（原数组的第二个元素，不是切片的第一个）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">s.</span><span style=\"color:var(--shiki-token-constant)\">startIndex</span><span style=\"color:var(--shiki-token-comment)\">                   // 1 —— 不是 0！</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">s.</span><span style=\"color:var(--shiki-token-constant)\">first</span><span style=\"color:var(--shiki-token-comment)\">                        // 2（用 first 才与下标无关）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 想要一个**独立的数组**（下标从 0 开始）就显式转</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">let</span><span style=\"color:var(--shiki-foreground)\"> copy </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> Array</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">s</span><span style=\"color:var(--shiki-token-punctuation)\">)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">copy</span><span style=\"color:var(--shiki-token-punctuation)\">[</span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-token-punctuation)\">]</span><span style=\"color:var(--shiki-token-comment)\">                        // 2</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 字符串同理：`Substring` 也是视图，`String(sub)` 才是独立的</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 那「改切片会不会改到原数组」？——不会直接改到，</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 因为写时复制会在你第一次写的时候分开（值语义仍然成立）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">var</span><span style=\"color:var(--shiki-foreground)\"> v </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> [</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-constant)\">2</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-constant)\">3</span><span style=\"color:var(--shiki-foreground)\">]</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">var</span><span style=\"color:var(--shiki-foreground)\"> vs </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> v</span><span style=\"color:var(--shiki-token-punctuation)\">[</span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-token-keyword)\">..&#x3C;</span><span style=\"color:var(--shiki-token-constant)\">2</span><span style=\"color:var(--shiki-token-punctuation)\">]</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">vs</span><span style=\"color:var(--shiki-token-punctuation)\">[</span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-token-punctuation)\">]</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-constant)\"> 99</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// v 仍然是 [1, 2, 3] —— 写时复制把两份分开了</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 所以「视图」在这里是**性能优化**（不必要时不拷贝），</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 不是「共享可变状态」</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 没有负数下标、没有步长切片</span></span></code></pre>",
