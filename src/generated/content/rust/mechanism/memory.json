      "code": "use std::rc::{Rc, Weak};\nuse std::cell::RefCell;\n\n// Rc：共享所有权（单线程引用计数）\nlet a = Rc::new(RefCell::new(vec![1]));\nlet b = Rc::clone(&a);                 // 计数变 2，不是深复制\nprintln!(\"{}\", Rc::strong_count(&a));  // 2\n\n// Weak：不增加强引用计数 —— 用来打破循环引用\nlet weak: Weak<RefCell<Vec<i32>>> = Rc::downgrade(&a);\nlet upgraded = weak.upgrade();          // Option<Rc<_>>：对象已释放时是 None\n\n// 多线程用 Arc（原子计数）；RefCell / Mutex 负责内部可变性\nuse std::sync::{Arc, Mutex};\nlet shared = Arc::new(Mutex::new(0));",
