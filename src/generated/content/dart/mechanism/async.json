pan><span style=\"color:var(--shiki-token-function)\">wait</span><span style=\"color:var(--shiki-foreground)\">(futures);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">  // `await for`：像循环一样消费一个 Stream（函数必须是 async）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  await</span><span style=\"color:var(--shiki-token-keyword)\"> for</span><span style=\"color:var(--shiki-foreground)\"> (</span><span style=\"color:var(--shiki-token-keyword)\">final</span><span style=\"color:var(--shiki-foreground)\"> chunk </span><span style=\"color:var(--shiki-token-keyword)\">in</span><span style=\"color:var(--shiki-token-function)\"> streamOf</span><span style=\"color:var(--shiki-foreground)\">()) { </span><span style=\"color:var(--shiki-token-function)\">print</span><span style=\"color:var(--shiki-foreground)\">(chunk); }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span></code></pre>",
