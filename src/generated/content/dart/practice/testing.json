an><span style=\"color:var(--shiki-token-string-expression)\">'异步也能测：框架自动等返回的 Future'</span><span style=\"color:var(--shiki-foreground)\">, () </span><span style=\"color:var(--shiki-token-keyword)\">async</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">      expect</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">await</span><span style=\"color:var(--shiki-token-function)\"> fetchCount</span><span style=\"color:var(--shiki-foreground)\">(), </span><span style=\"color:var(--shiki-token-constant)\">3</span><span style=\"color:var(--shiki-foreground)\">);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">    });</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  });</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\"># dart test                       # 默认跑当前项目的 test</span><span style=\"color:var(--shiki-token-keyword)\">/</span><span style=\"color:var(--shiki-foreground)\"> 目录</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\"># dart test test</span><span style=\"color:var(--shiki-token-keyword)\">/</span><span style=\"color:var(--shiki-foreground)\">cart_test.dart   # 只跑一个文件</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\"># dart test </span><span style=\"color:var(--shiki-token-keyword)\">-</span><span style=\"color:var(--shiki-foreground)\">n </span><span style=\"color:var(--shiki-token-string-expression)\">'空车'</span><span style=\"color:var(--shiki-foreground)\">              # 按名字筛</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\"># dart test </span><span style=\"color:var(--shiki-token-keyword)\">-</span><span sty