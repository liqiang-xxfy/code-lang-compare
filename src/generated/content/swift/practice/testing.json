yle=\"color:var(--shiki-token-comment)\">                      // 分组（可选）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">struct</span><span style=\"color:var(--shiki-token-function)\"> CalculatorTests</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  @Test</span><span style=\"color:var(--shiki-token-keyword)\"> func</span><span style=\"color:var(--shiki-token-function)\"> handlesNegative</span><span style=\"color:var(--shiki-foreground)\">() { }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ② XCTest（老，仍然是很多项目的现实）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">import</span><span style=\"color:var(--shiki-token-function)\"> XCTest</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">final</span><span style=\"color:var(--shiki-token-keyword)\"> class</span><span style=\"color:var(--shiki-token-function)\"> CalculatorTests</span><span style=\"color:var(--shiki-token-punctuation)\">:</span><span style=\"color:var(--shiki-token-function)\"> XCTestCase </span><span style=\"color:var(--shiki-foreground)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  func</span><span style=\"color:var(--shiki-token-function)\"> testAddsTwoNumbers</span><span style=\"color:var(--shiki-foreground)\">() {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">    XCTAssertEqual</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">add</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-token-function)\">, </span><span style=\"color:var(--shiki-token-constant)\">2</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-token-function)\">, </span><span style=\"color:var(--shiki-token-constant)\">3</span><span style=\"color:var(--shiki-token-punctuation)\">)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  override</span><span style=\"color:var(--shiki-token-keyword)\"> func</span><span style=\"color:var(--shiki-token-function)\"> setUp</span><span style=\"color:var(--shiki-foreground)\">() { }          </span><span style=\"color:var(--shiki-token-comment)\">// 每个用例前</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  override</span><span style=\"color:var(--shiki-token-keyword)\"> func</span><span style=\"color:var(--shiki-token-function)\"> tearDown</span><span style=\"color:var(--shiki-foreground)\">() { }       </span><span style=\"color:var(--shiki-token-comment)\">// 每个用例后</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 跑测试都是同一条命令</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">//   swift test</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">//   swift test --filter CalculatorTests</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 两套的差别不只是写法：</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// · 新的用**结构体加宏**，老的用**类继承**</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// · 新的支持**并发跑用例**且默认就并行</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// · 新的断言用宏，失败时能打印**表达式原文**（更易读）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// · 新的能标记「已知问题」「按条件跳过」「打标签分组」</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 官方方向是新的那套，但迁移需要时间，所以两套都要认识</span></span></code></pre>",
