span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">fn</span><span style=\"color:var(--shiki-token-function)\"> copy_type</span><span style=\"color:var(--shiki-foreground)\">(n</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> i32</span><span style=\"color:var(--shiki-foreground)\">) {}         </span><span style=\"color:var(--shiki-token-comment)\">// Copy 类型按值传是复制，不影响调用方</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">#[derive(</span><span style=\"color:var(--shiki-token-function)\">Clone</span><span style=\"color:var(--shiki-foreground)\">)]</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">struct</span><span style=\"color:var(--shiki-token-function)\"> Config</span><span style=\"color:var(--shiki-foreground)\"> { retries</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> u32</span><span style=\"color:var(--shiki-foreground)\"> }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">fn</span><span style=\"color:var(--shiki-token-function)\"> use_config</span><span style=\"color:var(--shiki-foreground)\">(c</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> Config</span><span style=\"color:var(--shiki-foreground)\">) {}     </span><span style=\"color:var(--shiki-token-comment)\">// 不想转移所有权就传引用，或调用方 clone()</span></span></code></pre>",
