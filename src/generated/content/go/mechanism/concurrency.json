><span style=\"color:var(--shiki-foreground)\">rw.</span><span style=\"color:var(--shiki-token-function)\">Lock</span><span style=\"color:var(--shiki-foreground)\">()                  </span><span style=\"color:var(--shiki-token-comment)\">// 写锁独占</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">rw.</span><span style=\"color:var(--shiki-token-function)\">Unlock</span><span style=\"color:var(--shiki-foreground)\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 注意：锁与它保护的数据是**分开**的（与 Rust 相反）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">type</span><span style=\"color:var(--shiki-token-function)\"> Counter</span><span style=\"color:var(--shiki-token-keyword)\"> struct</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  mu </span><span style=\"color:var(--shiki-token-function)\">sync</span><span style=\"color:var(--shiki-foreground)\">.</span><span style=\"color:var(--shiki-token-function)\">Mutex</span><span style=\"color:var(--shiki-token-comment)\">             // 惯例：锁做成结构体字段，与数据放一起</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  n  </span><span style=\"color:var(--shiki-token-keyword)\">int</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">func</span><span style=\"color:var(--shiki-foreground)\"> (c </span><span style=\"color:var(--shiki-token-keyword)\">*</span><span style=\"color:var(--shiki-token-function)\">Counter</span><span style=\"color:var(--shiki-foreground)\">) </span><span style=\"color:var(--shiki-token-function)\">Inc</span><span style=\"color:var(--shiki-foreground)\">() { c.mu.</span><span style=\"color:var(--shiki-token-function)\">Lock</span><span style=\"color:var(--shiki-foreground)\">(); </span><span style=\"color:var(--shiki-token-keyword)\">defer</span><span style=\"color:var(--shiki-foreground)\"> c.mu.</span><span style=\"color:var(--shiki-token-function)\">Unlock</span><span style=\"color:var(--shiki-foreground)\">(); c.n</span><span style=\"color:var(--shiki-token-keyword)\">++</span><span style=\"color:var(--shiki-foreground)\"> }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 不可复制：sync.Mutex 不能按值传递（go vet 会报 copylocks）</span></span></code></pre>",
