r(--shiki-token-comment)\">// ⚠ \"heLLo\" —— 字面量，全替换</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">s</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">replaceAll</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"l+\"</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-string-expression)\"> \"L\"</span><span style=\"color:var(--shiki-foreground)\">);      </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 收的是**正则**，名字会骗人</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">StringBuilder</span><span style=\"color:var(--shiki-foreground)\"> sb </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-keyword)\"> new</span><span style=\"color:var(--shiki-token-function)\"> StringBuilder()</span><span style=\"color:var(--shiki-foreground)\">;   </span><span style=\"color:var(--shiki-token-comment)\">// 循环里拼接要换它</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">for</span><span style=\"color:var(--shiki-foreground)\"> (</span><span style=\"color:var(--shiki-token-keyword)\">String</span><span style=\"color:var(--shiki-foreground)\"> p </span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-foreground)\"> parts) </span><span style=\"color:var(--shiki-token-constant)\">sb</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">append</span><span style=\"color:var(--shiki-foreground)\">(p);</span></span></code></pre>",
