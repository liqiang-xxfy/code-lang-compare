lass=\"line\"><span style=\"color:var(--shiki-token-function)\">var_dump</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">empty</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"0.0\"</span><span style=\"color:var(--shiki-token-punctuation)\">))</span><span style=\"color:var(--shiki-foreground)\">;           </span><span style=\"color:var(--shiki-token-comment)\">// false（这是字符串，不是数字）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">var_dump</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">empty</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\" \"</span><span style=\"color:var(--shiki-token-punctuation)\">))</span><span style=\"color:var(--shiki-foreground)\">;             </span><span style=\"color:var(--shiki-token-comment)\">// false（空格非空）</span></span></code></pre>",
