e=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> 0</span><span style=\"color:var(--shiki-foreground)\">; }        </span><span style=\"color:var(--shiki-token-comment)\">// 调用方看得到</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">rebind</span><span style=\"color:var(--shiki-foreground)\">(o1); </span><span style=\"color:var(--shiki-token-function)\">mutate</span><span style=\"color:var(--shiki-foreground)\">(o1);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// const 挡的是「重新绑定」，不是「改内容」</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> o3</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-foreground)\"> { n</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-foreground)\"> };</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// o3 = { n: 2 };           // —— ⚠ 编译错误：不能给常量重新赋值</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">o3</span><span style=\"color:var(--shiki-foreground)\">.n </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> 2</span><span style=\"color:var(--shiki-foreground)\">;                   </span><span style=\"color:var(--shiki-token-comment)\">// 内容照改</span></span></code></pre>",
