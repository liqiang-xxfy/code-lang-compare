      "lang": "php",
      "code": "// 反射是**只读内省** —— 读得到的很多，改不了的也很多\n$r = new ReflectionClass(SomeClass::class);\n$r->getMethods(); $r->getProperties(); $r->getConstants();\n$r->getConstructor(); $r->getInterfaces(); $r->getParentClass();\n$r->isAbstract(); $r->isFinal(); $r->implementsInterface(Foo::class);\n\n// ⚠ **8.1 起 private / protected 默认就能读**，不用先 setAccessible\nclass Vault { private string $secret = \"藏起来的\"; private function open(): string { return \"开了\"; } }\n$rp = new ReflectionClass(Vault::class);\n$rp->getProperty('secret')->getValue(new Vault());   // \"藏起来的\"\n$rp->getMethod('open')->invoke(new Vault());          // \"开了\"\n// setAccessible() 还在，但 8.1 起基本是空操作\n\n// ⚠ 两件**做不到**的事：\n// ⚠ ① 不能创建新类（没有 newClass / defineClass 这种 API）\n// ⚠ ② 不能修改已加载类的结构（没有 addMethod / addProperty）\n// 想在运行时造一个新类型，只能走 eval 或匿名类\n\n// 反射拿得到 PHPDoc 原文（字符串），但不解析它\n$rp->getDocComment();\n\n// 性能提示：反射调用比直接调用慢得多，热点路径上要缓存\n// （缓存 ReflectionClass 对象，或者干脆生成一份静态代码）",
