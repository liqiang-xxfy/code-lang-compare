color:var(--shiki-token-keyword)\">new</span><span style=\"color:var(--shiki-token-function)\"> Set</span><span style=\"color:var(--shiki-foreground)\">([</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-foreground)\">]));          </span><span style=\"color:var(--shiki-token-comment)\">// 也行 —— 谁实现了协议谁就能用</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">printAll</span><span style=\"color:var(--shiki-foreground)\">({ a</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-foreground)\"> });              </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ TypeError：普通对象不可迭代</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 类型无关紧要，**有没有那个方法/协议**才重要</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">function</span><span style=\"color:var(--shiki-token-function)\"> area</span><span style=\"color:var(--shiki-foreground)\">(shape) { </span><span style=\"color:var(--shiki-token-keyword)\">return</span><span style=\"color:var(--shiki-token-constant)\"> shape</span><span style=\"color:var(--shiki-token-function)\">.area</span><span style=\"color:var(--shiki-foreground)\">(); }   </span><span style=\"color:var(--shiki-token-comment)\">// 没声明任何类型</span></span></code></pre>",
