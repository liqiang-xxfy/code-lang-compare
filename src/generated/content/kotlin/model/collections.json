.</span><span style=\"color:var(--shiki-token-function)\">drop</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">2</span><span style=\"color:var(--shiki-foreground)\">)        </span><span style=\"color:var(--shiki-token-comment)\">// 前两个 / 去掉前两个</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">xs.</span><span style=\"color:var(--shiki-token-function)\">takeLast</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">2</span><span style=\"color:var(--shiki-foreground)\">); xs.</span><span style=\"color:var(--shiki-token-function)\">dropLast</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">2</span><span style=\"color:var(--shiki-foreground)\">)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">xs.</span><span style=\"color:var(--shiki-token-function)\">slice</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-function)\">listOf</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-constant)\">2</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-constant)\">4</span><span style=\"color:var(--shiki-foreground)\">))     </span><span style=\"color:var(--shiki-token-comment)\">// 按下标挑：[0, 2, 4]</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">xs.</span><span style=\"color:var(--shiki-token-function)\">chunked</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">2</span><span style=\"color:var(--shiki-foreground)\">)                 </span><span style=\"color:var(--shiki-token-comment)\">// [[0,1],[2,3],[4,5]] 分组</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">xs.</span><span style=\"color:var(--shiki-token-function)\">windowed</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">3</span><span style=\"color:var(--shiki-foreground)\">)                </span><span style=\"color:var(--shiki-token-comment)\">// 滑动窗口</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">xs.</span><span style=\"color:var(--shiki-token-function)\">filter</span><span style=\"color:var(--shiki-foreground)\"> { it </span><span style=\"color:var(--shiki-token-keyword)\">%</span><span style=\"color:var(--shiki-token-constant)\"> 2</span><span style=\"color:var(--shiki-token-keyword)\"> ==</span><span style=\"color:var(--shiki-token-constant)\"> 0</span><span style=\"color:var(--shiki-foreground)\"> }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">xs.</span><span style=\"color:var(--shiki-token-function)\">reversed</span><span style=\"color:var(--shiki-foreground)\">(); xs.</span><span style=\"color:var(--shiki-token-function)\">sortedDescending</span><span style=\"color:var(--shiki-foreground)\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 没有负下标、没有切片语法 —— x[-1] 与 xs[1:3] 都不存在</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// subList 返回的是**视图**（改了会互相影响），要副本用 toList()</span></span></code></pre>",
