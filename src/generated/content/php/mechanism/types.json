ar(--shiki-token-comment)\">// 8.0 ?? 空值合并：null 才取右边</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">function</span><span style=\"color:var(--shiki-token-function)\"> greet</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">?string</span><span style=\"color:var(--shiki-foreground)\"> $who)</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-keyword)\"> string</span><span style=\"color:var(--shiki-foreground)\"> {   </span><span style=\"color:var(--shiki-token-comment)\">// 参数也可以可空</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  return</span><span style=\"color:var(--shiki-token-string-expression)\"> \"你好，\"</span><span style=\"color:var(--shiki-token-keyword)\"> .</span><span style=\"color:var(--shiki-foreground)\"> ($who </span><span style=\"color:var(--shiki-token-keyword)\">??</span><span style=\"color:var(--shiki-token-string-expression)\"> \"访客\"</span><span style=\"color:var(--shiki-foreground)\">);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">greet</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-constant)\">null</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;                     </span><span style=\"color:var(--shiki-token-comment)\">// 合法：类型里允许 null</span></span></code></pre>",
