\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">v.</span><span style=\"color:var(--shiki-token-function)\">Field</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-foreground)\">).</span><span style=\"color:var(--shiki-token-function)\">Int</span><span style=\"color:var(--shiki-foreground)\">()                  </span><span style=\"color:var(--shiki-token-comment)\">// 读字段值</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 修改必须传指针，否则 Value 不可写</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">pv </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-foreground)\"> reflect.</span><span style=\"color:var(--shiki-token-function)\">ValueOf</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">&#x26;</span><span style=\"color:var(--shiki-foreground)\">u).</span><span style=\"color:var(--shiki-token-function)\">Elem</span><span style=\"color:var(--shiki-foreground)\">()</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">pv.</span><span style=\"color:var(--shiki-token-function)\">Field</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-foreground)\">).</span><span style=\"color:var(--shiki-token-function)\">SetString</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"Bob\"</span><span style=\"color:var(--shiki-foreground)\">)      </span><span style=\"color:var(--shiki-token-comment)\">// 通过反射改字段</span></span></code></pre>",
