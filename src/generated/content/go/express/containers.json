ne\"><span style=\"color:var(--shiki-foreground)\">xs </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-foreground)\"> []</span><span style=\"color:var(--shiki-token-keyword)\">int</span><span style=\"color:var(--shiki-foreground)\">{</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-constant)\">2</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-constant)\">3</span><span style=\"color:var(--shiki-foreground)\">}                  </span><span style=\"color:var(--shiki-token-comment)\">// 切片：长度可变，底层是数组</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">xs </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-function)\"> append</span><span style=\"color:var(--shiki-foreground)\">(xs, </span><span style=\"color:var(--shiki-token-constant)\">4</span><span style=\"color:var(--shiki-foreground)\">)                    </span><span style=\"color:var(--shiki-token-comment)\">// append 可能重新分配，返回新的切片头</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">m </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-token-function)\"> make</span><span style=\"color:var(--shiki-foreground)\">([]</span><span style=\"color:var(--shiki-token-keyword)\">int</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-constant)\">16</span><span style=\"color:var(--shiki-foreground)\">)               </span><span style=\"color:var(--shiki-token-comment)\">// 预分配容量 16，避免反复扩容</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">sub </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-foreground)\"> xs[</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-foreground)\">:</span><span style=\"color:var(--shiki-token-constant)\">3</span><span style=\"color:var(--shiki-foreground)\">]                        </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 切片共享底层数组，改 sub 会影响 xs</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">three </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-foreground)\"> xs[:</span><span style=\"color:var(--shiki-token-constant)\">3</span><span style=\"color:var(--shiki-foreground)\">:</span><span style=\"color:var(--shiki-token-constant)\">3</span><span style=\"color:var(--shiki-foreground)\">]                     </span><span style=\"color:var(--shiki-token-comment)\">// 三索引切片：限定容量，防越界写入</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">n </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-token-function)\"> len</span><span style=\"color:var(--shiki-foreground)\">(xs)                          </span><span style=\"color:var(--shiki-token-comment)\">// 长度</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">c </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-token-function)\"> cap</span><span style=\"color:var(--shiki-foreground)\">(xs)                          </span><span style=\"color:var(--shiki-token-comment)\">// 容量</span></span></code></pre>",
