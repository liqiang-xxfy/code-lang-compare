pan><span style=\"color:var(--shiki-token-function)\"> println!</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"完成 {}\"</span><span style=\"color:var(--shiki-foreground)\">, v),</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">  Err</span><span style=\"color:var(--shiki-foreground)\">(_) </span><span style=\"color:var(--shiki-token-keyword)\">=></span><span style=\"color:var(--shiki-token-function)\"> println!</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"超时（Future 已被丢弃）\"</span><span style=\"color:var(--shiki-foreground)\">),   </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 超时就是把它 drop 了</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// select：谁先就绪用谁，另一个被取消</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// tokio::select! {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// v = a() => …,      // —— 另一个分支的 Future 在这里被 drop</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">//   _ = sleep(…) => …,</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 取消是「在 await 点丢弃」，所以中途不会有清理回调 ——</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 想要清理就实现 Drop</span></span></code></pre>",
