{
  "name": "code-lang-compare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "多语言并排对比学习工具 —— 以 JavaScript 为基准，把目标语言的同一概念并排对照，突出差异",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run content:build && vite",
    "build": "npm run content:build && vite-ssg build && tsx scripts/build/finalize-dist.ts",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "registry": "tsx scripts/build/generate-registry.ts",
    "content:validate": "tsx scripts/pipeline/03-validate.ts",
    "content:build": "tsx scripts/pipeline/03-validate.ts && tsx scripts/pipeline/04-build.ts",
    "content:report": "tsx scripts/pipeline/content-report.ts",
    "verify:ext": "tsx scripts/verify-extensibility.ts",
    "verify:sections": "tsx scripts/verify-section-extensibility.ts"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "minisearch": "^7.2.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.43",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@shikijs/transformers": "^1.29.2",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "shiki": "^1.29.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vite-ssg": "^28.3.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.10",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@rollup/rollup-win32-x64-msvc": "^4.63.6"
  }
}
