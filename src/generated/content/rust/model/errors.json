      "code": "fn divide(a: i32, b: i32) -> Result<i32, String> {\n  if b == 0 {\n    return Err(\"除数为零\".to_string());   // 可恢复的失败：返回 Err\n  }\n  Ok(a / b)\n}\n\n// ⚠ panic! 是不可恢复的失败，会展开栈并终止当前线程\nfn must_be_positive(n: i32) {\n  assert!(n > 0, \"必须为正数\");   // 断言失败即 panic\n}\n\nlet v = vec![1, 2];\n// v[9];                            // —— ⚠ 越界也会 panic",
