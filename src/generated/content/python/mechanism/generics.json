      "code": "def first[T](xs: list[T]) -> T:      # 3.12+ 的新语法\n    return xs[0]\n\n# 老写法（3.11 及以前）：\nfrom typing import TypeVar, Generic\nT = TypeVar(\"T\")\ndef first2(xs: list[T]) -> T: return xs[0]\n\nclass Box(Generic[T]):               # 泛型类\n    def __init__(self, v: T): self.v = v\n\nfirst([1, 2])                        # 运行时不检查，检查器算出 int",
