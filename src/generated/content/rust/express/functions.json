      "code": "fn double(n: i32) -> i32 {\n  n * 2                    // ⚠ 最后一个表达式就是返回值，不写 return、不写分号\n}\n\nfn find(xs: &[i32], target: i32) -> Option<usize> {\n  for (i, x) in xs.iter().enumerate() {\n    if *x == target { return Some(i); }   // 提前返回要用 return\n  }\n  None                     // 没有 else —— 找不到就是 None，类型上说得清楚\n}\n\nfn read(path: &str) -> Result<String, std::io::Error> {\n  let text = std::fs::read_to_string(path)?;  // ? 出错就直接返回 Err\n  Ok(text.trim().to_string())\n}",
