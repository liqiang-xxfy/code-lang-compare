      "code": "async fn fetch(id: u32) -> String {      // async fn 返回 impl Future\n  format!(\"数据 {}\", id)\n}\n\nasync fn run() -> usize {\n  let a = fetch(1).await;                // .await 挂起直到就绪\n  let b = fetch(2).await;\n  a.len() + b.len()\n}\n\n// 并发执行两个（而不是顺序 await）\n// let (a, b) = tokio::join!(fetch(1), fetch(2));\n\n#[tokio::main]                             // ⚠ 必须有运行时\nasync fn main() {\n  println!(\"{}\", run().await);\n}",
