      "code": "import { taskpool } from '@kit.ArkTS';\n\n// 两种并发策略：异步（Promise / async-await）与多线程（TaskPool / Worker）\n@Concurrent\nfunction fib(n: number): number {    // 标了 @Concurrent 才能进 TaskPool\n  return n < 2 ? n : fib(n - 1) + fib(n - 2);\n}\n\ntaskpool.execute(new taskpool.Task(fib, 35))\n  .then((v: Object) => { console.info(`${v}`); });\n\n// Worker 是另一套：线程自己建、自己销毁，用 postMessage 通信",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">import</span><span style=\"color:var(--shiki-foreground)\"> { taskpool } </span><span style=\"color:var(--shiki-token-keyword)\">from</span><span style=\"color:var(--shiki-token-string-expression)\"> '@kit.ArkTS'</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 两种并发策略：异步（Promise / async-await）与多线程（TaskPool / Worker）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">@Concurrent</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">function</span><span style=\"color:var(--shiki-token-function)\"> fib</span><span style=\"color:var(--shiki-foreground)\">(n</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> number</span><span style=\"color:var(--shiki-foreground)\">)</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> number</span><span style=\"color:var(--shiki-foreground)\"> {    </span><span style=\"color:var(--shiki-token-comment)\">// 标了 @Concurrent 才能进 TaskPool</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  return</span><span style=\"color:var(--shiki-foreground)\"> n </span><span style=\"color:var(--shiki-token-keyword)\">&#x3C;</span><span style=\"color:var(--shiki-token-constant)\"> 2</span><span style=\"color:var(--shiki-token-keyword)\"> ?</span><span style=\"color:var(--shiki-foreground)\"> n </span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> fib</span><span style=\"color:var(--shiki-foreground)\">(n </span><span style=\"color:var(--s