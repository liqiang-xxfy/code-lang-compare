or:var(--shiki-token-function)\">.toUpperCase</span><span style=\"color:var(--shiki-foreground)\">(); }   </span><span style=\"color:var(--shiki-token-comment)\">// getter</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  set</span><span style=\"color:var(--shiki-token-function)\"> display</span><span style=\"color:var(--shiki-foreground)\">(v) { </span><span style=\"color:var(--shiki-token-constant)\">this</span><span style=\"color:var(--shiki-foreground)\">.name </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> v</span><span style=\"color:var(--shiki-token-function)\">.trim</span><span style=\"color:var(--shiki-foreground)\">(); }            </span><span style=\"color:var(--shiki-token-comment)\">// setter</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> u</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-keyword)\"> new</span><span style=\"color:var(--shiki-token-function)\"> User</span><span style=\"color:var(--shiki-foreground)\">();</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">u</span><span style=\"color:var(--shiki-foreground)\">.display;                       </span><span style=\"color:var(--shiki-token-comment)\">// 像属性一样读，实际调了 getter</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-string-expression)\">\"name\"</span><span style=\"color:var(--shiki-token-keyword)\"> in</span><span style=\"color:var(--shiki-foreground)\"> u;                     </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 继承来的属性也为真</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">Object</span><span style=\"color:v