          "code": "interface Renderable {              // 接口是中心概念\n    String toText();\n    default boolean empty() { return false; }   // default 方法\n}",
          "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">interface</span><span style=\"color:var(--shiki-token-function)\"> Renderable</span><span style=\"color:var(--shiki-foreground)\"> {              </span><span style=\"color:var(--shiki-token-comment)\">// 接口是中心概念</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">    String</span><span style=\"color:var(--shiki-token-function)\"> toText</span><span style=\"color:var(--shiki-foreground)\">();</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">    default</span><span style=\"color:var(--shiki-token-keyword)\"> boolean</span><span style=\"color:var(--shiki-token-function)\"> empty</span><span style=\"color:var(--shiki-foreground)\">() { </span><span style=\"color:var(--shiki-token-keyword)\">return</span><span style=\"color:var(--shiki-token-constant)\"> false</span><span style=\"color:var(--shiki-foreground)\">; }   </span><span style=\"color:var(--shiki-token-comment)\">// default 方法</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span></code></pre>",
