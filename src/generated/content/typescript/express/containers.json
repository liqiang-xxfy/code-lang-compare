      "code": "const xs: number[] = [1, 2, 3];        // 元素类型写在类型位置\nconst ys: Array<number> = [4, 5];      // 与 number[] 等价的另一种写法\nxs.push(4);                            // 方法与 JavaScript 完全相同\nconst doubled = xs.map((x) => x * 2);  // 回调参数自动带上元素类型\n// xs.push(\"x\");                       // —— ⚠ 编译错误：元素类型是 number\n\nconst pair: [string, number] = [\"Ada\", 36];   // 元组：每个位置的类型可以不同\nconst ro: readonly number[] = xs;      // 只读视图\n// ro.push(9);                         // —— ⚠ 编译错误：只读数组没有 push\n// ro[0] = 9;                          // —— ⚠ 编译错误：只读视图不能改元素",
