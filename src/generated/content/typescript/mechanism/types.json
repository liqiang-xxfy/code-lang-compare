      "code": "let n = 1;                  // 推断为 number\n// n = \"text\";              // —— ⚠ 编译错误：类型在编译期就定死了\n\n// 类型只活在编译期：运行时看不到标注，只看得到值\nconst t: string = \"hi\";\ntypeof t;                   // \"string\" —— 这是值的类型，不是那行标注\n\n// any 是主动退出检查的逃生舱\nlet loose: any = 42;\nloose = \"text\";             // 合法：any 让编译器闭嘴\nloose.notAMethod();         // ⚠ 也不报错，要到运行时才炸",
