      "code": "import \"reflect\"\n\ntype User struct {\n  ID   int    `json:\"id\"`\n  Name string `json:\"name\"`\n}\n\nu := User{ID: 1, Name: \"Ada\"}\nt := reflect.TypeOf(u)\nv := reflect.ValueOf(u)\n\nt.Name()                          // \"User\"\nt.NumField()                      // 2\nf := t.Field(0)\nf.Name                            // \"ID\"\nf.Tag.Get(\"json\")                 // \"id\" —— 结构体标签\n\nv.Field(0).Int()                  // 读字段值\n// 修改必须传指针，否则 Value 不可写\npv := reflect.ValueOf(&u).Elem()\npv.Field(1).SetString(\"Bob\")      // 通过反射改字段",
