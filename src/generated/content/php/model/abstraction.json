iki-token-comment)\">// 两个 trait 有同名方法又不解决冲突 → 致命错误，不是警告</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 优先级：**类自己的方法 > trait 的方法 > 父类的方法**</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// trait 可以带常量（8.2 起）、可以声明抽象方法（要求使用方实现）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 静态属性：8.3 起「每个使用该 trait 的类各有一份」</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">trait</span><span style=\"color:var(--shiki-token-function)\"> Counter</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">public</span><span style=\"color:var(--shiki-token-keyword)\"> static</span><span style=\"color:var(--shiki-token-keyword)\"> int</span><span style=\"color:var(--shiki-foreground)\"> $n </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> 0</span><span style=\"color:var(--shiki-foreground)\">; </span><span style=\"color:var(--shiki-token-keyword)\">public</span><span style=\"color:var(--shiki-token-keyword)\"> function</span><span style=\"color:var(--shiki-token-function)\"> inc</span><span style=\"color:var(--shiki-foreground)\">()</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-keyword)\"> int</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">return</span><span style=\"color:var(--shiki-token-keyword)\"> ++static::</span><span style=\"color:var(--shiki-token-constant)\">$n</span><span style=\"color:var(--shiki-foreground)\">; } }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">class</span><span style=\"color:var(--shiki-token-function)\"> C1</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">use</span><span style=\"color:var(--shiki-token-constant)\"> Counter</span><span style=\"color:var(--shiki-foreground)\">; }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">class</span><span style=\"color:var(--shiki-token-function)\"> C2</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">use</span><span style=\"color:var(--shiki-token-constant)\"> Counter</span><span style=\"color:var(--shiki-foreground)\">; }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$c1 </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-keyword)\"> new</span><span style=\"color:var(--shiki-token-constant)\"> C1</span><span style=\"color:var(--shiki-foreground)\">; $c2 </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-keyword)\"> new</span><span style=\"color:var(--shiki-token-constant)\"> C2</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$c1</span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-function)\">inc</span><span style=\"color:var(--shiki-token-punctuation)\">()</span><span style=\"color:var(--shiki-foreground)\">; $c1</span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-function)\">inc</span><span style=\"color:var(--shiki-token-punctuation)\">()</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">echo</span><span style=\"color:var(--shiki-foreground)\"> $c2</span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-function)\">inc</span><span style=\"color:var(--shiki-token-punctuation)\">()</span><span s