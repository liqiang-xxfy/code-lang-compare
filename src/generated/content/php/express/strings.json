\"> &#x3C;&#x3C;&#x3C;'</span><span style=\"color:var(--shiki-token-keyword)\">EOT</span><span style=\"color:var(--shiki-token-string)\">'</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-string)\">nowdoc：行为同单引号，$name 不插值</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">EOT</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 单引号里 \\n **不是**换行 —— 这是从别的语言过来最常见的误写</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">echo</span><span style=\"color:var(--shiki-token-string-expression)\"> 'A\\nB'</span><span style=\"color:var(--shiki-foreground)\">;                    </span><span style=\"color:var(--shiki-token-comment)\">// 原样输出 A\\nB</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">echo</span><span style=\"color:var(--shiki-token-string-expression)\"> \"A\\nB\"</span><span style=\"color:var(--shiki-foreground)\">;                    </span><span style=\"color:var(--shiki-token-comment)\">// 这里的 \\n 才是换行</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 复杂插值要加花括号</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$arr </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> [</span><span style=\"color:var(--shiki-token-string-expression)\">\"k\"</span><span style=\"color:var(--shiki-token-keyword)\"> =></span><span style=\"color:var(--shiki-token-string-expression)\"> \"v\"</span><span style=\"color:var(--shiki-foreground)\">];</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">echo</span><span style=\"color:var(--shiki-token-string-expression)\"> \"值：{$arr['k']}\"</span><span style=\"color:var(--shiki-foreground)\">;          </span><span style=\"color:var(--shiki-token-comment)\">// 花括号在这里是**插值语法**</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">echo</span><span style=\"color:var(--shiki-token-string-expression)\"> \"下标不加引号也认：$arr[</span><span style=\"color:var(--shiki-token-string)\">k</span><span style=\"color:var(--shiki-token-string-expression)\">]\"</span><span style=\"color:var(--shiki-foreground)\">; </span><span style=\"color:var(--shiki-token-comment)\">// 老写法，能用但不推荐</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 花括号**偏移**在 8.0 被移除 —— 下面的写法是解析错误，不是警告</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// echo $b{0};                  // —— ⚠ Parse error: unexpected token \"{\"</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">echo</span><span style=\"color:var(--shiki-foreground)\"> $b[</span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-foreground)\">];                     </span><span style=\"color:var(--shiki-token-comment)\">// 现在只能这样取第 0 个**字节**</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">echo</span><span style=\"color:var(--shiki-foreground)\"> $b[</span><span style=\"color:var(--shiki-token-keyword)\">-</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-foreground)\">];                    </span><span style=\"color:var(--shiki-token-comment)\">// 7.1 起支持负索引（从末尾数）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 字符串可以按下标就地改（不改变长度）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$s </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> \"abc\"</span><span style=\"color:var(--shiki-foreground)\">; $s[</span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-foreground)\">] </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> \"X\"</span><span style=\"color:var(--shiki-foreground)\">; </span><span style=\"color:var(--shiki-token-function)\">echo</span><span style=\"color:var(--shiki-foreground)\"> $s;   </span><span style=\"color:var(--shiki-token-comment)\">// Xbc</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 8.2 起 `\"${name}\"` 这种插值写法被弃用，用 `\"{$name}\"`</span></span></code></pre>",
