      "code": "function area(r: number): number {   // 参数与返回值都要写类型\n  return 3.14 * r * r;\n}\n\nlet x = 1;                    // 局部变量可以由初值推断出类型\nlet y: number = 1;            // 也可以显式标注\n// let z;                     // —— ⚠ 编译错误：局部变量声明时就得有值\n\ninterface Point { x: number; y: number }   // 描述形状，编译后消失\n\nclass Circle {\n  radius: number = 0;         // 字段要写类型，或由初值推断\n  area(): number { return 3.14 * this.radius * this.radius }\n}",
