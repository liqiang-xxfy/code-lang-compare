n class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 不满足约束直接编译不过</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// longest(1, 2);                     // —— ⚠ 编译错误：number 没有 length</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 工具类型只留了四个</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">type</span><span style=\"color:var(--shiki-token-function)\"> Draft</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-function)\"> Partial</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-function)\">HasLength</span><span style=\"color:var(--shiki-foreground)\">>;</span></span></code></pre>",
