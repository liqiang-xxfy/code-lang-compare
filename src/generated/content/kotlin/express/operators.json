 style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"被调用了\"</span><span style=\"color:var(--shiki-foreground)\">); </span><span style=\"color:var(--shiki-token-keyword)\">return</span><span style=\"color:var(--shiki-token-constant)\"> true</span><span style=\"color:var(--shiki-foreground)\"> }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">val</span><span style=\"color:var(--shiki-foreground)\"> r </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> false</span><span style=\"color:var(--shiki-token-keyword)\"> &#x26;&#x26;</span><span style=\"color:var(--shiki-token-function)\"> sideEffect</span><span style=\"color:var(--shiki-foreground)\">()   </span><span style=\"color:var(--shiki-token-comment)\">// 「被调用了」不会打印</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// if / when 都是表达式，布尔运算常直接当值用</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">val</span><span style=\"color:var(--shiki-foreground)\"> label </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-keyword)\"> if</span><span style=\"color:var(--shiki-foreground)\"> (ok) </span><span style=\"color:var(--shiki-token-string-expression)\">\"可用\"</span><span style=\"color:var(--shiki-token-keyword)\"> else</span><span style=\"color:var(--shiki-token-string-expression)\"> \"禁用\"</span></span></code></pre>",
