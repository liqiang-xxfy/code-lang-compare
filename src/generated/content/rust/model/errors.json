      "code": "match divide(6, 0) {              // 处理 Result 的第一种写法：match\n  Ok(v) => println!(\"{}\", v),\n  Err(e) => eprintln!(\"出错：{}\", e),\n}\n\nif let Err(e) = divide(6, 0) {    // 只关心失败分支\n  eprintln!(\"{}\", e);\n}\n\nlet v = divide(6, 0).unwrap_or(0);          // 失败就给默认值\nlet v = divide(6, 0).expect(\"除法失败\");     // 失败就 panic 并打印这句话\n// let v = divide(6, 0).unwrap();            // —— ⚠ 失败就 panic，消息里只有行号\n\nfn caller() -> Result<i32, String> {\n  let v = divide(6, 0)?;          // ⚠ ? 失败就提前返回，不写 try 块\n  Ok(v + 1)\n}",
