olor:var(--shiki-foreground)\"> tests { }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">#[serde(rename_all </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> \"camelCase\"</span><span style=\"color:var(--shiki-foreground)\">)]         </span><span style=\"color:var(--shiki-token-comment)\">// 属性宏：由库提供，可带参数</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">struct</span><span style=\"color:var(--shiki-token-function)\"> Config</span><span style=\"color:var(--shiki-foreground)\"> { retry_count</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> u32</span><span style=\"color:var(--shiki-foreground)\"> }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 过程宏的三种形态：derive / 属性宏 / 函数式宏</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 都在**编译期**展开成代码 —— 运行时不产生任何额外开销</span></span></code></pre>",
