\"line\"><span style=\"color:var(--shiki-token-function)\">Name</span><span style=\"color:var(--shiki-foreground)\">[</span><span style=\"color:var(--shiki-token-keyword)\">int</span><span style=\"color:var(--shiki-foreground)\">]()      </span><span style=\"color:var(--shiki-token-comment)\">// \"int\" —— 类型实参在运行时是可得的</span></span></code></pre>",
