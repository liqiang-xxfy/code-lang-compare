yle=\"color:var(--shiki-token-constant)\"> D</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"局部\"</span><span style=\"color:var(--shiki-foreground)\">);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">  echo</span><span style=\"color:var(--shiki-token-string-expression)\"> \"  出作用域前\\n\"</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">})();                               </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 函数一返回就析构 —— 不用等 GC</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 但**成环**的对象计数归不了零，要等周期回收器</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$a </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-keyword)\"> new</span><span style=\"color:var(--shiki-token-constant)\"> D</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"A\"</span><span style=\"color:var(--shiki-foreground)\">); $b </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-keyword)\"> new</span><span style=\"color:var(--shiki-token-constant)\"> D</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"B\"</span><span style=\"color:var(--shiki-foreground)\">);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$a</span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-foreground)\">peer </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> $b; $b</span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-foreground)\">peer </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> $a;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">unset</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">$a</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-function)\"> $b</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">echo</span><span style=\"color:var(--shiki-token-string-expression)\"> \"  unset 之后还没析构\\n\"</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">gc_collect_cycles</span><span style=\"color:var(--shiki-token-punctuation)\">()</span><span style=\"color:var(--shiki-foreground)\">;                </span><span style=\"color:var(--shiki-token-comment)\">// 强制跑一遍，返回回收的环数（这里是 2）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 控制手段</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">gc_enabled</span><span style=\"color:var(--shiki-token-punctuation)\">()</span><span style=\"color:var(--shiki-foreground)\">; </span><span style=\"color:var(--shiki-token-function)\">gc_enable</span><span style=\"color:var(--shiki-token-punctuation)\">()</span><span style=\"color:var(--shiki-foreground)\">; </span><span style=\"color:var(--shiki-token-function)\">gc_disable</span><span style=\"color:var(--shiki-token-punctuation)\">()</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">gc_collect_cycles</span><span style=\"color:var(--shiki-token-punctuation)\">()</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// INI: zend.enable_gc</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 候选根放在一个**固定大小的 root buffer**（10,000 个槽），满了才跑</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 回收器**不移动对象**（地址稳定），也没有分代压缩 —— 暂停很短</span></span></code></pre>",
