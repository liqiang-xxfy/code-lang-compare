      "code": "// ⚠ 隐式转换在 C++ 里又普遍又能静默发生\ndouble d = 1;                // int -> double，静默\nint i = 3.9;                 // double -> int，静默截断成 3\nbool b = 1;                  // int -> bool，静默\nlong l = 1; int n = l;       // 窄化：默认不报错\n\n// 危险的一种：有符号与无符号混用\nunsigned u = 1;\nif (u > -1) { }              // ⚠ 结果是 **false** —— -1 被转成 4294967295\n\n// 用户定义类型也能隐式转换（构造函数没写 explicit 就行）\nstruct Money { Money(double){} };\nvoid take(Money);\n// take(3.5);                // —— 3.5 直接变成 Money\n\n// 显式转换分四种，各管一件事\ndouble pi = 3.14;\nint t = static_cast<int>(pi);              // 编译期能验证的\nauto* cp = const_cast<int*>(&ci);          // 只去 const\nauto* raw = reinterpret_cast<char*>(&pi);  // ⚠ 按位重解释，最危险\nauto* dd = dynamic_cast<Derived*>(base);   // 运行时检查，失败给 nullptr",
