ine\"><span style=\"color:var(--shiki-token-keyword)\">let</span><span style=\"color:var(--shiki-token-keyword)\"> mut</span><span style=\"color:var(--shiki-foreground)\"> s </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-function)\"> String</span><span style=\"color:var(--shiki-token-keyword)\">::</span><span style=\"color:var(--shiki-token-function)\">from</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"hi\"</span><span style=\"color:var(--shiki-foreground)\">);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">let</span><span style=\"color:var(--shiki-foreground)\"> r1 </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-keyword)\"> &#x26;</span><span style=\"color:var(--shiki-foreground)\">s;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">let</span><span style=\"color:var(--shiki-foreground)\"> r2 </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-keyword)\"> &#x26;</span><span style=\"color:var(--shiki-foreground)\">s;                   </span><span style=\"color:var(--shiki-token-comment)\">// 多个不可变借用没问题</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">println!</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"{} {}\"</span><span style=\"color:var(--shiki-foreground)\">, r1, r2);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// let r3 = &#x26;mut s;            // —— ⚠ 还有不可变借用时不能可变借用</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">edit</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">&#x26;mut</span><span style=\"color:var(--shiki-foreground)\"> s);                  </span><span style=\"color:var(--shiki-token-comment)\">// 这一刻 s 被独占</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 借用不能活得比被借的值长</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// let d; { let x = 1; d = &#x26;x; }  // —— ⚠ 编译错误：x 活不到 d 用的地方</span></span></code></pre>",
