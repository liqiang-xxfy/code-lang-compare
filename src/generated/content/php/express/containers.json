      "code": "// PHP 的「数组」**同时是列表和字典** —— 官方原话是 ordered map\n$list = [\"a\", \"b\", \"c\"];              // int 键 0,1,2\n$map  = [\"name\" => \"Ann\", \"age\" => 30];\n$mixed = [0 => \"a\", \"k\" => \"b\", 1 => \"c\"];   // 两种键可以混在一个数组里\n\n// 自动键 = 出现过的**最大 int 键 + 1**（不是补洞）\n$a = []; $a[] = \"x\"; $a[5] = \"y\"; $a[] = \"z\";   // 键是 0、5、6\n$b = [1, 2, 3]; unset($b[2]); $b[] = 9;         // ⚠ 键是 0、1、3 —— 不补 2\n// 8.3 起自动键可以是负数：[ -5 => \"a\" ] 之后 $a[] 得 -4\n\n// ⚠ 键会被强制转换\n[\"8\" => 1];        // \"8\" → int 8（看起来像整数的字符串）\n[\"08\" => 1];       // ⚠ \"08\" **保持字符串** —— 前导零不算整数\n[true => 1];       // true → 1，false → 0\n// 数组/对象做键是致命错误：Illegal offset type\n\n// ⚠ 赋值是**值拷贝**（写时复制）—— 改副本不影响原数组\n$src = [1, 2, 3];\n$copy = $src;\n$copy[] = 4;\necho count($src), count($copy);       // 3 与 4\n\n// ⚠ `+` 是**并集**：左边已有的键不会被覆盖（与 array_merge 正相反）\n$u = [\"a\" => 1] + [\"a\" => 2, \"b\" => 3];   // [\"a\"=>1, \"b\"=>3]\n$m = array_merge([\"a\" => 1], [\"a\" => 2, \"b\" => 3]);  // [\"a\"=>2, \"b\"=>3]\n\n// 展开运算符（7.4 起；字符串键 8.1 起）\n$spread = [...[1, 2], ...[3]];\n// ⚠ 展开时**同名字符串键后者胜**（并集是前者胜，两种写法规则相反）\n[...[\"a\" => 1], ...[\"a\" => 2]];       // [\"a\" => 2]\n\n// 判断「是不是一个真正的列表」用 array_is_list()（8.1 起）\narray_is_list([1, 2]);                // true\narray_is_list([1 => \"a\", 0 => \"b\"]);  // false",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// PHP 的「数组」**同时是列表和字典** —— 官方原话是 ordered map</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$list </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> [</span><span style=\"color:var(--shiki-token-string-expression)\">\"a\"</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-string-expression)\"> \"b\"</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-string-expression)\"> \"c\"</span><span style=\"color:var(--shiki-foreground)\">];              </span><span style=\"color:var(--shiki-token-comment)\">// int 键 0,1,2</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$map  </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> [</span><span style=\"color:var(--shiki-token-string-expression)\">\"name\"</span><span style=\"color:var(--shiki-token-keyword)\"> =></span><span style=\"color:var(--shiki-token-string-expression)\"> \"Ann\"</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-string-expression)\"> \"age\"</span><span style=\"color:var(--shiki-token-keyword)\"> =></span><span style=\"color:var(--shiki-token-constant)\"> 30</span><span style=\"color:var(--shiki-foreground)\">];</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$mixed </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> [</span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-token-keyword)\"> =></span><span style=\