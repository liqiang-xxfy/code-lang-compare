i-token-function)\"> fn</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-keyword)\">*</span><span style=\"color:var(--shiki-token-punctuation)\">a, </span><span style=\"color:var(--shiki-token-keyword)\">**</span><span style=\"color:var(--shiki-token-punctuation)\">kw)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">    return</span><span style=\"color:var(--shiki-foreground)\"> wrapper</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">@logged</span><span style=\"color:var(--shiki-token-comment)\">                            # 一等语法：直接写在函数上</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">def</span><span style=\"color:var(--shiki-token-function)\"> save</span><span style=\"color:var(--shiki-foreground)\">(): ...</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">@logged</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">@cached</span><span style=\"color:var(--shiki-token-comment)\">                            # 可以堆叠，从下往上包</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">def</span><span style=\"color:var(--shiki-token-function)\"> load</span><span style=\"color:var(--shiki-foreground)\">(): ...</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\"># 带参数的装饰器 = 返回装饰器的函数（三层）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">def</span><span style=\"color:var(--shiki-token-function)\"> retry</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-parameter)\">times</span><span style=\"color:var(--shiki-foreground)\">):</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">    def</span><span style=\"color:var(--shiki-token-function)\"> deco</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-parameter)\">fn</span><span style=\"color:var(--shiki-foreground)\">): ...</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">    return</span><span style=\"color:var(--shiki-foreground)\"> deco</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">@retry</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-constant)\">3</span><span style=\"color:var(--shiki-token-punctuation)\">)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">def</span><span style=\"color:var(--shiki-token-function)\"> flaky</span><span style=\"color:var(--shiki-foreground)\">(): ...</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\"># 类装饰器、属性装饰器（@property / @staticmethod）都是同一套机制</span></span></code></pre>",
