      "code": "pub struct Api {\n  pub name: String,           // 到处可见\n  pub(crate) inner: u32,      // 只在本 crate 内可见\n  pub(super) sibling: u32,    // 只在父模块可见\n  secret: u32,                // 默认：本模块及子模块\n}\n\npub mod inner {\n  pub fn helper() {}\n  pub(in crate::api) fn scoped() {}   // 指定可见范围\n}\n\n// 类型本身也要 pub，否则外部连名字都写不出来\npub enum Level { Low, High }   // enum 的变体随 enum 一起公开",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">pub</span><span style=\"color:var(--shiki-token-keyword)\"> struct</span><span style=\"color:var(--shiki-token-function)\"> Api</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  pub</span><span style=\"color:var(--shiki-foreground)\"> name</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> String</span><span style=\"color:var(--shiki-foreground)\">,           </span><span style=\"color:var(--shiki-token-comment)\">// 到处可见</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  pub</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">crate</span><span style=\"color:var(--shiki-foreground)\">) inner</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> u32</span><span style=\"color:var(--shiki-foreground)\">,      </span><span style=\"color:var(--shiki-token-comment)\">// 只在本 crate 内可见</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  pub</span><span style=\"color:var(--shiki-foreground)\">(super) sibling</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> u32</span><span style=\"color:var(--shiki-foreground)\">,    </span><span style=\"color:var(--shiki-token-comment)\">// 只在父模块可见</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  secret</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> u32</span><span style=\"color:var(--shiki-foreground)\">,                </span><span style=\"color:var(--shiki-token-comment)\">// 默认：本模块及子模块</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">pub</span><span style=\"color:var(--shiki-token-keyword)\"> mod</span><span style=\"color:var(--shiki-foreground)\"> inner {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  pub</span><span style=\"color:var(--shiki-token-keyword)\"> fn</span><span style=\"color:var(--shiki-token-function)\"> helper</span><span style=\"color:var(--shiki-foreground)\">() {}</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  pub</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">in</span><span style=\"color:var(--shiki-token-keyword)\"> crate::</span><span style=\"color:var(--shiki-foreground)\">api) </span><span style=\"color:var(--shiki-token-keyword)\">fn</span><span style=\"color:var(--shiki-token-function)\"> scoped</span><span style=\"color:var(--shiki-foreground)\">() {}   </span><span style=\"color:var(--shiki-token-comment)\">// 指定可见范围</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 类型本身也要 pub，否则外部连名字都写不出来</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">pub</span><span style=\"color:var(--shiki-token-keyword)\"> enum</span><span style=\"color:var(--shiki-token-function)\"> Level</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-function)\">Low</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-function)\">High</span><span style=\"color:var(--shiki-foreground)\"> }   </span><span style=\"color:var(--sh