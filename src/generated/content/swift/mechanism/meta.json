r:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">    get</span><span style=\"color:var(--shiki-foreground)\"> { storage</span><span style=\"color:var(--shiki-token-punctuation)\">[</span><span style=\"color:var(--shiki-foreground)\">key</span><span style=\"color:var(--shiki-token-punctuation)\">]</span><span style=\"color:var(--shiki-foreground)\"> }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">    set</span><span style=\"color:var(--shiki-foreground)\"> { storage</span><span style=\"color:var(--shiki-token-punctuation)\">[</span><span style=\"color:var(--shiki-foreground)\">key</span><span style=\"color:var(--shiki-token-punctuation)\">]</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-foreground)\"> newValue }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">var</span><span style=\"color:var(--shiki-foreground)\"> c </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-function)\"> Config</span><span style=\"color:var(--shiki-token-punctuation)\">()</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">c.host </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> \"localhost\"</span><span style=\"color:var(--shiki-token-comment)\">                 // 实际写进了 storage[\"host\"]</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">print</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">c.host </span><span style=\"color:var(--shiki-token-keyword)\">??</span><span style=\"color:var(--shiki-token-string-expression)\"> \"\"</span><span style=\"color:var(--shiki-token-punctuation)\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ② 动态调用：把「用任意参数调它」接到一个方法上</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">@dynamicCallable</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">struct</span><span style=\"color:var(--shiki-token-function)\"> Logger</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  func</span><span style=\"color:var(--shiki-token-function)\"> dynamicallyCall</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-function)\">withArguments</span><span style=\"color:var(--shiki-token-parameter)\"> args</span><span style=\"color:var(--shiki-foreground)\">: [</span><span style=\"color:var(--shiki-token-constant)\">Int</span><span style=\"color:var(--shiki-foreground)\">]) </span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-constant)\"> Int</span><span style=\"color:var(--shiki-foreground)\"> { args.</span><span style=\"color:var(--shiki-token-function)\">reduce</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-token-function)\">, </span><span style=\"color:var(--shiki-token-keyword)\">+</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\"> }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">Logger</span><span style=\"color:var(--shiki-token-punctuation)\">()(</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-token-function)\">, </span><span style=\"color:var(--shiki-token-constant)\">2</span><span style=\"color:var(--shiki-token-function)\">, </span><span style=\"color:var(--shiki-token-constant)\">3</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-token-comment)\">                    // 实际调的是那个方法</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 两者的共同点：**要拦截什么，得先在类型上声明** ——</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 而且编译期就知道你会用到这些动态名字（只是名字不检查）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 所以它不是「给任意对象套一层透明代理」</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 真正意义上的「属性访问拦截」在这门语言里没有：</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 属性的读写是编译期定好的，要么走计算属性（你自己写的）、</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 要么走属性包装器（也是显式声明的）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// KVO 那种运行时观察机制只在 Objective-C 的类上有</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 还有一处相关的：`withUnsafeMutablePointer` 能拿到存储的地址，</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 但那是手动内存那一层的事，不是代理</span></span></code></pre>",
