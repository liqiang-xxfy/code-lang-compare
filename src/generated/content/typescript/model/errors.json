-token-function)\"> fail</span><span style=\"color:var(--shiki-foreground)\">(msg</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> string</span><span style=\"color:var(--shiki-foreground)\">)</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> never</span><span style=\"color:var(--shiki-foreground)\"> {    </span><span style=\"color:var(--shiki-token-comment)\">// never：这个函数不会正常返回</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  throw</span><span style=\"color:var(--shiki-token-keyword)\"> new</span><span style=\"color:var(--shiki-token-function)\"> Error</span><span style=\"color:var(--shiki-foreground)\">(msg);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 函数签名只记参数与返回值，不记「会抛什么」—— 调用方看不出来</span></span></code></pre>",
