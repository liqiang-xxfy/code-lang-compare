pan><span style=\"color:var(--shiki-token-string-expression)\">\"没有\"</span><span style=\"color:var(--shiki-foreground)\">),</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">let</span><span style=\"color:var(--shiki-foreground)\"> n </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> found</span><span style=\"color:var(--shiki-token-keyword)\">.</span><span style=\"color:var(--shiki-token-function)\">unwrap_or</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-foreground)\">);        </span><span style=\"color:var(--shiki-token-comment)\">// 显式给出缺省值</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// let m = found.unwrap();          // —— ⚠ 是 None 时 panic —— 只在确实不会缺时用</span></span></code></pre>",
