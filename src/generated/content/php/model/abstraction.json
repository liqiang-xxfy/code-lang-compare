n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// interface Bad { private function x(): void; }   // —— ⚠ Fatal error:</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">//    Access type for interface method Bad::x() must be public</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ PHP 的接口**没有默认方法实现** —— 想共享实现请用 trait 或抽象类</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 接口常量 8.1 起可以被子接口覆盖（之前不行）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 8.4 起接口还能**声明属性**（约束的是「实现方要能公开读/写」）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">interface</span><span style=\"color:var(--shiki-token-function)\"> HasTimestamp</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">public</span><span style=\"color:var(--shiki-token-keyword)\"> string</span><span style=\"color:var(--shiki-foreground)\"> $ts { get; } }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">class</span><span style=\"color:var(--shiki-token-function)\"> Event</span><span style=\"color:var(--shiki-token-keyword)\"> implements</span><span style=\"color:var(--shiki-token-function)\"> HasTimestamp</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">public</span><span style=\"color:var(--shiki-token-keyword)\"> string</span><span style=\"color:var(--shiki-foreground)\"> $ts </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> 'now'</span><span style=\"color:var(--shiki-foreground)\">; }</span></span></code></pre>",
