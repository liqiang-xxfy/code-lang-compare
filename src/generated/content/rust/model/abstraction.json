      "code": "trait Shape {\n  fn area(&self) -> f64;                 // 只有签名 —— 必须实现\n}\n\nstruct Circle { r: f64 }\nimpl Shape for Circle {                  // 显式实现：写在 impl 块里\n  fn area(&self) -> f64 { 3.14159 * self.r * self.r }\n}\n\n// 泛型 + trait bound：**静态分发**，编译期单态化，零开销\nfn total<T: Shape>(xs: &[T]) -> f64 { xs.iter().map(|s| s.area()).sum() }\n\n// dyn Trait：**动态分发**，虚表，能放不同类型\nfn total_dyn(xs: &[Box<dyn Shape>]) -> f64 { xs.iter().map(|s| s.area()).sum() }",
