      "lang": "php",
      "code": "// 接口只有**签名** —— 所有方法都是 public 且抽象的，没有方法体\ninterface Logger {\n  public const LEVEL = 'info';              // 接口可以带常量\n  public function log(string $m): void;     // 只有签名\n}\n\nclass FileLogger implements Logger {         // 必须实现全部方法，否则致命错误\n  public function log(string $m): void { }\n}\n\n// 一个类可以 implements 多个接口；接口之间也可以 extends 多个\ninterface A { public function a(): void; }\ninterface B { public function b(): void; }\ninterface AB extends A, B { }\nclass Both implements AB { public function a(): void {} public function b(): void {} }\n\n// ⚠ 接口方法**只能是 public** —— 写 private/protected 是致命错误\n// interface Bad { private function x(): void; }   // —— ⚠ Fatal error:\n//    Access type for interface method Bad::x() must be public\n\n// ⚠ PHP 的接口**没有默认方法实现** —— 想共享实现请用 trait 或抽象类\n// 接口常量 8.1 起可以被子接口覆盖（之前不行）\n\n// 8.4 起接口还能**声明属性**（约束的是「实现方要能公开读/写」）\ninterface HasTimestamp { public string $ts { get; } }\nclass Event implements HasTimestamp { public string $ts = 'now'; }",
