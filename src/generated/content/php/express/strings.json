      "code": "// 四种写法，按「插不插值」分两类\n$name = \"Ada\";\n$a = '单引号：$name 不插值';          // 转义只认 \\' 和 \\\\ —— 写 \\n 就是两个字符\n$b = \"双引号：$name 会插值\";           // 认 \\n \\t \\\" \\$ \\x41 \\u{41} 等\n$c = <<<EOT\nheredoc：行为同双引号，$name 插值\nEOT;\n$d = <<<'EOT'\nnowdoc：行为同单引号，$name 不插值\nEOT;\n\n// ⚠ 单引号里 \\n **不是**换行 —— 这是从别的语言过来最常见的误写\necho 'A\\nB';                    // 原样输出 A\\nB\necho \"A\\nB\";                    // 这里的 \\n 才是换行\n\n// 复杂插值要加花括号\n$arr = [\"k\" => \"v\"];\necho \"值：{$arr['k']}\";          // 花括号在这里是**插值语法**\necho \"下标不加引号也认：$arr[k]\"; // 老写法，能用但不推荐\n\n// ⚠ 花括号**偏移**在 8.0 被移除 —— 下面的写法是解析错误，不是警告\n// echo $b{0};                  // —— ⚠ Parse error: unexpected token \"{\"\necho $b[0];                     // 现在只能这样取第 0 个**字节**\necho $b[-1];                    // 7.1 起支持负索引（从末尾数）\n\n// 字符串可以按下标就地改（不改变长度）\n$s = \"abc\"; $s[0] = \"X\"; echo $s;   // Xbc\n\n// ⚠ 8.2 起 `\"${name}\"` 这种插值写法被弃用，用 `\"{$name}\"`",
