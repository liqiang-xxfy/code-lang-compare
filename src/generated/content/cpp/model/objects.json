i-token-punctuation)\">:</span><span style=\"color:var(--shiki-token-function)\"> Account</span><span style=\"color:var(--shiki-foreground)\">() { bal_ </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> b; }</span><span style=\"color:var(--shiki-token-comment)\">     // 委托构造（C++11）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  explicit</span><span style=\"color:var(--shiki-token-function)\"> Account</span><span style=\"color:var(--shiki-foreground)\">(std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-token-function)\">string</span><span style=\"color:var(--shiki-foreground)\"> o) </span><span style=\"color:var(--shiki-token-punctuation)\">:</span><span style=\"color:var(--shiki-token-function)\"> owner_</span><span style=\"color:var(--shiki-foreground)\">(std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-token-function)\">move</span><span style=\"color:var(--shiki-foreground)\">(o)) { }</span><span style=\"color:var(--shiki-token-comment)\">  // 禁止隐式转换</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">  ~Account</span><span style=\"color:var(--shiki-foreground)\">() { }</span><span style=\"color:var(--shiki-token-comment)\">        // 析构：清理资源放这里（RAII 的落点）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 初始化列表是**真的初始化**，构造函数体里赋值是「先默认初始化再赋值」——</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 对 const 成员、引用成员、没有默认构造的成员，只能在列表里初始化</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 拷贝与移动构造也归这一族（编译器会隐式生成）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">Account a{</span><span style=\"color:var(--shiki-token-constant)\">100.0</span><span style=\"color:var(--shiki-foreground)\">};</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">Account b </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> a;</span><span style=\"color:var(--shiki-token-comment)\">                 // 拷贝构造</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">Account c </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-token-function)\">move</span><span style=\"color:var(--shiki-foreground)\">(a);</span><span style=\"color:var(--shiki-token-comment)\">      // 移动构造</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 写错的地方：从构造函数里**虚调用**只会调到自己那层</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 因为派生部分还没构造 —— 这是语言规则，不是 bug</span></span></code></pre>",
