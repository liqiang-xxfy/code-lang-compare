n class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  yield*</span><span style=\"color:var(--shiki-token-function)\"> countdown</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">2</span><span style=\"color:var(--shiki-foreground)\">);           </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ yield* 委托给另一个可迭代对象</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  yield</span><span style=\"color:var(--shiki-token-constant)\"> 4</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> g</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-function)\"> countdown</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">2</span><span style=\"color:var(--shiki-foreground)\">);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">g</span><span style=\"color:var(--shiki-token-function)\">.next</span><span style=\"color:var(--shiki-foreground)\">();                        </span><span style=\"color:var(--shiki-token-comment)\">// { value: 2, done: false }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">g</span><span style=\"color:var(--shiki-token-function)\">.next</span><span style=\"color:var(--shiki-foreground)\">(); </span><span style=\"color:var(--shiki-token-constant)\">g</span><span style=\"color:var(--shiki-token-function)\">.next</span><span style=\"color:var(--shiki-foreground)\">();              </span><span style=\"color:var(--shiki-token-comment)\">// 最后一次 done: true</span></span></code></pre>",
