      "code": "// 回调就是普通函数值，通常配 goroutine 使用\nfunc fetch(id int, onDone func(string)) {\n  go func() {                      // 丢到后台跑，完成时调回调\n    time.Sleep(100 * time.Millisecond)\n    onDone(fmt.Sprintf(\"数据 %d\", id))\n  }()\n}\n\ndone := make(chan string, 1)\nfetch(1, func(s string) { done <- s })\nfmt.Println(<-done)                // 也可以直接用 channel，绕开回调\n\n// 多个回调要等齐：sync.WaitGroup\nvar wg sync.WaitGroup\nfor i := 0; i < 3; i++ {\n  wg.Add(1)\n  go func(n int) { defer wg.Done(); fetch(n, func(string) {}) }(i)\n}\nwg.Wait()",
