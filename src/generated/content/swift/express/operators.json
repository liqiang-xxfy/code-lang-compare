      "code": "struct Vec {\n  var x = 0.0, y = 0.0\n  // 重载已有运算符：写成类型的静态方法\n  static func + (l: Vec, r: Vec) -> Vec { Vec(x: l.x + r.x, y: l.y + r.y) }\n  static func == (l: Vec, r: Vec) -> Bool { l.x == r.x && l.y == r.y }\n  // 复合赋值要单独写，而且左边得是 inout\n  static func += (l: inout Vec, r: Vec) { l = l + r }\n}\n\n// ⚠ Swift 还能**发明新运算符** —— 这是它比较特别的地方\ninfix operator |>: AdditionPrecedence       // 先声明\nfunc |> <A, B>(value: A, transform: (A) -> B) -> B { transform(value) }   // 再实现\n5 |> { $0 * 2 }                             // 10\n\n// 新运算符要声明结合性与优先级（`precedencegroup` 或现成的组）\n// 前缀/后缀运算符也可以自定义：\nprefix operator √\nprefix func √ (x: Double) -> Double { x.squareRoot() }\n\n// ⚠ 有两类运算符**不能**重载：`=`（赋值）与三元条件 `? :`",
