      "lang": "typescript",
      "code": "const m = new Map<string, number>();   // Map：键与值的类型写在类型参数里\nm.set(\"Ada\", 90);\nm.get(\"nope\");                         // undefined —— 返回类型是 number | undefined\nm.size;                                // 大小直接读\n[...m.entries()];                      // 按插入顺序\n\n// 同一个「字典」，三种类型表达方式\nconst counts: Record<string, number> = { Ada: 90 };    // 键值类型写全\ninterface Scores { [name: string]: number }            // 索引签名\nconst strict: Record<\"a\" | \"b\", number> = { a: 1, b: 2 };   // 键可收窄成字面量联合\n// const bad: Record<\"a\" | \"b\", number> = { c: 1 };    // —— ⚠ 编译错误：c 不是键",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> m</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-keyword)\"> new</span><span style=\"color:var(--shiki-token-function)\"> Map</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-constant)\">string</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-constant)\"> number</span><span style=\"color:var(--shiki-foreground)\">>();   </span><span style=\"color:var(--shiki-token-comment)\">// Map：键与值的类型写在类型参数里</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">m</span><span style=\"color:var(--shiki-token-function)\">.set</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"Ada\"</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-constant)\"> 90</span><span style=\"color:var(--shiki-foreground)\">);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">m</span><span style=\"color:var(--shiki-token-function)\">.get</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"nope\"</span><span style=\"color:var(--shiki-foreground)\">);                         </span><span style=\"color:var(--shiki-token-comment)\">// undefined —— 返回类型是 number | undefined</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">m</span><span style=\"color:var(--shiki-foreground)\">.size;                                </span><span style=\"color:var(--shiki-token-comment)\">// 大小直接读</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">[</span><span style=\"color:var(--shiki-token-keyword)\">...</span><span style=\"color:var(--shiki-token-constant)\">m</span><span style=\"color:var(--shiki-token-function)\">.entries</span><span style=\"color:var(--shiki-foreground)\">()];                      </span><span style=\"color:var(--shiki-token-comment)\">// 按插入顺序</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 同一个「字典」，三种类型表达方式</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> counts</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> Record</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-constant)\">string</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-constant)\"> number</span><span style=\"color:var(--shiki-foreground)\">> </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> { Ada</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> 90</span><span style=\"color:var(--shiki-foreground)\"> };    </span><span style=\"color:var(--shiki-token-comment)\">// 键值类型写全</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">interface</span><span style=\"color:var(--shiki-token-function)\"> Scores</span><span style=\"color:var(--shiki-foreground)\"> { [name</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> string</span><span style=\"color:var(--shiki-foreground)\">]</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> number</span><span style=\"color:var(--shiki-foreground)\"> }            </span><span style=\"color:var(--shiki-token-comment)\">// 索引签名</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> strict</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> Record</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-string-expression)\">\"a\"</span><span style=\"color:var(--shiki-token-keyword)\"> |</span><span style=\"color:var(--shiki-token-string-expression)\"> \"b\"</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-constant)\"> number</span><span style=\"color:var(--shiki-foreground)\">> </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> { a</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-foreground)\"> b</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> 2</span><span style=\"color:var(--shiki-foreground)\"> };   </span><span style=\"color:var(--shiki-token-comment)\">// 键可收窄成字面量联合</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// const bad: Record&#x3C;\"a\" | \"b\", number> = { c: 1 };    // —— ⚠ 编译错误：c 不是键</span></span></code></pre>",
