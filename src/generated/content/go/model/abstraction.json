      "code": "type Shape interface {          // 接口只列方法签名\n  Area() float64\n}\n\ntype Circle struct{ R float64 }\n\n// ⚠ 隐式实现：不用写任何 \"implements\"，有这个方法就满足\nfunc (c Circle) Area() float64 { return 3.14 * c.R * c.R }\n\nfunc total(shapes []Shape) float64 {   // 接收接口切片\n  var sum float64\n  for _, s := range shapes { sum += s.Area() }\n  return sum\n}\n\nshapes := []Shape{Circle{R: 1}}        // Circle 自动就是 Shape\ntotal(shapes)\n\n// 接口要小 —— 惯用的单方法接口\ntype Stringer interface{ String() string }",
