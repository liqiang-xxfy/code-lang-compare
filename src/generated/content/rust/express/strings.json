      "code": "let borrowed = \"hello\";                 // &str —— 借用，不可变，指向程序里的一段常量\nlet owned = String::from(\"hello\");      // String —— 拥有所有权，可以增长\nlet raw = r#\"路径 C:\\Users\\ 不用转义\"#;   // 原始字符串\nlet bytes = b\"abc\";                     // 字节串，类型是 &[u8; 3]\n\nlet name = \"Ada\";\nlet msg = format!(\"你好，{}！\", name);    // ⚠ 没有字符串插值，用 format! 宏",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">let</span><span style=\"color:var(--shiki-foreground)\"> borrowed </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> \"hello\"</span><span style=\"color:var(--shiki-foreground)\">;                 </span><span style=\"color:var(--shiki-token-comment)\">// &#x26;str —— 借用，不可变，指向程序里的一段常量</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">let</span><span style=\"color:var(--shiki-foreground)\"> owned </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-function)\"> String</span><span style=\"color:var(--shiki-token-keyword)\">::</span><span style=\"color:var(--shiki-token-function)\">from</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"hello\"</span><span style=\"color:var(--shiki-foreground)\">);      </span><span style=\"color:var(--shiki-token-comment)\">// String —— 拥有所有权，可以增长</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">let</span><span style=\"color:var(--shiki-foreground)\"> raw </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> r#\"路径 C:\\Users\\ 不用转义\"#</span><span style=\"color:var(--shiki-foreground)\">;   </span><span style=\"color:var(--shiki-token-comment)\">// 原始字符串</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">let</span><span style=\"color:var(--shiki-foreground)\"> bytes </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> b\"abc\"</span><span style=\"color:var(--shiki-foreground)\">;        