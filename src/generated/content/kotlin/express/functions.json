le=\"color:var(--shiki-token-constant)\">2</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-constant)\">3</span><span style=\"color:var(--shiki-foreground)\">)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">sum</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">*</span><span style=\"color:var(--shiki-foreground)\">arr)                    </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 展开运算符 *：把数组摊成参数</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">fun</span><span style=\"color:var(--shiki-token-function)\"> log</span><span style=\"color:var(--shiki-foreground)\">(prefix: </span><span style=\"color:var(--shiki-token-function)\">String</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-keyword)\">vararg</span><span style=\"color:var(--shiki-foreground)\"> items: </span><span style=\"color:var(--shiki-token-function)\">String</span><span style=\"color:var(--shiki-foreground)\">) { }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">log</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"x\"</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-string-expression)\">\"a\"</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-string-expression)\">\"b\"</span><span style=\"color:var(--shiki-foreground)\">)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">log</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"x\"</span><span style=\"color:var(--shiki-foreground)\">)                     </span><span style=\"color:var(--shiki-token-comment)\">// 一个都不给也合法</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 一个函数只能有一个 vararg 参数</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// vararg 之后的参数必须用命名参数传</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">fun</span><span style=\"color:var(--shiki-token-function)\"> f</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">vararg</span><span style=\"color:var(--shiki-foreground)\"> a: </span><span style=\"color:var(--shiki-token-function)\">Int</span><span style=\"color:var(--shiki-foreground)\">, last: </span><span style=\"color:var(--shiki-token-function)\">String</span><span style=\"color:var(--shiki-foreground)\">) { }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">f</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-constant)\">2</span><span style=\"color:var(--shiki-foreground)\">, last </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> \"末尾\"</span><span style=\"color:var(--shiki-foreground)\">)</span></span></code></pre>",
