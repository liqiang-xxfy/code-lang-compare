      "code": "const obj = {\n  name: \"Ada\",\n  greet() { return this.name; },\n};\nobj.greet();                     // \"Ada\"\nconst ref = obj.greet;\nref();                           // ⚠ TypeError —— this 丢了\n\nclass Counter {\n  n = 0;\n  bump = () => { this.n++; };    // ⚠ 箭头函数字段：this 绑定在实例上\n}",
