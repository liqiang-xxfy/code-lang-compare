      "code": "function greet(name: string): string {   // 声明式：与 JavaScript 同形，多出类型签名\n  return `你好，${name}`;\n}\nconst hi = function (name: string): string { return name; };   // 函数表达式\nconst yo = (name: string): string => `你好，${name}`;          // 箭头函数\n\n// 重载：一个函数可以有多个调用签名，实现体只有一个\nfunction pick(x: string): string;\nfunction pick(x: number): number;\nfunction pick(x: string | number) { return x; }   // 实现签名对外不可见，调用方只看见上面两条\n\n// this 参数是虚构的形参，只用来给 this 标类型\nfunction get(this: { n: number }): number { return this.n; }\n\nfunction first<T>(xs: T[]): T { return xs[0]; }   // 泛型函数的类型由调用处推断",
