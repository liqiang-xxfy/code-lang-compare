      "code": "getattr(obj, \"name\", None)        # 取属性，缺失给默认值\nhasattr(obj, \"name\")\nsetattr(obj, \"name\", 1)\ndir(obj)                          # 列出名字\ntype(obj), obj.__class__\nvars(obj)                         # __dict__\n\nimport inspect\ninspect.signature(f)              # 签名\ninspect.getsource(f)              # 源码\ninspect.getmembers(obj)           # 带类型的成员列表\n\n# 类本身也是对象：能动态创建（type(...)）、能改\nUser = type(\"User\", (Base,), {\"name\": \"Ada\"})",
