      "code": "impl User {\n  fn name(&self) -> &str { &self.name }          // 只读借用\n  fn rename(&mut self, n: &str) { self.name = n.into(); }   // 可变借用\n  fn into_name(self) -> String { self.name }     // ⚠ 消耗自身，调用后变量没了\n}\n\nlet mut u = User { name: \"Ada\".into(), age: 30 };\nprintln!(\"{}\", u.name());     // 不可变借用\nu.rename(\"Bob\");              // 可变借用 —— 调用点不需要额外标记\nlet n = u.into_name();        // ⚠ u 被移走，之后不能再用 u\n\n// 关联函数（没有 self）用 :: 调用\n// User::new(\"x\")",
