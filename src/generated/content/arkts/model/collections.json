      "code": "const xs: number[] = [1, 2, 3];\nxs.push(4);                    // const 只锁绑定，内容照样能改\nxs[0] = 9;                     // 元素可直接改写\n\nconst ys: number[] = xs;       // ⚠ 只是别名 —— 改 ys 会改到 xs\nys.push(5);                    // xs 也变成 [9, 2, 3, 4, 5]\n\nconst m: Map<string, number> = new Map();\nm.set(\"a\", 1);                 // Map 同样是引用语义\n\nclass Cfg { retries: number = 3 }\nconst c: Cfg = { retries: 3 };\nconst d: Cfg = c;              // ⚠ 同样是别名，不是复制\nd.retries = 9;                 // c.retries 也变成 9",
