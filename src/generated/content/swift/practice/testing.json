</span><span style=\"color:var(--shiki-token-function)\"> Clock </span><span style=\"color:var(--shiki-foreground)\">{                  </span><span style=\"color:var(--shiki-token-comment)\">// 手写替身</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  var</span><span style=\"color:var(--shiki-foreground)\"> fixed </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> 1000</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  func</span><span style=\"color:var(--shiki-token-function)\"> now</span><span style=\"color:var(--shiki-foreground)\">() </span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-constant)\"> Int</span><span style=\"color:var(--shiki-foreground)\"> { fixed }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">func</span><span style=\"color:var(--shiki-token-function)\"> age</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-function)\">_</span><span style=\"color:var(--shiki-token-parameter)\"> c</span><span style=\"color:var(--shiki-foreground)\">: Clock) </span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-constant)\"> Int</span><span style=\"color:var(--shiki-foreground)\"> { c.</span><span style=\"color:var(--shiki-token-function)\">now</span><span style=\"color:var(--shiki-token-punctuation)\">()</span><span style=\"color:var(--shiki-token-keyword)\"> -</span><span style=\"color:var(--shiki-token-constant)\"> 500</span><span style=\"color:var(--shiki-foreground)\"> }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">@Test</span><span style=\"color:var(--shiki-token-keyword)\"> func</span><span style=\"color:var(--shiki-token-function)\"> ageUsesClock</span><span style=\"color:var(--shiki-foreground)\">() {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">  #expect</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">age</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">FakeClock</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">fixed</span><span style=\"color:var(--shiki-token-punctuation)\">:</span><span style=\"color:var(--shiki-token-constant)\"> 1000</span><span style=\"color:var(--shiki-token-punctuation)\">))</span><span style=\"color:var(--shiki-token-keyword)\"> ==</span><span style=\"color:var(--shiki-token-constant)\"> 500</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-token-comment)\">     // 换成假的</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 两条与别处不同的约束：</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ ① 替身要能**注入** —— 代码里直接 `RealClock()` 就没法替，</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 必须改成从外面传进来（这在 Swift 里是常见重构）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ ② 想自动生成替身得引第三方库（有一些基于宏的方案）——</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ **标准库与官方工具链里没有**</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 老代码里常见的手法是「用协议把外部依赖隔开」，</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 再用结构体写假实现 —— 结构体是值类型，写起来比类轻</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 因为反射只读（见 mechanism/meta），</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 「运行时动态生成一个假对象」这条路在这门语言里基本走不通</span></span></code></pre>",
