function)\"> User</span><span style=\"color:var(--shiki-token-punctuation)\">:</span><span style=\"color:var(--shiki-token-function)\"> Loggable </span><span style=\"color:var(--shiki-foreground)\">{ }                  </span><span style=\"color:var(--shiki-token-comment)\">// 什么都不用写就拿到了 log</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">struct</span><span style=\"color:var(--shiki-token-function)\"> Order</span><span style=\"color:var(--shiki-token-punctuation)\">:</span><span style=\"color:var(--shiki-token-function)\"> Loggable </span><span style=\"color:var(--shiki-foreground)\">{ }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">User</span><span style=\"color:var(--shiki-token-punctuation)\">()</span><span style=\"color:var(--shiki-foreground)\">.</span><span style=\"color:var(--shiki-token-function)\">log</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"创建\"</span><span style=\"color:var(--shiki-token-punctuation)\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 还能**条件遵循**：只在满足某个条件时给那份实现</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">extension</span><span style=\"color:var(--shiki-token-constant)\"> Collection</span><span style=\"color:var(--shiki-token-keyword)\"> where</span><span style=\"color:var(--shiki-token-constant)\"> Element</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> Loggable</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  func</span><span style=\"color:var(--shiki-token-function)\"> logAll</span><span style=\"color:var(--shiki-foreground)\">() { </span><span style=\"color:var(--shiki-token-function)\">forEach</span><span sty