ord)\">let</span><span style=\"color:var(--shiki-foreground)\"> same </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> s1 </span><span style=\"color:var(--shiki-token-keyword)\">==</span><span style=\"color:var(--shiki-foreground)\"> s2;       </span><span style=\"color:var(--shiki-token-comment)\">// true —— == 比较内容，不是地址</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">let</span><span style=\"color:var(--shiki-foreground)\"> f </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-function)\"> f64</span><span style=\"color:var(--shiki-token-keyword)\">::</span><span style=\"color:var(--shiki-foreground)\">NAN;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// let nan_eq = f == f;    // —— false —— 浮点遵循 IEEE 754</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">#[derive(</span><span style=\"color:var(--shiki-token-function)\">PartialEq</span><span style=\"color:var(--shiki-foreground)\">)]</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">struct</span><span style=\"color:var(--shiki-token-function)\"> Point</span><span style=\"color:var(--shiki-foreground)\"> { x</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> i32</span><span style=\"color:var(--shiki-foreground)\">, y</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> i32</span><span style=\"color:var(--shiki-foreground)\"> }   </span><span style=\"color:var(--shiki-token-comment)\">// derive 自动生成逐字段比较</span></span></code></pre>",
