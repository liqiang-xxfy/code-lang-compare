      "code": "// PHP 在「按名字办事」这条路上给的口子相当多：\n\n// ① eval —— 把字符串当代码执行（8.0 起遇到语法错误抛 ParseError，可以接）\n$code = 'return 1 + 1;';\neval($code);                        // 2\n\n// ② 可变函数：函数名存在字符串里\n$fn = 'strlen';\n$fn('abcd');                        // 4\n\n// ③ 变量变量：变量名存在另一个变量里\n$key = 'name'; $name = 'Ada';\n$$key;                              // 'Ada'\n\n// ④ 动态类名 / 动态方法名\n$cls = 'App\\\\Mailer';  new $cls();  // ⚠ 注意：**不走 `use` 别名表**，得写完全限定名\n$m = 'send';  $obj->$m();           // 动态方法名\n$prop = 'email';  $obj->$prop;      // 动态属性名\n\n// ⑤ 魔术方法兜底：调一个不存在的方法时转给 __call\nclass Proxy2 { public function __call($m, $a) { return \"转给 $m\"; } }\n(new Proxy2)->whatever();           // \"转给 whatever\"\n\n// ⑥ call_user_func / call_user_func_array（老写法，现在多数场景有更直接的形式）\n\n// ⚠ 8.0 起 `assert(\"字符串\")` 不再被求值（以前字符串会被 eval）——\n// ⚠ 这个大坑已经堵上了",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// PHP 在「按名字办事」这条路上给的口子相当多：</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ① eval —— 把字符串当代码执行（8.0 起遇到语法错误抛 ParseError，可以接）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$code </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> 'return 1 + 1;'</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">eval</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">$code</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;                        </span><span style=\"color:var(--shiki-token-comment)\">// 2</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ② 可变函数：函数名存在字符串里</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$fn </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> 'strlen'</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">$fn</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">'abcd'</span><span style=\"color:var(--shiki-foreground)\">);                        </span><span style=\"color:var(--shiki-token-comment)\">// 4</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ③ 变量变量：变量名存在另一个变量里</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$key </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> 'name'</span><span style=\"color:var(--shiki-foreground)\">; $name </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> 'Ada'</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$$key;                              </span><span style=\"color:var(--shiki-token-comment)\">// 'Ada'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ④ 动态类名 / 动态方法名</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$cls </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> 'App\\\\Mailer'</span><span style=\"color:var(--shiki-foreground)\">;  </span><span style=\"color:var(--shiki-token-keyword)\">new</span><span style=\"color:var(--shiki-token-function)\"> $cls</span><span style=\"color:var(--shiki-foreground)\">();  </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 注意：**不走 `use` 别名表**，得写完全限定名</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$m </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> 'send'</span><span style=\"color:var(--shiki-foreground)\">;  $obj</span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-foreground)\">$m();           </span><span style=\"color:var(--shiki-token-comment)\">// 动态方法名</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$prop </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-str