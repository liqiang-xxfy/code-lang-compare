      "code": "n := 1                    // 推断为 int\n// n = \"text\"             // —— ⚠ 编译错误：类型定死了\n\n// 接口值在运行时携带动态类型 —— 这是 Go 唯一的「动态」之处\nvar x any = 42\nswitch v := x.(type) {     // 按动态类型分支\ncase int:\n  fmt.Println(v + 1)\n}\n\n// 反射能在运行时看类型\nt := reflect.TypeOf(x)     // int",
