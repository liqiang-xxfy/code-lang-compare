an><span style=\"color:var(--shiki-foreground)\"> { (a, b) </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> (b, a </span><span style=\"color:var(--shiki-token-keyword)\">+</span><span style=\"color:var(--shiki-foreground)\"> b) }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">    return</span><span style=\"color:var(--shiki-foreground)\"> a                           </span><span style=\"color:var(--shiki-token-comment)\">// 用 while 包住就能无限：不返回 nil</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">for</span><span style=\"color:var(--shiki-foreground)\"> x </span><span style=\"color:var(--shiki-token-keyword)\">in</span><span style=\"color:var(--shiki-token-function)\"> Fibonacci</span><span style=\"color:var(--shiki-token-punctuation)\">()</span><span style=\"color:var(--shiki-foreground)\">.</span><span style=\"color:var(--shiki-token-function)\">prefix</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-constant)\">6</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-function)\">print</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">x</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\"> }   </span><span style=\"color:var(--shiki-token-comment)\">// 0 1 1 2 3 5（靠 prefix 截断）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 也就是说「惰性序列」在 Swift 里是**一个类型**（要写 next()），</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 而在别的语言里是一段带 yield 的函数 ——</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 表达力上缺一块：没法写「中间有复杂控制流的惰性序列」而不写类型</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 替代方案：</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">//   · `.lazy` 把现成的变换变惰性（见 lazy-evaluation 那一格）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">//   · `AsyncStream` / `AsyncSequence` 处理异步产出</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">//   · 第三方库提供 `AnyIterator { ... }` 这种闭包式构造</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// AnyIterator 能让写法轻一点：</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">//   var n = 0</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">//   let seq = AnyIterator { n &#x3C; 3 ? (n += 1) : nil }</span></span></code></pre>",
