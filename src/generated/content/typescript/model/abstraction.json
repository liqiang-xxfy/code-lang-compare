      "code": "type Quacker = { quack(): string };    // 只要形状对，就是 Quacker\n\nclass Robot { quack(): string { return \"哔\" } }   // 没 implements 也算\n\nfunction use(q: Quacker): string { return q.quack() }\nuse(new Robot());                      // 编译期按形状核对，通过\n\nconst raw: unknown = JSON.parse(text); // ⚠ 运行时拿不到任何类型信息\nconst duck = raw as Quacker;           // as 只是让编译器改主意，不做运行时检查\nduck.quack();                          // ⚠ 若 raw 里没有 quack，运行时才炸",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">type</span><span style=\"color:var(--shiki-token-function)\"> Quacker</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-function)\">quack</span><span style=\"color:var(--shiki-foreground)\">()</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> string</span><span style=\"color:var(--shiki-foreground)\"> };    </span><span style=\"color:var(--shiki-token-comment)\">// 只要形状对，就是 Quacker</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">class</span><span style=\"color:var(--shiki-token-function)\"> Robot</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-function)\">quack</span><span style=\"color:var(--shiki-foreground)\">()</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> string</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">return</span><span style=\"color:var(--shiki-token-string-expression)\"> \"哔\"</span><span style=\"color:var(--shiki-foreground)\"> } }   </span><span style=\"color:var(--shiki-token-comment)\">// 没 implements 也算</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">function</span><span style=\"color:var(--shiki-token-function)\"> use</span><span style=\"color:var(--shiki-foreground)\">(q</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> Quacker</span><span style=\"color:var(--shiki-foreground)\">)</sp