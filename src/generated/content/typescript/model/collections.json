      "code": "const xs: number[] = [1, 2, 3];        // T[] 写法，元素类型标在类型位置\nconst ys: Array<number> = [4, 5];      // Array<T> 与 T[] 是同一个类型的两种写法\nxs.push(6);                            // 尾部追加（摊还 O(1)）\nxs.unshift(0);                         // ⚠ 头部插入要把整个数组往后搬，O(n)\nxs.pop();                              // 尾部弹出\nconst n = xs.length;                   // 长度随时可读 —— 数组不是定长\n// const bad: number[] = [1, \"a\"];     // —— ⚠ 编译错误：元素类型必须一致\nconst mixed: (number | string)[] = [1, \"a\"];   // 要混放得显式写成联合类型\nconst last = xs[-1];                   // ⚠ 类型说 number，运行时其实是 undefined",
