      "code": "// **表驱动测试**是 Go 的招牌写法 —— 用切片存用例，循环跑\nfunc TestParse(t *testing.T) {\n  cases := []struct {\n    name  string\n    input string\n    want  int\n  }{\n    {\"正整数\", \"42\", 42},\n    {\"负数\", \"-7\", -7},\n    {\"空串\", \"\", 0},\n  }\n\n  for _, c := range cases {\n    t.Run(c.name, func(t *testing.T) {   // ⚠ 每个用例成为独立子测试\n      if got := Parse(c.input); got != c.want {\n        t.Errorf(\"Parse(%q) = %d, 期望 %d\", c.input, got, c.want)\n      }\n    })\n  }\n}\n// 好处：加用例只加一行；失败信息带用例名；可 go test -run 'TestParse/负数' 单跑",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// **表驱动测试**是 Go 的招牌写法 —— 用切片存用例，循环跑</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">func</span><span style=\"color:var(--shiki-token-function)\"> TestParse</span><span style=\"color:var(--shiki-foreground)\">(t </span><span style=\"color:var(--shiki-token-keyword)\">*</span><span style=\"color:var(--shiki-token-function)\">testing</span><span style=\"color:var(--shiki-foreground)\">.</span><span style=\"color:var(--shiki-token-function)\">T</span><span style=\"color:var(--shiki-foreground)\">) {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  cases </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-foreground)\"> []</span><span style=\"color:var(--shiki-token-keyword)\">struct</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">    name  </span><span style=\"color:var(--shiki-token-keyword)\">string</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">    input </span><span style=\"color:var(--shiki-token-keyword)\">string</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">    want  </span><span style=\"color:var(--shiki-token-keyword)\">int</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  }{</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">    {</span><span style=\"color:var(--shiki-token-string-expression)\">\"正整数\"</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-string-expression)\">\"42\"</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-constant)\">42</span><span style=\"color:var(--shiki-foreground)\">},</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">    {</span><span style=\"color:var(--shiki-token-string-expression)\">\"负数\"</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-string-expression)\">\"-7\"</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-keyword)\">-</span><span style=\"color:var(--shiki-token-constant)\">7</span><span style=\"color:var(--shiki-foreground)\">},</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">    {</span><span style=\"color:var(--shiki-token-string-expression)\">\"空串\"</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-string-expression)\">\"\"</span><span style=\"color:var(--shiki-foreground)\">, </span><span style=\"color:var(--shiki-token-constant)\">0</span><span style=\"color:var(--shiki-foreground)\">},</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  for</span><span style=\"color:var(--shiki-foreground)\"> _, c </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-token-keyword)\"> range</span><span style=\"color:var(--shiki-foreground)\"> cases {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">    t.</span><span style=\"color:var(--shiki-token-function)\">Run</span><span style=\"color:var(--shiki-foreground)\">(c.name, </span><span style=\"color:var(--shiki-token-keyword)\">func</span><span style=\"color:var(--shiki-foreground)\">(t </span><span style=\"color:var(--shiki-token-keyword)\">*</span><span style=\"color:var(--shiki-token-function)\">testing</span><span style=\"color:var(--shiki-foreground)\">.</span><span style=\"color:var(--shiki-token-function)\">T</span><span style=\"color:var(--shiki-foreground)\">) {   </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 每个用例成为独立子测试</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">      if</span><span style=\"color:var(--shiki-foreground)\"> got </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-token-function)\"> Parse</span><span style=\"color:var(--shiki-foreground)\">(c.input); got </span><span style=\"color:var(--shiki-token-keyword)\">!=</span><span style=\"color:var(--shiki-foreground)\"> c.want {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">        t.</span><span style=\"color:var(--shiki-token-function)\">Errorf</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"Parse(</span><span style=\"color:var(--shiki-token-constant)\">%q</span><span style=\"color:var(--shiki-token-string-expression)\">) = </span><span style=\"color:var(--shiki-token-constant)\">%d</span><span style=\"color:var(--shiki-token-string-expression)\">, 期望 </span><span style=\"color:var(--shiki-token-constant)\">%d</span><span style=\"color:var(--shiki-token-string-expression)\">\"</span><span style=\"color:var(--shiki-foreground)\">, c.input, got, c.want)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">      }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">    })</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 好处：加用例只加一行；失败信息带用例名；可 go test -run 'TestParse/负数' 单跑</span></span></code></pre>",
