      "code": "const xs: number[] = [1, 2, 3];        // 元素类型写在类型位置\nconst ys: Array<number> = [4, 5];      // 与 number[] 等价的另一种写法\nxs.push(6);                            // 尾部追加（摊还 O(1)）\nxs.unshift(0);                         // ⚠ 头部插入要把整个数组往后搬，O(n)\nconst n: number = xs.length;           // 长度随时可读 —— 数组不是定长\nconst first: number = xs[0];           // 下标读到的类型是确定的\nxs[0] = 9;                             // 元素可直接改写\n// xs.push(\"x\");                       // —— ⚠ 编译错误：元素类型是 number\n// let loose: any[] = [];              // —— ⚠ 编译错误：any 被禁用，没有兜底类型",
