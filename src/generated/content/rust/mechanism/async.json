      "code": "use tokio::time::{timeout, Duration};\n\n// 取消 = drop 掉那个 Future\nlet result = timeout(Duration::from_secs(1), slow()).await;\nmatch result {\n  Ok(v) => println!(\"完成 {}\", v),\n  Err(_) => println!(\"超时（Future 已被丢弃）\"),   // ⚠ 超时就是把它 drop 了\n}\n\n// select：谁先就绪用谁，另一个被取消\n// tokio::select! {\n// v = a() => …,      // —— 另一个分支的 Future 在这里被 drop\n//   _ = sleep(…) => …,\n// }\n\n// ⚠ 取消是「在 await 点丢弃」，所以中途不会有清理回调 ——\n// 想要清理就实现 Drop",
