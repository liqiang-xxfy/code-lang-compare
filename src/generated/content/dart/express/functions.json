      "code": "int add(int a, int b) { return a + b; }     // 顶层函数：不用挂在类里\nint double2(int n) => n * 2;                // 箭头体：只能接一个表达式\n\nclass Cart {\n  int total() => 0;                         // 方法：与别处一样\n}\n\nvoid main() {\n  int helper() => 1;                        // 局部函数\n  print(helper());\n\n  var f = double2;                          // ⚠ 函数是对象，能赋给变量传出去\n  print(f(3));                              // 6\n}\n\n// 返回值类型可以省略（推成 dynamic），但官方风格要求写出来",
