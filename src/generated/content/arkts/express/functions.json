      "code": "function greet(name: string): string {   // 参数类型必须有；返回类型可以推断\n  return \"你好，\" + name;\n}\nconst yo = (name: string): string => \"你好，\" + name;   // 箭头函数\n// const hi = function (name: string) { };              // —— ⚠ 不支持函数表达式\n\nfunction apply(f: (x: number) => number, v: number): number {   // 函数类型写在签名里\n  return f(v);                         // ⚠ return 的是个调用，返回类型就得写明\n}\n\n// ⚠ 参数类型推断不出来就编译不过，也没有 any 可以兜底\n// function bad(x) { return x; }        // —— ⚠ 编译错误：x 的类型推断不出来",
