      "code": "val code = 2\nval name = when (code) {          // when 是表达式，能直接赋给名字\n  1 -> \"一\"\n  2, 3 -> \"二或三\"                 // 一个分支多个值，逗号隔开\n  in 4..9 -> \"个位数\"\n  else -> \"其他\"\n}\n\nfun describe(x: Any) = when (x) { // 无参数写法：每个分支是布尔条件\n  is String -> \"字符串，长度 ${x.length}\"\n  x is Int && x > 0 -> \"正整数\"\n  else -> \"别的\"\n}\n\nenum class Color { RED, GREEN }\nfun label(c: Color) = when (c) {  // ⚠ 枚举 / sealed 上漏分支会编译不过\n  Color.RED -> \"红\"\n  Color.GREEN -> \"绿\"\n}                                 // 这里不需要 else —— 已经穷尽了\n\n// ⚠ 没有贯穿（fallthrough）：一个分支执行完就结束，不用写 break",
