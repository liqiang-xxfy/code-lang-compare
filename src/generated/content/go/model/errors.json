e=\"color:var(--shiki-token-function)\">Unlock</span><span style=\"color:var(--shiki-foreground)\">()          </span><span style=\"color:var(--shiki-token-comment)\">// 加锁后立刻写解锁，中间 return 也不会漏</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  wg.</span><span style=\"color:var(--shiki-token-function)\">Add</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-foreground)\">)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  defer</span><span style=\"color:var(--shiki-foreground)\"> wg.</span><span style=\"color:var(--shiki-token-function)\">Done</span><span style=\"color:var(--shiki-foreground)\">()            </span><span style=\"color:var(--shiki-token-comment)\">// 多个 defer 按后进先出执行</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// defer 的参数在**注册时**求值，不是执行时</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">for</span><span style=\"color:var(--shiki-foreground)\"> i </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-token-constant)\"> 0</span><span style=\"color:var(--shiki-foreground)\">; i </span><span style=\"color:var(--shiki-token-keyword)\">&#x3C;</span><span style=\"color:var(--shiki-token-constant)\"> 3</span><span style=\"color:var(--shiki-foreground)\">; i</span><span style=\"color:var(--shiki-token-keyword)\">++</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  defer</span><span style=\"color:var(--shiki-foreground)\"> fmt.</span><span style=\"color:var(--shiki-token-function)\">Println</span><span style=\"color:var(--shiki-foreground)\">(i)       </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 打出 2 1 0 —— 值已固定，顺序是倒的</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span></code></pre>",
