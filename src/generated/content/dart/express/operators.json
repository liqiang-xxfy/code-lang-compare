      "code": "var a = \"hello\";\nvar b = \"hel\" + \"lo\";\nprint(a == b);                // true —— 字符串的 == 比的是内容\nprint(identical(a, b));       // 可能是 false：那是「同一个对象吗」\n\nvar l1 = [1, 2];\nvar l2 = [1, 2];\nprint(l1 == l2);              // ⚠ false —— 列表没有重载 ==，比的是身份\nprint(l1 == [1, 2]);          // ⚠ 同样 false，这是最常见的坑\n\nclass Point {\n  final int x;\n  Point(this.x);\n  @override\n  bool operator ==(Object other) => other is Point && other.x == x;\n  @override\n  int get hashCode => x.hashCode;      // 重载 == 必须同时重载 hashCode\n}\nprint(Point(1) == Point(1));  // true：自己定义的\n\nprint(1 == 1.0);              // ⚠ true —— 数值相等就算相等，类型不同不影响\nprint(1.hashCode == 1.0.hashCode);   // ⚠ 也是 true\nprint(identical(1, 1.0));     // false：值相等，但不是同一个对象\nprint(double.nan == double.nan);  // false：按 IEEE 规则，NaN 不等于自己",
