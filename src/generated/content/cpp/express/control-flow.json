><span style=\"color:var(--shiki-foreground)\">Green</span><span style=\"color:var(--shiki-token-punctuation)\">:</span><span style=\"color:var(--shiki-token-comment)\"> /* ... */</span><span style=\"color:var(--shiki-token-keyword)\"> break</span><span style=\"color:var(--shiki-foreground)\">;</span><span style=\"color:var(--shiki-token-comment)\">  // ⚠ 不写 break 会**贯穿**到下一支</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  default</span><span style=\"color:var(--shiki-foreground)\">: </span><span style=\"color:var(--shiki-token-keyword)\">break</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ `switch(std::string)` 编译不过：switch quantity not an integer</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 所以「按字符串分支」在 C++ 里只能写成一串 if / else</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 想按「有好几种可能」的值分支，标准做法是把它们放进一个联合类型</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-foreground)\">variant</span><span style=\"color:var(--shiki-token-keyword)\">&#x3C;int</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-foreground)\"> std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-foreground)\">string</span><span style=\"color:var(--shiki-token-keyword)\">></span><span style=\"color:var(--shiki-foreground)\"> val </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> 42</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-token-function)\">visit</span><span style=\"color:var(--shiki-foreground)\">([](</span><span style=\"color:var(--shiki-token-keyword)\">auto&#x26;&#x26;</span><span style=\"color:var(--shiki-foreground)\"> x) {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  using</span><span style=\"color:var(--shiki-token-function)\"> T</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-foreground)\"> std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-token-constant)\">decay_t</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-keyword)\">decltype</span><span style=\"color:var(--shiki-foreground)\">(x)>;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  if</span><span style=\"color:var(--shiki-token-keyword)\"> constexpr</span><span style=\"color:var(--shiki-foreground)\"> (std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-foreground)\">is_same_v</span><span style=\"color:var(--shiki-token-keyword)\">&#x3C;</span><span style=\"color:var(--shiki-foreground)\">T</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-keyword)\"> int></span><span style=\"color:var(--shiki-foreground)\">) {</span><span style=\"color:var(--shiki-token-comment)\"> /* 整数分支 */</span><span style=\"color:var(--shiki-foreground)\"> }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  else</span><span style=\"color:var(--shiki-foreground)\"> {</span><span style=\"color:var(--shiki-token-comment)\"> /* 字符串分支 */</span><span style=\"color:var(--shiki-foreground)\"> }</span></span>\n<span class=\"