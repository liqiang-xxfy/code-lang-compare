n style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">return</span><span style=\"color:var(--shiki-token-string-expression)\"> \"你好，$who\"</span><span style=\"color:var(--shiki-foreground)\">; }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">echo</span><span style=\"color:var(--shiki-token-function)\"> GREET</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"Ada\"</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;              </span><span style=\"color:var(--shiki-token-comment)\">// 函数名**不区分大小写** —— 这样也能调</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 读一个从没赋过值的变量：值当 null，同时报一条 Warning</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">echo</span><span style=\"color:var(--shiki-foreground)\"> $neverSet;                 </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ Warning: Undefined variable $neverSet</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">echo</span><span style=\"color:var(--shiki-foreground)\"> $neverSet </span><span style=\"color:var(--shiki-token-keyword)\">??</span><span style=\"color:var(--shiki-token-string-expression)\"> \"默认\"</span><span style=\"color:var(--shiki-foreground)\">;       </span><span style=\"color:var(--shiki-token-comment)\">// ?? 走的是 isset 语义，不报警告</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 还有「变量变量」：名字本身可以是另一个变量的值</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$key </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> \"name\"</span><span style=\"color:var(--shiki-foreground)\