    "module-unit": {
      "lang": "javascript",
      "code": "// 一个文件就是一个模块\nconst secret = 1;          // 模块作用域 —— 外部看不见\nexport const shared = 2;   // 只有导出的才可见\n\nimport.meta.url;           // 模块自己的元信息\n// ⚠ 没有 module.exports / require —— 那是另一套（CommonJS）",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 一个文件就是一个模块</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> secret</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-foreground)\">;          </span><span style=\"color:var(--shiki-token-comment)\">// 模块作用域 —— 外部看不见</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">export</span><span style=\"color:var(--shiki-token-keyword)\"> const</span><span style=\"color:var(--shiki-token-constant)\"> shared</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-constant)\"> 2</span><span style=\"color:var(--shiki-foreground)\">;   </span><span style=\"color:var(--shiki-token-comment)\">// 只有导出的才可见</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">import</span><span style=\"color:var(--shiki-foreground)\">.</span><span style=\"color:var(--shiki-token-constant)\">meta</span><span style=\"color:var(--shiki-foreground)\">.url;           </span><span style=\"color:var(--shiki-token-comment)\">// 模块自己的元信息</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 没有 module.exports / require —— 那是另一套（CommonJS）</span></span></code></pre>",
