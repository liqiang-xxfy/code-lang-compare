      "code": "// 动态键的正经去处是 Map\nconst m: Map<string, number> = new Map();\nm.set(\"Ada\", 90);\nm.get(\"nope\");                       // number | undefined —— 逼你判空\nm.size;                              // 大小直接读\nm.forEach((v, k) => { });            // 遍历回调带着键值类型\n\n// 想拿对象当字典，两条路 —— 键任意时用 Record，键固定时声明形状\nconst loose: Record<string, number> = {};   // 官方给的动态键形态\nloose[\"anyKey\"] = 1;                        // ⚠ 读出来是 number | undefined，用前得判空\n\ninterface Scores { Ada: number; Bob: number }   // 键在声明里逐个写死\nconst s: Scores = { Ada: 90, Bob: 85 };\n// s.Carol = 70;                     // —— ⚠ 没声明的键加不上去",
