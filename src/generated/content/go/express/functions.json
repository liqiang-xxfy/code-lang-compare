an style=\"color:var(--shiki-foreground)\">) {}          </span><span style=\"color:var(--shiki-token-comment)\">// 方法 = 带 receiver 的函数</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// func add(a, b float64) float64 { }       // —— ⚠ 不支持重载</span></span></code></pre>",
