      "lang": "rust",
      "code": "use std::fmt::Display;\n\nfn print_all<T: Display>(xs: &[T]) {          // 冒号后写约束\n  for x in xs { println!(\"{}\", x); }\n}\n\nfn print_all2<T>(xs: &[T])                    // where 子句更适合多约束\nwhere\n  T: Display + Clone,\n{\n  for x in xs { println!(\"{}\", x.clone()); }\n}\n\n// 多个约束：+ 连接\nfn max_of<T: PartialOrd + Copy>(a: T, b: T) -> T { if a > b { a } else { b } }\n\n// 约束也可以写在 impl 上，实现只对满足条件的类型存在\nimpl<T: Display> ToString for Wrapper<T> { }\n\n// 编译期常量参数（const generics）\nstruct Buf<const N: usize> { data: [u8; N] }",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">use</span><span style=\"color:var(--shiki-foreground)\"> std</span><span style=\"color:var(--shiki-token-keyword)\">::</span><span style=\"color:var(--shiki-foreground)\">fmt</span><span style=\"color:var(--shiki-token-keyword)\">::</span><span style=\"color:var(--shiki-token-function)\">Display</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">fn</span><span style=\"color:var(--shiki-token-function)\"> print_all</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-function)\">T</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> Display</span><span style=\"color:var(--shiki-foreground)\">>(xs</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-keyword)\"> &#x26;</span><span style=\"color:var(--shiki-foreground)\">[</span><span style=\"color:var(--shiki-token-function)\">T</span><span style=\"color:var(--shiki-foreground)\">]) {          </span><span style=\"color:var(--shiki-token-comment)\">// 冒号后写约束</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  for</span><span style=\"color:var(--shiki-foreground)\"> x </span><span style=\"color:var(--shiki-token-keyword)\">in</span><span style=\"color:var(--shiki-foreground)\"> xs { </span><span style=\"color:var(--shiki-token-function)\">println!</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"{}\"</span><span style=\"color:var(--shiki-foreground)\">, x); }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">fn</span><span style=\"color:var(--shiki-token-function)\"> print_all2</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-function)\">T</span><span style=\"color:var(--shiki-foreground)\">>(xs</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-keyword)\"> &#x26;</span><span style=\"color:var(--shiki-foreground)\">[</span><span style=\"color:var(--shiki-token-function)\">T</span><span style=\"color:var(--shiki-foreground)\">])                    </span><span style=\"color:var(--shiki-token-comment)\">// where 子句更适合多约束</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">where</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">  T</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> Display</span><span style=\"color:var(--shiki-token-keyword)\"> +</span><span style=\"color:var(--shiki-token-function)\"> Clone</span><span style=\"color:var(--shiki-foreground)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  for</span><span style=\"color:var(--shiki-foreground)\"> x </span><span style=\"color:var(--shiki-token-keyword)\">in</span><span style=\"color:var(--shiki-foreground)\"> xs { </span><span style=\"color:var(--shiki-token-function)\">println!</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"{}\"</span><span style=\"color:var(--shiki-foreground)\">, x</span><span style=\"color:var(--shiki-token-keyword)\">.</span><span style=\"color:var(--shiki-token-function)\">clone</span><span style=\"color:var(--shiki-foreground)\"