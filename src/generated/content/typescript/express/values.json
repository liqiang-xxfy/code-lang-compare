      "code": "let n = 42;                 // 由初值推断出 number\nlet s: string = \"hi\";       // 也可以显式标注\n// let z;                   // —— ⚠ 隐式 any：赋值前访问会被拦下\n\nfunction area(r: number): number { return 3.14 * r * r }   // 参数与返回值要写\n\ninterface Point { x: number; y: number }   // 描述形状，编译后消失\nconst K = 10;               // 推断成字面量类型 10，而不是 number\nlet m: 1 | 2 | 3 = 1;       // 联合字面量：只接受这三个值",
