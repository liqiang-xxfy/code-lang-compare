      "code": "use std::thread;\n\nlet h = thread::spawn(|| {          // OS 线程，一个线程一个栈\n  println!(\"在新线程里\");\n});\nh.join().unwrap();                   // 等它结束\n\n// 跨线程传值：move 把所有权搬进去\nlet v = vec![1, 2, 3];\nlet h = thread::spawn(move || v.len());\n// ⚠ 闭包是 move 的，之后外面不能再用 v\n\n// 作用域线程：可以借用外部数据，不用 move\nthread::scope(|s| {\n  s.spawn(|| println!(\"{}\", v.len()));   // v 只是被借用\n});\n\n// 异步任务不是标准库的事 —— 需要 tokio / async-std 这类运行时",
