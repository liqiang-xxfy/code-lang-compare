      "code": "func firstOf<T>(_ items: [T]) -> T? { items.first }     // 泛型函数\n\nstruct Box<T> {                                          // 泛型类型\n  var value: T\n}\n\nfunc pair<A, B>(_ a: A, _ b: B) -> (A, B) { (a, b) }     // 多个参数\n\n// 实参通常能从上下文推出来\nlet b = Box(value: 42)                                   // Box<Int>\nfirstOf([1, 2])                                          // T = Int\n\n// 类型参数也能显式写\nlet e = Box<String>(value: \"x\")\n\n// ⚠ 协议带关联类型时不需要写类型参数（见 generic-constraint）\n// 简化语法：`some` 坐落在返回位置，隐藏具体类型\nfunc makeBox() -> some Equatable { 42 }                  // 调用方不知道是 Int\n\n// ⚠ 关键事实：**类型参数在运行时是拿得到的** ——\n// ⚠ 泛型函数里可以写 `T.self`、可以 `T.self == Int.self`\n// ⚠ 这一点与「擦除式泛型」根本不同\nfunc nameOf<T>(_ x: T) -> String { \"\\(T.self)\" }\nnameOf(1)                                                // \"Int\"",
