-shiki-foreground)\">]                 </span><span style=\"color:var(--shiki-token-comment)\">// comma-ok：ok 表示键在不在</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">delete</span><span style=\"color:var(--shiki-foreground)\">(m, </span><span style=\"color:var(--shiki-token-string-expression)\">\"a\"</span><span style=\"color:var(--shiki-foreground)\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">for</span><span style=\"color:var(--shiki-foreground)\"> k, v </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-token-keyword)\"> range</span><span style=\"color:var(--shiki-foreground)\"> m { _, _ </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> k, v }   </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 遍历顺序随机</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 集合运算要自己写</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 用 struct{} 当值表示「只关心键」—— 零内存占用</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">set </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-token-keyword)\"> map</span><span style=\"color:var(--shiki-foreground)\">[</span><span style=\"color:var(--shiki-token-keyword)\">string</span><span style=\"color:var(--shiki-foreground)\">]</span><span style=\"color:var(--shiki-token-keyword)\">struct</span><span style=\"color:var(--shiki-foreground)\">{}{}</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">set[</span><span style=\"color:var(--shiki-token-string-expression)\">\"x\"</span><span style=\"color:var(--shiki-foreground)\">] </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-keyword)\"> struct</span><span style=\"color:var(--shiki-foreground)\">{}{}</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">_, exists </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-foreground)\"> set[</span><span style=\"color:var(--shiki-token-string-expression)\">\"x\"</span><span style=\"color:var(--shiki-foreground)\">]</span></span></code></pre>",
