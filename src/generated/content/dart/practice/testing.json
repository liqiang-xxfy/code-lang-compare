      "code": "import 'package:test/test.dart';       // 要作为开发依赖加进来\n\nvoid main() {\n  group('购物车', () {                  // 组：描述会前缀到里面的用例名上\n    test('空车总价为零', () {\n      expect(total([]), 0);\n    });\n\n    test('异步也能测：框架自动等返回的 Future', () async {\n      expect(await fetchCount(), 3);\n    });\n  });\n}\n\n# dart test                       # 默认跑当前项目的 test/ 目录\n# dart test test/cart_test.dart   # 只跑一个文件\n# dart test -n '空车'              # 按名字筛\n# dart test -t slow               # 按标签筛",
