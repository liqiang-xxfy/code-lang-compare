span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-function)\">assertSame</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-constant)\">3</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-foreground)\"> $result</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;    </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ **严格**比较（===）：类型与值都要一样</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">$this</span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-function)\">assertEquals</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-constant)\">3</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-foreground)\"> $result</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;  </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ **宽松**比较（==）—— 最经典的坑</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">$this</span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-function)\">assertTrue</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-foreground)\">$ok</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">$this</span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-function)\">assertCount</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-constant)\">3</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-foreground)\"> $items</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">$this</span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-function)\">assertNull</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-foreground)\">$value</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 异常断言要在**触发之前**调用（Arrange–Expect–Act）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">$this</span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-function)\">expectException</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-constant)\">InvalidArgumentException</span><span style=\"color:var(--shiki-token-keyword)\">::class</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">$this</span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-function)\">expectExceptionMessage</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">'不能为空'</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">throwIfEmpty</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">$input</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// PHPUnit 13 补了一批**更细的数组断言**（能控制严格性、键、顺序），</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 例如 assertArraysAreIdentical / assertArraysHaveEqualValuesIgnoringOrder</span></span></code></pre>",
