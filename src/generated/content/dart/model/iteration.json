lor:var(--shiki-token-function)\">countdown</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">3</span><span style=\"color:var(--shiki-foreground)\">).</span><span style=\"color:var(--shiki-token-function)\">toList</span><span style=\"color:var(--shiki-foreground)\">();           </span><span style=\"color:var(--shiki-token-comment)\">// [3, 2, 1]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 异步生成器：返回 Stream</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">Stream</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-constant)\">int</span><span style=\"color:var(--shiki-foreground)\">> </span><span style=\"color:var(--shiki-token-function)\">ticks</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">int</span><span style=\"color:var(--shiki-foreground)\"> n) </span><span style=\"color:var(--shiki-token-keyword)\">async*</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  for</span><span style=\"color:var(--shiki-foreground)\"> (</span><span style=\"color:var(--shiki-token-keyword)\">var</span><span style=\"color:var(--shiki-foreground)\"> i </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> 0</span><span style=\"color:var(--shiki-foreground)\">; i </span><span style=\"color:var(--shiki-token-keyword)\">&#x3C;</span><span style=\"color:var(--shiki-foreground)\"> n; i</span><span style=\"color:var(--shiki-token-keyword)\">++</span><span style=\"color:var(--shiki-foreground)\">) {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">    await</span><span style=\"color:var(--shiki-token-constant)\"> Future</span><span style=\"color:var(--shiki-foreground)\">.</span><span style=\"color:var(--shiki-token-function)\">delayed</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">Duration</span><span style=\"color:var(--shiki-foreground)\">(seconds</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-foreground)\">));</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">    yield</span><span style=\"color:var(--shiki-foreground)\"> i;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// yield* 把一个可迭代对象整个交出去（不用自己写循环）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">Iterable</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-constant)\">int</span><span style=\"color:var(--shiki-foreground)\">> </span><span style=\"color:var(--shiki-token-function)\">naturalsDownFrom</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">int</span><span style=\"color:var(--shiki-foreground)\"> n) </span><span style=\"color:var(--shiki-token-keyword)\">sync*</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  if</span><span style=\"color:var(--shiki-foreground)\"> (n </span><span style=\"color:var(--shiki-token-keyword)\">></span><span style=\"color:var(--shiki-token-constant)\"> 0</span><span style=\"color:var(--shiki-foreground)\">) {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">    yield</span><span style=\"color:var(--shiki-foreground)\"> n;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">    yield*</span><span style=\"color:var(--shiki-token-function)\"> naturalsDownFrom</span><span style=\"color:var(--shiki-foreground)\">(n </span><span style=\"color:var(--shiki-token-keyword)\">-</span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-foreground)\">);   </span><span style=\"color:var(--shiki-token-comment)\">// 委托给另一个生成器</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 同步还是异步**由返回类型决定**：Iterable 配 sync*，Stream 配 async*</span></span></code></pre>",
