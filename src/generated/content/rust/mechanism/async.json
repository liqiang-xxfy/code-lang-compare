 class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ Rust 的 Future 是**惰性**的 —— 造出来不会跑</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">async</span><span style=\"color:var(--shiki-token-keyword)\"> fn</span><span style=\"color:var(--shiki-token-function)\"> work</span><span style=\"color:var(--shiki-foreground)\">() </span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-function)\"> i32</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-constant)\">42</span><span style=\"color:var(--shiki-foreground)\"> }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">let</span><span style=\"color:var(--shiki-foreground)\"> f </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-function)\"> work</span><span style=\"color:var(--shiki-foreground)\">();          </span><span style=\"color:var(--shiki-token-comment)\">// 到这里什么都没发生，还会收到 unused 警告</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 必须交给执行器：tokio::spawn(f) 或 .await</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 组合子</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// let both = futures::join!(a(), b());</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// let either = futures::select! { … };</span></span></code></pre>",
