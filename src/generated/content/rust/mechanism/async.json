      "code": "use std::future::Future;\nuse std::pin::Pin;\nuse std::task::{Context, Poll};\n\n// Future 是一个 trait：poll 一次，要么就绪、要么说「还没好」\n// fn poll(self: Pin<&mut Self>, cx: &mut Context) -> Poll<Self::Output>\n\n// ⚠ Rust 的 Future 是**惰性**的 —— 造出来不会跑\nasync fn work() -> i32 { 42 }\nlet f = work();          // 到这里什么都没发生，还会收到 unused 警告\n// 必须交给执行器：tokio::spawn(f) 或 .await\n\n// 组合子\n// let both = futures::join!(a(), b());\n// let either = futures::select! { … };",
