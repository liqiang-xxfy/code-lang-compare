><span style=\"color:var(--shiki-token-keyword)\">catch</span><span style=\"color:var(--shiki-foreground)\"> (e, st) {                      </span><span style=\"color:var(--shiki-token-comment)\">// 兜底；第二个参数是栈</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">  print</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">'别的错：</span><span style=\"color:var(--shiki-token-string-expression)\">$e</span><span style=\"color:var(--shiki-token-string-expression)\">'</span><span style=\"color:var(--shiki-foreground)\">);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">  print</span><span style=\"color:var(--shiki-foreground)\">(st);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">} </span><span style=\"color:var(--shiki-token-keyword)\">finally</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">  print</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">'总会执行'</span><span style=\"color:var(--shiki-foreground)\">);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 只写 on 不写 catch 是合法的，也确实拿不到对象 —— 不是漏写</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// catch (e) 不带类型等于接住一切</span></span></code></pre>",
