      "code": "function counter(): () => number {\n  let n = 0;\n  return () => ++n;                 // 闭包记住 n，返回出去后它仍然活着\n}\nconst next = counter();\nnext(); next();                     // 1 2\n// ⚠ 收窄不会带进闭包体：编译器假设闭包稍后才会执行\nlet v: string | number = \"a\";\nif (typeof v === \"string\") {\n  // const h = () => v.toUpperCase();   // —— ⚠ 报错：闭包里 v 又变回联合类型\n}\n\n// ⚠ `var` 的循环变量所有闭包共享；`let` 每轮新建一个绑定\nconst fns: (() => number)[] = [];\nfor (var i = 0; i < 3; i++) fns.push(() => i);   // 全部拿到 3",
