      "code": "impl Account {\n  fn new(owner: &str) -> Self {          // new 只是个惯例名，不是关键字\n    Account { owner: owner.to_string(), balance: 0 }\n  }\n}\nlet a = Account::new(\"Ada\");\n\n// 也可以定义别的名字，表达不同语义\nimpl Account {\n  fn empty() -> Self { Account::new(\"\") }\n  fn with_balance(owner: &str, n: i64) -> Self {\n    Account { owner: owner.into(), balance: n }\n  }\n}\n\n#[derive(Default)]                        // derive 出「零值构造」\nstruct Config { retries: u32 }\nlet c = Config::default();\n\n// 字面量构造也是一等写法\nlet b = Account { owner: \"Bob\".into(), balance: 100 };",
