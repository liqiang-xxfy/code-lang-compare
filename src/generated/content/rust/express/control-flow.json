      "code": "let mut i = 0;\nwhile i < 3 { i += 1; }        // while\n\nloop {                         // 无限循环；break 可以带一个值出去\n  let n = next();\n  if n > 10 { break n; }\n};\n\nfor x in 0..3 { println!(\"{}\", x); }   // 0 1 2 —— 只有 for-in，没有 C 式三段\n\n'outer: for i in 0..3 {        // 标签 + break，直接跳出外层\n  for j in 0..3 {\n    if j == 2 { continue 'outer; }\n  }\n}",
