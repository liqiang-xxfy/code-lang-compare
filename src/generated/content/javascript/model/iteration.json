hiki-foreground)\"> { a: { </span><span style=\"color:var(--shiki-token-constant)\">b</span><span style=\"color:var(--shiki-foreground)\"> } } </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> nested;            </span><span style=\"color:var(--shiki-token-comment)\">// 嵌套</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">function</span><span style=\"color:var(--shiki-token-function)\"> f</span><span style=\"color:var(--shiki-foreground)\">({ x</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-foreground)\"> y }) {}                 </span><span style=\"color:var(--shiki-token-comment)\">// 参数位置直接解构</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">[a</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-foreground)\"> b] </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> [b</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-foreground)\"> a];                        </span><span style=\"color:var(--shiki-token-comment)\">// 交换</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-foreground)\"> [</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-constant)\"> second</span><span style=\"color:var(--shiki-foreground)\">] </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> xs;                  </span><span style=\"color:var(--shiki-token-comment)\">// 跳过第一个</span></span></code></pre>",
