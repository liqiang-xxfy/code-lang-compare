      "code": "fun a(): Int = 1                  // 表达式体：返回类型能推断\nfun b(): Int { return 1 }         // ⚠ 块体的返回类型**不能省**（Unit 除外）\nfun c() { return }                // 推成 Unit 是唯一的例外\n\nfun log(msg: String) { }          // 不写返回类型 = 返回 Unit\nfun log2(msg: String): Unit { }   // 写出来是同一个意思\n\nfun fail(msg: String): Nothing {  // Nothing：永远不返回\n  throw IllegalStateException(msg)\n}\n\nval x = if (true) 1 else fail(\"不会发生\")   // 靠 Nothing 让类型对上\n\n// Kotlin 没有 void 这个类型，Unit 是一个真实存在的值\nval u: Unit = log(\"hi\")",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">fun</span><span style=\"color:var(--shiki-token-function)\"> a</span><span style=\"color:var(--shiki-foreground)\">(): </span><span style=\"color:var(--shiki-token-function)\">Int</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-token-comment)\">                  // 表达式体：返回类型能推断</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">fun</span><span style=\"color:var(--shiki-token-function)\"> b</span><span style=\"color:var(--shiki-foreground)\">(): </span><span style=\"color:var(--shiki-token-function)\">Int</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">return</span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-foreground)\"> }         </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 块体的返回类型**不能省**（Unit 除外）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">fun</span><span style=\"color:var(--shiki-token-function)\"> c</span><span style=\"color:var(--shiki-foreground)\">() { </span><span style=\"color:var(--shiki-token-keyword)\">return</span><span style=\"color:var(--shiki-foreground)\"> }                </span><span style=\"color:var(--shiki-token-comment)\">// 推成 Unit 是唯一的例外</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">fun</span><span style=\"color:var(--shiki-token-function)\"> log</span><span style=\"color:var(--shiki-foreground)\">(msg: </span><span style=\"color:var(--shiki-token-function)\">String</span><span style=\"color:var(--shiki-foreground)\">) { }          </span><span style=\"color:var(--shiki-token-comment)\">// 不写返回类型 = 返回 Unit</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">fun</span><span style=\"color:var(--shiki-token-function)\"> log2</span><span style=\"color:var(--shiki-foreground)\">(msg: </span><span style=\"color:var(--shiki-token-function)\">String</span><span style=\"color:var(--shiki-foreground)\">): </span><span style=\"color:var(--shiki-token-function)\">Unit</span><span style=\"color:var(--shiki-foreground)\"> { }   </span><span style=\"color:var(--shiki-token-comment)\">// 写出来是同一个意思</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">fun</span><span style=\"color:var(--shiki-token-function)\"> fail</span><span style=\"color:var(--shiki-foreground)\">(msg: </span><span style=\"color:var(--shiki-token-function)\">String</span><span style=\"color:var(--shiki-foreground)\">): </span><span style=\"color:var(--shiki-token-function)\">Nothing</span><span style=\"color:var(--shiki-foreground)\"> {  </span><span style=\"color:var(--shiki-token-comment)\">// Nothing：永远不返回</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  throw</span><span style=\"color:var(--shiki-token-function)\"> IllegalStateException</span><span style=\"color:var(--shiki-foreground)\">(msg)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">val</span><span style=\"color:var(--shiki-foreground)\"> x </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-keyword)\"> if</span><span style=\"color:var(--shiki-foreground)\"> (</span><span style=\"color:var(--shiki-token-constant)\">true</span><span style=\"color:var(--shiki-foreground)\">) </span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-tok