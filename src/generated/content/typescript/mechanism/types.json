      "lang": "typescript",
      "code": "interface Quacker { quack(): string }\nclass Duck { quack() { return \"嘎\" } }\n\nconst d: Quacker = new Duck();   // 没写 implements，形状对就通过\n\n// 两个形状相同的接口互相兼容\ninterface A { x: number }\ninterface B { x: number }\nconst b: B = { x: 1 };\nconst a: A = b;                  // 合法：只比形状，不比名字\n\n// 但私有字段把它拉回「名义」那一侧\nclass P { private tag = 1 }\nclass Q { private tag = 1 }\n// const q: P = new Q();         // —— ⚠ 错误：私有字段来自不同的声明",
