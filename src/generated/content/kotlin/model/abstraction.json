      "code": "interface Greeter {\n  fun greet(name: String): String                  // 抽象方法\n  fun greetTwice(name: String) = \"${greet(name)}、${greet(name)}\"   // 带默认实现\n  val prefix: String                               // 抽象属性，实现者提供\n  val label: String get() = \"[$prefix]\"            // 有 getter 的属性也可以\n  // var count = 0                                 // —— ⚠ 编译错误：接口不能有幕后字段\n}\n\nclass Hello : Greeter {\n  override val prefix = \"你好\"\n  override fun greet(name: String) = \"$prefix $name\"\n}\n\n// 一个类能实现多个接口；同名默认实现冲突时必须显式覆盖\ninterface A { fun f() = \"A\" }\ninterface B { fun f() = \"B\" }\nclass C : A, B {\n  override fun f() = super<A>.f() + super<B>.f()    // 用 super<接口> 指名\n}",
