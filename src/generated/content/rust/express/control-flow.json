      "code": "let msg = match code {\n  200 => \"OK\",\n  301 | 302 => \"重定向\",          // 一个分支匹配多个值\n  400..=499 => \"客户端错误\",       // 可以匹配区间\n  n if n >= 500 => \"服务端错误\",   // 守卫条件\n  _ => \"未知\",                    // ⚠ match 必须穷尽，漏了编译不过\n};\n\nmatch shape {\n  Circle { r } => println!(\"{}\", r),        // 直接解构出字段\n  Rect { w, h } if w == h => println!(\"正方形\"),\n  Rect { w, h } => println!(\"{}x{}\", w, h),\n}",
