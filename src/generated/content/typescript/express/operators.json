      "code": "7 / 2;                    // 3.5 —— 只有一种除法，永远得浮点\nMath.trunc(7 / 2);        // 3 —— 想要整数除法得自己截断\n-7 % 3;                   // ⚠ -1 —— 余数符号跟着被除数走\n0.1 + 0.2;                // ⚠ 0.30000000000000004\n\nlet i = 0;\ni++;                      // 自增自减是表达式，有前置 / 后置之别\n\n// 运算符与运行时一字不改，多出来的是编译期对 + 的类型规则\nfunction add(a: number | string) {\n  // return a + 1;         // —— ⚠ 编译错误：string | number 不能直接与 number 相加\n  return typeof a === \"number\" ? a + 1 : a + \"!\";\n  // 先收窄，+ 才确定是数值加法还是字符串拼接\n}",
