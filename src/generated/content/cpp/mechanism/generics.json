><span style=\"color:var(--shiki-token-comment)\">      // 合法（加 const 不算型变）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// const std::vector&#x3C;double>&#x26; crd = vi;  // —— ⚠ 不行</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 想在「不同的元素类型」之间做通用的东西，有两条路：</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">//   ① 模板：把元素类型当参数（互相之间仍然没有赋值关系）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">template</span><span style=\"color:var(--shiki-foreground)\"> &#x3C;</span><span style=\"color:var(--shiki-token-keyword)\">typename</span><span style=\"color:var(--shiki-token-function)\"> T</span><span style=\"color:var(--shiki-foreground)\">> </span><span style=\"color:var(--shiki-token-keyword)\">void</span><span style=\"color:var(--shiki-token-function)\"> sum</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-foreground)\"> std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-token-function)\">vector</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-function)\">T</span><span style=\"color:var(--shiki-foreground)\">></span><span style=\"color:var(--shiki-token-keyword)\">&#x26;</span><span style=\"color:var(--shiki-foreground)\"> v);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">//   ② 迭代器/视图：不拥有数据，看的是「一段范围」</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">void</span><span style=\"color:var(--shiki-token-function)\"> sumRange</span><span style=\"color:var(--shiki-foreground)\">(std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-token-function)\">span</span><span style=\"colo