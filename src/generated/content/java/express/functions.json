n class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 没有自由函数 —— 顶层写不了函数</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">Function</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-keyword)\">String</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-keyword)\"> String</span><span style=\"color:var(--shiki-foreground)\">> greet </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> name </span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-string-expression)\"> \"你好，\"</span><span style=\"color:var(--shiki-token-keyword)\"> +</span><span style=\"color:var(--shiki-foreground)\"> name;   </span><span style=\"color:var(--shiki-token-comment)\">// lambda 是值</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">greet</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">apply</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"Ada\"</span><span style=\"color:var(--shiki-foreground)\">);</span></span></code></pre>",
