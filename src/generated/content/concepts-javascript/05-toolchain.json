          "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 格式化：google-java-format 或 IDE 内置风格</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 静态检查：SpotBugs / Error Prone / IDE 检查</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 没有 ESLint 那种「规则可插拔 + 社区共享配置」的中心</span></span></code></pre>",
          "lineCount": 3,
