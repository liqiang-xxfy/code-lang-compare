shiki-token-function)\">.race</span><span style=\"color:var(--shiki-foreground)\">([a</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-foreground)\"> b]);       </span><span style=\"color:var(--shiki-token-comment)\">// 第一个落定的说了算</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ Promise 一旦创建就开始执行，**没法取消**</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 忘记 catch 会变成「未处理的拒绝」—— 默认只是控制台警告</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">p</span><span style=\"color:var(--shiki-token-function)\">.catch</span><span style=\"color:var(--shiki-foreground)\">((e) </span><span style=\"color:var(--shiki-token-keyword)\">=></span><span style=\"color:var(--shiki-token-constant)\"> console</span><span style=\"color:var(--shiki-token-function)\">.error</span><span style=\"color:var(--shiki-foreground)\">(e));   </span><span style=\"color:var(--shiki-token-comment)\">// 错误沿链传播：一个 catch 管到底</span></span></code></pre>",
