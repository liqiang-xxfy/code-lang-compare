an style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-foreground)\"> any                      # any </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> 不设约束</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">dev_dependencies</span><span style=\"color:var(--shiki-token-keyword)\">:</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  test</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-keyword)\"> ^</span><span style=\"color:var(--shiki-token-constant)\">1.25</span><span style=\"color:var(--shiki-foreground)\">.</span><span style=\"color:var(--shiki-token-constant)\">0</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  lints</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-keyword)\"> ^</span><span style=\"color:var(--shiki-token-constant)\">5.0</span><span style=\"color:var(--shiki-foreground)\">.</span><span style=\"color:var(--shiki-token-constant)\">0</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">dependency_overrides</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-foreground)\">            # 临时强制某个版本（排查问题用）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  http</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-keyword)\"> ^</span><span style=\"color:var(--shiki-token-constant)\">1.1</span><span style=\"color:var(--shiki-foreground)\">.</span><span style=\"color:var(--shiki-token-constant)\">0</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\"># 依赖来源分四类：hosted（默认）</span><span style=\"color:var(--shiki-token-keyword)\">/</span><span style=\"color:var(--shiki-foreground)\"> git </span><span style=\"color:var(--shiki-token-keyword)\">/</span><span style=\"color:var(--shiki-foreground)\"> path </span><span style=\"color:var(--shiki-token-keyword)\">/</span><span style=\"color:var(--shiki-foreground)\"> sdk</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\"># 注意：git 与 path 依赖</span><span style=\"color:var(--shiki-token-keyword)\">**</span><span style=\"color:var(--shiki-foreground)\">不允许</span><span style=\"color:var(--shiki-token-keyword)\">**</span><span style=\"color:var(--shiki-foreground)\">发布到 pub.dev</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\"># 「发布出去的 overrides 对使用者无效」—— 只影响当前这个包</span></span></code></pre>",
