 ⚠ 保持插入顺序是**固有行为**，不需要 SortedMap 之类</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">[</span><span style=\"color:var(--shiki-token-string-expression)\">\"z\"</span><span style=\"color:var(--shiki-token-keyword)\"> =></span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-string-expression)\"> \"a\"</span><span style=\"color:var(--shiki-token-keyword)\"> =></span><span style=\"color:var(--shiki-token-constant)\"> 2</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-string-expression)\"> \"m\"</span><span style=\"color:var(--shiki-token-keyword)\"> =></span><span style=\"color:var(--shiki-token-constant)\"> 3</span><span style=\"color:var(--shiki-foreground)\">];   </span><span style=\"color:var(--shiki-token-comment)\">// 遍历顺序就是 z、a、m</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 排序是另外的动作，而且分成「保键 / 不保键」两组</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$m </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> [</span><span style=\"color:var(--shiki-token-string-expression)\">\"z\"</span><span style=\"color:var(--shiki-token-keyword)\"> =></span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-string-expression)\"> \"a\"</span><span style=\"color:var(--shiki-token-keyword)\"> =></span><span style=\"color:var(--shiki-token-constant)\"> 2</span><span style=\"color:var(--shiki-foreground)\">];</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">asort</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">$m</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;                     </span><span style=\"color:var(--shiki-token-comment)\">// 按值排序、**保留键**</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">ksort</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">$m</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;                     </span><span style=\"color:var(--shiki-token-comment)\">// 按键排序、保留键</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">sort</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">$m</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;                      </span><span style=\"color:var(--shiki-token-comment)\">// ⚠ 按值排序、**丢弃键**（重排成 0..n-1）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 想用**对象**当键，数组做不到 —— 要用 SPL 的 SplObjectStorage</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$store </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-keyword)\"> new</span><span style=\"color:var(--shiki-token-constant)\"> SplObjectStorage</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$o </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-keyword)\"> new</span><span style=\"color:var(--shiki-token-constant)\"> stdClass</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$store[$o] </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> \"与这个对象绑定的数据\"</span><span style=\"color:var(--shiki-foreground)\">;   </span><span style=\"color:var(--shiki-token-comment)\">// 按对象**身份**做键</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">echo</span><span style=\"color:var(--shiki-foreground)\"> $store[$o];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 定长数组也有：SplFixedArray（省内存，但没有字符串键）</span></span></code></pre>",
