      "code": "// 主构造器：写在类头，带 val/var 的参数同时成为属性\nclass User(val name: String, var age: Int = 0)\n\n// 不带 val/var 的参数只在 init 块与属性初始化器里可用\nclass Token(raw: String) {\n  val value = raw.trim()             // 这里能用 raw\n}\n// token.raw                          // —— ⚠ 编译错误：它不是属性\n\n// init 块：按**书写顺序**执行，与属性初始化器穿插着跑\nclass Logged {\n  val a = println(\"先算 a\")\n  init { println(\"再跑 init\") }\n  val b = println(\"最后算 b\")\n}\n\n// 次构造器：必须（直接或间接）委托给主构造器\nclass Box(val w: Int) {\n  constructor() : this(0)            // 通过 this(...) 委托\n}\n\n// 想要「构造函数私有」就显式写\nclass Singleton private constructor()",
