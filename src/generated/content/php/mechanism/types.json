)\">;   </span><span style=\"color:var(--shiki-token-comment)\">// instanceof 之后确定是 DateTime</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">$label </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-keyword)\"> match</span><span style=\"color:var(--shiki-foreground)\"> (</span><span style=\"color:var(--shiki-token-constant)\">true</span><span style=\"color:var(--shiki-foreground)\">) {                       </span><span style=\"color:var(--shiki-token-comment)\">// PHP 8：把多个判断写成一个表达式</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">  is_string</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">$v</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-token-keyword)\"> =></span><span style=\"color:var(--shiki-token-string-expression)\"> \"字符串\"</span><span style=\"color:var(--shiki-token-punctuation)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">  is_int</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">$v</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-token-keyword)\">    =></span><span style=\"color:var(--shiki-token-string-expression)\"> \"整数\"</span><span style=\"color:var(--shiki-token-punctuation)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  default</span><span style=\"color:var(--shiki-token-keyword)\">       =></span><span style=\"color:var(--shiki-token-string-expression)\"> \"其它\"</span><span style=\"color:var(--shiki-token-punctuation)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreg