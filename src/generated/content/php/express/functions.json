color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">string</span><span style=\"color:var(--shiki-foreground)\"> $who </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> \"访客\"</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-keyword)\"> int</span><span style=\"color:var(--shiki-foreground)\"> $times </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-foreground)\">)</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-keyword)\"> string</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  return</span><span style=\"color:var(--shiki-token-function)\"> str_repeat</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"你好，$who \"</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-function)\"> $times</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// function bad(int $n = $GLOBALS['x']) {}   // —— ⚠ Fatal error:</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">//    Constant expression contains invalid operations</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 8.1 起默认值里可以用 `new`，但仍是编译期可求值的表达式</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 命名参数（8.0 起）：可以跳过前面的可选参数</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">echo</span><span style=\"color:var(--shiki-token-function)\"> greet</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">times</span><span style=\"color:var(--shiki-token-punctuation)\">:</span><span style=\"color:var(--shiki-token-constant)\"> 2</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;           </span><span style=\"color:var(--shiki-token-comment)\">// \"你好，访客 你好，访客 \"</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">echo</span><span style=\"color:var(--shiki-token-function)\"> greet</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"Ada\"</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-function)\"> times</span><span style=\"color:var(--shiki-token-punctuation)\">:</span><span style=\"color:var(--shiki-token-constant)\"> 3</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 命名参数必须写在位置参数**之后**；重复给同一个会抛 Error</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 传 null **不会**触发默认值 —— 默认值只在「省略」时生效</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// echo greet(null);            // —— ⚠ TypeError（string 收不了 null）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">function</span><span style=\"color:var(--shiki-token-function)\"> greet2</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">?string</span><span style=\"color:var(--shiki-foreground)\"> $who <