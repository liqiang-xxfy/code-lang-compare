      "code": "const x: unknown = JSON.parse(raw);\nconst s = x as string;      // 断言：编译器信你，运行时不检查\n\n// 注意断言不做转换 —— 它只是让编译器改主意\nconst n = x as number;\n// n.toFixed(2);            // —— ⚠ 运行时可能炸：x 也许是个字符串\n\n// 双重断言：借 unknown 这个中转站绕开兼容性检查\nconst o: { a: number } = { a: 1 };\nconst y = o as unknown as number;   // ⚠ 两步跳 —— 编译器不再问「这两个像不像」\n\n// 真的想确认，只能自己写运行时检查\nif (typeof x === \"string\") { /* 到这里才是真的 */ }",
