e\"><span style=\"color:var(--shiki-token-keyword)\">  void</span><span style=\"color:var(--shiki-token-function)\"> f</span><span style=\"color:var(--shiki-foreground)\">() </span><span style=\"color:var(--shiki-token-keyword)\">override</span><span style=\"color:var(--shiki-foreground)\"> { }</span><span style=\"color:var(--shiki-token-comment)\">                // override 是检查，不是必须</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">struct</span><span style=\"color:var(--shiki-token-function)\"> A</span><span style=\"color:var(--shiki-foreground)\"> { }; </span><span style=\"color:var(--shiki-token-keyword)\">struct</span><span style=\"color:var(--shiki-token-function)\"> B</span><span style=\"color:var(--shiki-foreground)\"> { };</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">struct</span><span style=\"color:var(--shiki-token-function)\"> C</span><span style=\"color:var(--shiki-token-punctuation)\"> :</span><span style=\"color:var(--shiki-foreground)\"> A</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-function)\"> B</span><span style=\"color:var(--shiki-foreground)\"> { };</span><span style=\"color:var(--shiki-token-comment)\">                   // ⚠ 支持**多继承**（别的语言少见）</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 虚继承（菱形继承时避免基类有两份）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">struct</span><span style=\"color:var(--shiki-token-function)\"> D</span><span style=\"color:var(--shiki-token-punctuation)\"> :</span><span style=\"color:var(--shiki-token-keyword)\"> virtual</span><span style=\"color:var(--shiki-token-function)\"> A</span><span style=\"color:var(--shiki-foreground)\"> { };</span></span>\n<span class=\"line\"