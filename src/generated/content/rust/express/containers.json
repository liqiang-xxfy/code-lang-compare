      "code": "use std::collections::HashMap;         // 不在 prelude 里，要显式引入\n\nlet mut scores: HashMap<String, i32> = HashMap::new();\nscores.insert(\"Ada\".to_string(), 90);\nscores.insert(\"Bob\".to_string(), 85);   // insert 会覆盖旧值并返回它\n\nlet s = scores.get(\"Ada\");              // Option<&i32>\nlet s = scores.get(\"Ada\").copied().unwrap_or(0);\n\nscores.entry(\"Eve\".to_string()).or_insert(0);  // 没有才插入\n*scores.entry(\"Eve\".to_string()).or_insert(0) += 1;  // 计数器的标准写法\n\nfor (k, v) in &scores { }               // 遍历顺序不保证\n// scores[\"nope\"]                       // —— ⚠ Index 用在缺失 key 上会 panic",
