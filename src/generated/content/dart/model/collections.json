span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-foreground)\"> () </span><span style=\"color:var(--shiki-token-keyword)\">=></span><span style=\"color:var(--shiki-token-constant)\"> 0</span><span style=\"color:var(--shiki-foreground)\">);   </span><span style=\"color:var(--shiki-token-comment)\">// 给兜底</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">ages[</span><span style=\"color:var(--shiki-token-string-expression)\">'Ada'</span><span style=\"color:var(--shiki-foreground)\">];                          </span><span style=\"color:var(--shiki-token-comment)\">// 30</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">ages[</span><span style=\"color:var(--shiki-token-string-expression)\">'Nobody'</span><span style=\"color:var(--shiki-foreground)\">];                       </span><span style=\"color:var(--shiki-token-comment)\">// null（返回类型是 int?）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">ages.</span><span style=\"color:var(--shiki-token-function)\">containsKey</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">'Ada'</span><span style=\"color:var(--shiki-foreground)\">);              </span><span style=\"color:var(--shiki-token-comment)\">// 比拿 null 可靠</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">ages.keys; ages.values; ages.entries;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">var</span><span style=\"color:var(--shiki-foreground)\"> merged </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> {...ages, </span><span style=\"color:var(--shiki-token-string-expression)\">'Eve'</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> 40</span><span style=\"color:var(--shiki-foreground)\">};    </span><span style=\"color:var(--shiki-token-comment)\">// 展开合并，后面的覆盖前面</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 默认实现保持**插入顺序**（LinkedHashMap）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 要无序用 HashMap，要按 key 排序用 SplayTreeMap</span></span></code></pre>",
