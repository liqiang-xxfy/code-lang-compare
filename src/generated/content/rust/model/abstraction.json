n</span><span style=\"color:var(--shiki-token-function)\"> Quack</span><span style=\"color:var(--shiki-foreground)\">) { </span><span style=\"color:var(--shiki-token-function)\">println!</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"{}\"</span><span style=\"color:var(--shiki-foreground)\">, q</span><span style=\"color:var(--shiki-token-keyword)\">.</span><span style=\"color:var(--shiki-token-function)\">quack</span><span style=\"color:var(--shiki-foreground)\">()); }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 反过来：trait bound 能表达「任何能比较的东西」</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">fn</span><span style=\"color:var(--shiki-token-function)\"> max_of</span><span style=\"color:var(--shiki-foreground)\">&#x3C;</span><span style=\"color:var(--shiki-token-function)\">T</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> PartialOrd</span><span style=\"color:var(--shiki-foreground)\">>(a</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> T</span><span style=\"color:var(--shiki-foreground)\">, b</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> T</span><span style=\"color:var(--shiki-foreground)\">) </span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-function)\"> T</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">if</span><span style=\"color:var(--shiki-foreground)\"> a </span><span style=\"color:var(--shiki-token-keyword)\">></span><span style=\"color:var(--shiki-foreground)\"> b { a } </span><span style=\"color:var(--shiki-token-keyword)\">else</span><span style=\"color:var(--shiki-foregrou