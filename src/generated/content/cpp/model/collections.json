color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">4</span><span style=\"color:var(--shiki-foreground)\">);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">v</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">emplace_back</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">5</span><span style=\"color:var(--shiki-foreground)\">);</span><span style=\"color:var(--shiki-token-comment)\">            // 就地构造，省一次拷贝/移动</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">v</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">insert</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">v</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">begin</span><span style=\"color:var(--shiki-foreground)\">()</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-constant)\"> 0</span><span style=\"color:var(--shiki-foreground)\">);</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">v</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">erase</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-constant)\">v</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">begin</span><span style=\"color:var(--shiki-foreground)\">());</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">v</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">size</span><span style=\"color:var(--shiki-foreground)\">();  </span><span style=\"color:var(--shiki-token-constant)\">v</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">empty</span><span style=\"color:var(--shiki-foreground)\">();  </span><span style=\"color:var(--shiki-token-constant)\">v</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">clear</span><span style=\"color:var(--shiki-foreground)\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 没有「按值删一个」的成员函数 —— 要配 std::erase（C++20）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">std</span><span style=\"color:var(--shiki-token-punctuation)\">::</span><span style=\"color:var(--shiki-token-function)\">erase</span><span style=\"color:var(--shiki-foreground)\">(v</span><span style=\"color:var(--shiki-token-punctuation)\">,</span><span style=\"color:var(--shiki-token-constant)\"> 3</span><span style=\"color:var(--shiki-foreground)\">);</span></span></code></pre>",
