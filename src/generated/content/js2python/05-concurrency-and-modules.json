        "python": {
          "lang": "python",
          "equivalence": "divergent",
          "code": "from utils import helper        # ⚠ 没有 export：模块里所有名字默认可导入\nimport utils\n\ndef helper():\n    ...\n\n_internal = 1                   # 前导下划线是\"私有\"约定，只是约定\n\n# ⚠ import 会执行整个模块的顶层语句\nif __name__ == \"__main__\":      # 守卫：既能当模块导入，又能当脚本跑\n    main()\n\n# 包就是含 __init__.py 的目录，该文件在导入包时执行一次\n# 好处：没有 ESM / CJS 之分，不必配 \"type\": \"module\"",
          "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">from</span><span style=\"color:var(--shiki-foreground)\"> utils </span><span style=\"color:var(--shiki-token-keyword)\">import</span><span style=\"color:var(--shiki-foreground)\"> helper        </span><span style=\"color:var(--shiki-token-comment)\"># ⚠ 没有 export：模块里所有名字默认可导入</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">import</span><span style=\"color:var(--shiki-foreground)\"> utils</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">def</span><span style=\"color:var(--shiki-token-function)\"> helper</span><span style=\"color:var(--shiki-foreground)\">():</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">    ...</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">_internal </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> 1</span><span style=\"color:var(--shiki-token-comment)\">                   # 前导下划线是\"私有\"约定，只是约定</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\"># ⚠ import 会执行整个模块的顶层语句</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">if</span><span style=\"color:var(--shiki-token-constant)\"> __name__</span><span style=\"color:var(--shiki-token-keyword)\"> ==</span><span style=\"color:var(--shiki-token-string-expression)\"> \"__main__\"</span><span style=\"color:var(--shiki-token-punctuation)\">:</span><span style=\"color:var(--shiki-token-comment)\">      # 守卫：既能当模块导入，又能当脚本跑</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">    main</span><span style=\"color:var(--shiki-token-punctuation)\">()</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\"># 包就是含 __init__.py 的目录，该文件在导入包时执行一次</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\"># 好处：没有 ESM / CJS 之分，不必配 \"type\": \"module\"</span></span></code></pre>",
