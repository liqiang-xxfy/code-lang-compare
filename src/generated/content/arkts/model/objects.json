      "code": "class User {\n  name: string = \"匿名\";            // 实例字段要写类型（或由初值推断）\n  static count: number = 0;         // 静态字段挂在类上，全类共享一份\n\n  get display(): string { return this.name.toUpperCase(); }   // getter\n  set display(v: string) { this.name = v.trim(); }            // setter\n}\n\nconst u = new User();\nu.display;                          // 像属性一样读，背后调了 getter\nu.name = \"Ada\";                     // 赋值时类型要对得上\n// 字段必须在类里声明，不能随手加一个",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">class</span><span style=\"color:var(--shiki-token-function)\"> User</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  name</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> string</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-string-expression)\"> \"匿名\"</span><span style=\"color:var(--shiki-foreground)\">;            </span><span style=\"color:var(--shiki-token-comment)\">// 实例字段要写类型（或由初值推断）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  static</span><span style=\"color:var(--shiki-foreground)\"> count</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> number</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-constant)\"> 0</span><span style=\"color:var(--shiki-foreground)\">;         </span><span style=\"color:var(--shiki-token-comment)\">// 静态字段挂在类上，全类共享一份</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  get</span><span style=\"color:var(--shiki-token-function)\"> display</span><span style=\"color:var(--shiki-foreground)\">()</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> string</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">return</span><span style=\"color:var(--shiki-token-constant)\"> this</span><span style=\"color:var(--shiki-token-function)\">.</span><span style=\"color:var(--shiki-token-constant)\">name</span><span style=\"color:var(--shiki-token-function)\">.toUpperCase</span><span style=\"color:var(--shiki-foreground)\">(); }   </span><span style=\"color:var(--shiki-token-comment)\">// getter</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  set</span><span style=\"color:var(--shiki-token-function)\"> display</span><span style=\"color:var(--shiki-foreground)\">(v</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-constant)\"> string</span><span style=\"color:var(--shiki-foreground)\">) { </span><span style=\"color:var(--shiki-token-constant)\">this</span><span style=\"color:var(--shiki-foreground)\">.name </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-constant)\"> v</span><span style=\"color:var(--shiki-token-function)\">.trim</span><span style=\"color:var(--shiki-foreground)\">(); }            </span><span style=\"color:var(--shiki-token-comment)\">// setter</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">const</span><span style=\"color:var(--shiki-token-constant)\"> u</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-token-keyword)\"> new</span><span style=\"color:var(--shiki-token-function)\"> User</span><span style=\"color:var(--shiki-foreground)\">();</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">u</span><span style=\"color:var(--shiki-foreground)\">.display;                          </span><span style=\"color:var(--shiki-token-comment)\">// 像属性一样读，背后调了 getter</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-constant)\">u</span><span style=\"color:var(--shiki-foreground)\">.name </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-string-expression)\"> \"Ada\"</span><span style=\"color:var(--shiki-foreground)\">;                     </span><span style=\"color:var(--shiki-token-comment)\">// 赋值时类型要对得上</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 字段必须在类里声明，不能随手加一个</span></span></code></pre>",
