{ </span><span style=\"color:var(--shiki-token-constant)\">42</span><span style=\"color:var(--shiki-foreground)\"> }                  </span><span style=\"color:var(--shiki-token-comment)\">// 调用方不知道是 Int</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 关键事实：**类型参数在运行时是拿得到的** ——</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 泛型函数里可以写 `T.self`、可以 `T.self == Int.self`</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// ⚠ 这一点与「擦除式泛型」根本不同</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">func</span><span style=\"color:var(--shiki-token-function)\"> nameOf</span><span style=\"color:var(--shiki-token-punctuation)\">&#x3C;</span><span style=\"color:var(--shiki-foreground)\">T</span><span style=\"color:var(--shiki-token-punctuation)\">></span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-function)\">_</span><span style=\"color:var(--shiki-token-parameter)\"> x</span><span style=\"color:var(--shiki-foreground)\">: T) </span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-token-constant)\"> String</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-string-expression)\">\"</span><span style=\"color:var(--shiki-token-string-expression)\">\\(T.</span><span style=\"color:var(--shiki-token-keyword)\">self</span><span style=\"color:var(--shiki-token-string-expression)\">)</span><span style=\"color:var(--shiki-token-string-expression)\">\"</span><span style=\"color:var(--shiki-foreground)\"> }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">nameOf</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-constant)\">1</span><span style=\"color:var(--shiki-token-punctuation)\">)</span>