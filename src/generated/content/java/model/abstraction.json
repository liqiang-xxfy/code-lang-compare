\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// use(new HasClose());                // —— ⚠ 编译错误：没声明实现接口</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 想传进去只有两条路：让它 implements，或者包一层适配器</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">class</span><span style=\"color:var(--shiki-token-function)\"> HasCloseAdapter</span><span style=\"color:var(--shiki-token-keyword)\"> implements</span><span style=\"color:var(--shiki-token-function)\"> Closeable3</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  private</span><span style=\"color:var(--shiki-token-keyword)\"> final</span><span style=\"color:var(--shiki-token-keyword)\"> HasClose</span><span style=\"color:var(--shiki-foreground)\"> target;</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">  HasCloseAdapter</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">HasClose</span><span style=\"color:var(--shiki-foreground)\"> t) { </span><span style=\"color:var(--shiki-token-constant)\">this</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-constant)\">target</span><span style=\"color:var(--shiki-token-keyword)\"> =</span><span style=\"color:var(--shiki-foreground)\"> t; }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  public</span><span style=\"color:var(--shiki-token-keyword)\"> void</span><span style=\"color:var(--shiki-token-function)\"> close</span><span style=\"color:var(--shiki-foreground)\">() { </span><span style=\"color:var(--shiki-token-constant)\">target</span><span style=\"color:var(--shiki-token-punctuation)\">.</span><span style=\"color:var(--shiki-token-function)\">close</span><span style=\"color:var(--shik