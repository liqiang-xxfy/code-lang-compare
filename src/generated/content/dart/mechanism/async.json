      "code": "Future<String> fetch(int id) async {\n  await Future.delayed(const Duration(milliseconds: 100));\n  return '数据 $id';\n}\n\nFuture<void> main() async {\n  final a = await fetch(1);          // 顺序执行：一个一个来\n\n  // ⚠ Dart **允许在循环里 await** —— 官方样例就是这么写的\n  for (var i = 0; i < 3; i++) {\n    print(await fetch(i));            // 这是**串行**的，会一个等一个\n  }\n\n  // 想并行：先把 Future 收集起来，再一起等\n  final futures = [for (var i = 0; i < 3; i++) fetch(i)];\n  final all = await Future.wait(futures);\n\n  // `await for`：像循环一样消费一个 Stream（函数必须是 async）\n  await for (final chunk in streamOf()) { print(chunk); }\n}",
