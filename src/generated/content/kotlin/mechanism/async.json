en-function)\"> use</span><span style=\"color:var(--shiki-foreground)\">() {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  val</span><span style=\"color:var(--shiki-foreground)\"> a </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-function)\"> load</span><span style=\"color:var(--shiki-foreground)\">()                      </span><span style=\"color:var(--shiki-token-comment)\">// 不用传回调，直接拿返回值</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  val</span><span style=\"color:var(--shiki-foreground)\"> b </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-token-function)\"> load</span><span style=\"color:var(--shiki-foreground)\">()</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">  println</span><span style=\"color:var(--shiki-foreground)\">(a </span><span style=\"color:var(--shiki-token-keyword)\">+</span><span style=\"color:var(--shiki-foreground)\"> b)                      </span><span style=\"color:var(--shiki-token-comment)\">// 顺序清楚，没有嵌套</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 挂起函数只能在另一个挂起函数（或协程构建器）里调用</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 这不是「把回调藏起来」，是编译期把函数拆成了可恢复的状态机</span></span></code></pre>",
