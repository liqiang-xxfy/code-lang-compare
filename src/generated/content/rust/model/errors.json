      "code": "#[derive(Debug)]\nstruct TimeoutError { seconds: u64 }\n\nimpl fmt::Display for TimeoutError {\n  fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {\n    write!(f, \"超时 {} 秒\", self.seconds)\n  }\n}\nimpl Error for TimeoutError {}\n\n// 用 thiserror 这类库可以省掉样板代码：\n// #[derive(thiserror::Error, Debug)]\n// #[error(\"超时 {0} 秒\")]\n// struct TimeoutError(u64);\n\n// 错误链：用 source() 串起「底层原因」",
      "html": "<pre class=\"shiki css-variables\" style=\"background-color:var(--shiki-background);color:var(--shiki-foreground)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--shiki-foreground)\">#[derive(</span><span style=\"color:var(--shiki-token-function)\">Debug</span><span style=\"color:var(--shiki-foreground)\">)]</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">struct</span><span style=\"color:var(--shiki-token-function)\"> TimeoutError</span><span style=\"color:var(--shiki-foreground)\"> { seconds</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-function)\"> u64</span><span style=\"color:var(--shiki-foreground)\"> }</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">impl</span><span style=\"color:var(--shiki-foreground)\"> fmt</span><span style=\"color:var(--shiki-token-keyword)\">::</span><span style=\"color:var(--shiki-token-function)\">Display</span><span style=\"color:var(--shiki-token-keyword)\"> for</span><span style=\"color:var(--shiki-token-function)\"> TimeoutError</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  fn</span><span style=\"color:var(--shiki-token-function)\"> fmt</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-keyword)\">&#x26;</span><span style=\"color:var(--shiki-foreground)\">self, f</span><span style=\"color:var(--shiki-token-keyword)\">:</span><span style=\"color:var(--shiki-token-keyword)\"> &#x26;mut</span><span style=\"color:var(--shiki-foreground)\"> fmt</span><span style=\"color:var(--shiki-token-keyword)\">::</span><span style=\"color:var(--shiki-token-function)\">Formatter</span><span style=\"color:var(--shiki-foreground)\">) </span><span style=\"color:var(--shiki-token-keyword)\">-></span><span style=\"color:var(--shiki-foreground)\"> fmt</span><span style=\"color:var(--shiki-token-keyword)\">::</span><span style=\"color:var(--shiki-token-function)\">Result</span><span style=\"color:var(--shiki-foreground)\"> {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">    write!</span><span style=\"color:var(--shiki-foreground)\">(f, </span><span style=\"color:var(--shiki-token-string-expression)\">\"超时 {} 秒\"</span><span style=\"color:var(--shiki-foreground)\">, self</span><span style=\"color:var(--shiki-token-keyword)\">.</span><span style=\"color:var(--shiki-foreground)\">seconds)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">impl</span><span style=\"color:var(--shiki-token-function)\"> Error</span><span style=\"color:var(--shiki-token-keyword)\"> for</span><span style=\"color:var(--shiki-token-function)\"> TimeoutError</span><span style=\"color:var(--shiki-foreground)\"> {}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 用 thiserror 这类库可以省掉样板代码：</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// #[derive(thiserror::Error, Debug)]</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// #[error(\"超时 {0} 秒\")]</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// struct TimeoutError(u64);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 错误链：用 source() 串起「底层原因」</span></span></code></pre>",
