      "code": "// 元组：定长、每位类型可不同，位置本身携带语义\nconst pair: [string, number] = [\"Ada\", 36];      // 第一位 string、第二位 number\nconst named: [name: string, age: number] = [\"Bob\", 40];   // 命名元组：给位置起名\nconst maybe: [string, number?] = [\"x\"];          // 可选元素：尾部可以省\nconst tail: [string, ...number[]] = [\"x\", 1, 2]; // 剩余元素\n// const bad: [string, number] = [36, \"Ada\"];    // —— ⚠ 编译错误：顺序与类型都不能错\nconst ro: readonly [string, number] = [\"Ada\", 36];   // 只读元组\n\n// 记录：有名字的固定字段\ntype User = { id: number; name: string };\nconst u: User = { id: 1, name: \"Ada\" };\n// const v: User = { id: 1 };                    // —— ⚠ 编译错误：少一个字段也不行",
