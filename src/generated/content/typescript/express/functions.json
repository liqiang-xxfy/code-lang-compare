      "code": "function f(): void {}            // void 明确表示「不返回」\nfunction g() { return; }         // 推断成 void；不写 return 也是 void\n\n// 多返回值：用元组，每个位置有自己的类型\nfunction minMax(xs: number[]): [number, number] {\n  return [Math.min(...xs), Math.max(...xs)];\n}\nconst [lo, hi] = minMax([3, 1, 2]);   // 解构接回，lo / hi 各自是对应位置\n\n// 命名元组让调用点看得懂每个位置是什么\nfunction split(s: string): [head: string, tail: string] { return [s[0], s.slice(1)]; }\n\n// ⚠ 箭头函数直接返回对象字面量要加括号，否则 `{}` 被当成函数体\nconst obj = () => ({ a: 1 });",
