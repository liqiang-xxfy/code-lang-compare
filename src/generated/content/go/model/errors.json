ist) {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  fmt.</span><span style=\"color:var(--shiki-token-function)\">Println</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"文件不存在\"</span><span style=\"color:var(--shiki-foreground)\">)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">var</span><span style=\"color:var(--shiki-foreground)\"> pathErr </span><span style=\"color:var(--shiki-token-keyword)\">*</span><span style=\"color:var(--shiki-token-function)\">os</span><span style=\"color:var(--shiki-foreground)\">.</span><span style=\"color:var(--shiki-token-function)\">PathError</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">if</span><span style=\"color:var(--shiki-foreground)\"> errors.</span><span style=\"color:var(--shiki-token-function)\">As</span><span style=\"color:var(--shiki-foreground)\">(err, </span><span style=\"color:var(--shiki-token-keyword)\">&#x26;</span><span style=\"color:var(--shiki-foreground)\">pathErr) {   </span><span style=\"color:var(--shiki-token-comment)\">// 取出具体的错误类型</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">  fmt.</span><span style=\"color:var(--shiki-token-function)\">Println</span><span style=\"color:var(--shiki-foreground)\">(pathErr.Path)</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// recover 只能接住 panic，且在 defer 里才有效</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">defer</span><span style=\"color:var(--shiki-token-keyword)\"> func</span><span style=\"color:var(--shiki-foreground)\">() {</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">  if</span><span style=\"color:var(--shiki-foreground)\"> r </span><span style=\"color:var(--shiki-token-keyword)\">:=</span><span style=\"color:var(--shiki-token-function)\"> recover</span><span style=\"color:var(--shiki-foreground)\">(); r </span><span style=\"color:var(--shiki-token-keyword)\">!=</span><span style=\"color:var(--shiki-token-constant)\"> nil</span><span style=\"color:var(--shiki-foreground)\"> { fmt.</span><span style=\"color:var(--shiki-token-function)\">Println</span><span style=\"color:var(--shiki-foreground)\">(</span><span style=\"color:var(--shiki-token-string-expression)\">\"接住了\"</span><span style=\"color:var(--shiki-foreground)\">, r) }</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-foreground)\">}()</span></span></code></pre>",
