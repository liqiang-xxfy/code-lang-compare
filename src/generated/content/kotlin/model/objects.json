      "code": "class Cart                          // 没有 new：构造就是调用类名\nval c = Cart()\n\nclass User(val name: String)        // 主构造器写在类头里\ndata class Point(val x: Int, val y: Int)   // data class：自动生成 equals/hashCode/toString/copy\n\nobject Config {                     // object：声明式单例，全程序只有一个\n  val timeout = 30\n}\nConfig.timeout                      // 用类名直接访问\n\nclass User2(val name: String) {\n  companion object {                // 伴生对象：放「静态」成员的地方\n    fun create(n: String) = User2(n)\n  }\n}\nUser2.create(\"Ada\")\n\nsealed interface Shape              // sealed：实现者限定在本文件/本包，配合 when 做穷尽检查\nclass Circle(val r: Double) : Shape\n\nenum class Color { RED, GREEN }     // 枚举照常",
