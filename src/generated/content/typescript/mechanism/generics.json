      "code": "function first<T>(xs: T[]): T | undefined {   // 类型参数写在函数名之后\n  return xs[0];\n}\n\nclass Box<T> {\n  value: T;\n  constructor(v: T) { this.value = v; }\n}\n\ninterface Pair<K, V> { key: K; value: V }     // 接口也能带类型参数\n\nconst n = first([1, 2, 3]);   // 实参能推断出来，调用处不必写 <number>\nconst b = new Box(\"hi\");\n\ntype Mapper = <T>(x: T) => T;                 // 函数类型自己也能引入类型参数",
