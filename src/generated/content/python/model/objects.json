      "code": "class User:\n    def __init__(self, name, age=0):     # 不是构造函数，是初始化钩子\n        self.name = name\n        self.age = age\n\n    @classmethod\n    def from_dict(cls, d):                # 替代构造：类方法\n        return cls(d[\"name\"], d.get(\"age\", 0))\n\n    def __new__(cls, *a, **kw):           # 真要控制「造对象」才用它\n        return super().__new__(cls)\n\nUser(\"Ada\")                               # __new__ 先生成实例，再 __init__\nUser.from_dict({\"name\": \"Ada\"})",
