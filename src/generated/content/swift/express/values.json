r:var(--shiki-token-constant)\">count</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-token-comment)\">                // 可选链：为 nil 时整个表达式得 nil，不崩</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// print(b!.count)             // —— ⚠ 强制解包：为 nil 直接崩（等于 fatalError）</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-function)\">print</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">b </span><span style=\"color:var(--shiki-token-keyword)\">??</span><span style=\"color:var(--shiki-token-string-expression)\"> \"默认\"</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-token-comment)\">             // nil 时取右边</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">if</span><span style=\"color:var(--shiki-token-keyword)\"> let</span><span style=\"color:var(--shiki-foreground)\"> s </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> b { </span><span style=\"color:var(--shiki-token-function)\">print</span><span style=\"color:var(--shiki-token-punctuation)\">(</span><span style=\"color:var(--shiki-token-function)\">s.</span><span style=\"color:var(--shiki-token-constant)\">count</span><span style=\"color:var(--shiki-token-punctuation)\">)</span><span style=\"color:var(--shiki-foreground)\"> }        </span><span style=\"color:var(--shiki-token-comment)\">// if let：成功才进分支</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">guard</span><span style=\"color:var(--shiki-token-keyword)\"> let</span><span style=\"color:var(--shiki-foreground)\"> s </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> b </span><span style=\"color:var(--shiki-token-keyword)\">else</span><span style=\"color:var(--shiki-foreground)\"> { </span><span style=\"color:var(--shiki-token-keyword)\">return</span><span style=\"color:var(--shiki-foreground)\"> }        </span><span style=\"color:var(--shiki-token-comment)\">// guard let：失败就提前退出</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-keyword)\">while</span><span style=\"color:var(--shiki-token-keyword)\"> let</span><span style=\"color:var(--shiki-foreground)\"> next </span><span style=\"color:var(--shiki-token-keyword)\">=</span><span style=\"color:var(--shiki-foreground)\"> iterator.</span><span style=\"color:var(--shiki-token-function)\">next</span><span style=\"color:var(--shiki-token-punctuation)\">()</span><span style=\"color:var(--shiki-foreground)\"> { }   </span><span style=\"color:var(--shiki-token-comment)\">// while let：一直解到 nil 为止</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 可选链还能连着写：a?.b?.c —— 中间任一环为 nil，整条链就是 nil</span></span>\n<span class=\"line\"><span style=\"color:var(--shiki-token-comment)\">// 注意区别：`nil ?? nil` 的左侧类型必须是可选，`??` 的类型规则很严格</span></span></code></pre>",
