      "code": "val plain = \"双引号，转义照常：\\n \\t \\\\ \\\" \"\nval name = \"Ada\"\nval greet = \"你好，$name\"              // 模板：$ 后面直接跟变量名\nval long = \"共 ${name.length} 个字符\"  // 表达式要加花括号\n\nval raw = \"\"\"                 // 三引号：原样保留，转义符不生效\n  第一行\n  第二行 \\n 这里是真的反斜杠 n\n\"\"\".trimIndent()              // 配套方法：去掉公共缩进\n\nval path = \"C:\\\\Users\"         // 普通字符串里写 Windows 路径要双写反斜杠\nval rp = \"\"\"C:\\Users\"\"\"        // 三引号里不用 —— 这正是它最常用的一处\n\nval concat = \"a\" + \"b\"         // + 也能拼，但可读性不如模板",
