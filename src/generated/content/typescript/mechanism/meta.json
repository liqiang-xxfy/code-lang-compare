      "code": "class User {\n  constructor(readonly id: number, readonly name: string) {}\n}\n\nconst u = new User(1, \"Ada\");\nu.constructor.name;                             // \"User\"\nu instanceof User;                              // true\nObject.keys(u);                                 // 值上有什么字段，看得见\nObject.getPrototypeOf(u) === User.prototype;    // true\n\nReflect.has(u, \"name\");                         // Reflect 与 Proxy 的 trap 一一对应\nObject.hasOwn(u, \"name\");                       // 没有 Reflect.hasOwn 这个方法\n\n// 但**声明**的那一层拿不回来：接口、类型别名、类型实参编译后都不存在\ninterface Shape { area(): number }\n// const s = {} as Shape; s.area();             // —— ⚠ 编译通过，运行时才炸",
