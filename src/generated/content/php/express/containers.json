      "code": "// ⚠ PHP **没有独立的映射类型** —— 上面那个数组就是映射\n$user = [\n  \"name\" => \"Ann\",\n  \"age\"  => 30,\n  \"tags\" => [\"a\", \"b\"],       // 值可以是任意类型，包括数组\n];\n$user[\"city\"] = \"上海\";        // 插入\nunset($user[\"age\"]);           // 删除（unset 是语言构造，不是函数）\nisset($user[\"city\"]);          // 判断键存在 —— 但值为 null 时会返回 false\narray_key_exists(\"city\", $user);  // 想严格问「键在不在」用这个\n\n// ⚠ 保持插入顺序是**固有行为**，不需要 SortedMap 之类\n[\"z\" => 1, \"a\" => 2, \"m\" => 3];   // 遍历顺序就是 z、a、m\n\n// 排序是另外的动作，而且分成「保键 / 不保键」两组\n$m = [\"z\" => 1, \"a\" => 2];\nasort($m);                     // 按值排序、**保留键**\nksort($m);                     // 按键排序、保留键\nsort($m);                      // ⚠ 按值排序、**丢弃键**（重排成 0..n-1）\n\n// 想用**对象**当键，数组做不到 —— 要用 SPL 的 SplObjectStorage\n$store = new SplObjectStorage;\n$o = new stdClass;\n$store[$o] = \"与这个对象绑定的数据\";   // 按对象**身份**做键\necho $store[$o];\n\n// 定长数组也有：SplFixedArray（省内存，但没有字符串键）",
