      "code": "const [a, b = 2, ...rest] = [1];       // 数组解构 + 默认值 + 剩余\nconst { name, age: years = 0 } = user;  // 对象解构 + 改名 + 默认值\nconst { a: { b } } = nested;            // 嵌套\n\nfunction f({ x, y }) {}                 // 参数位置直接解构\n[a, b] = [b, a];                        // 交换\nconst [, second] = xs;                  // 跳过第一个",
