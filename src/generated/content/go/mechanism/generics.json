      "code": "func Largest[T cmp.Ordered](xs []T) (T, bool) {   // ⚠ 类型参数写在方括号里\n  var zero T\n  if len(xs) == 0 { return zero, false }\n  max := xs[0]\n  for _, x := range xs[1:] { if x > max { max = x } }\n  return max, true\n}\n\ntype Pair[T, U any] struct {                       // 类型也能泛型\n  First  T\n  Second U\n}\n\nfunc (p Pair[T, U]) Swap() Pair[U, T] {            // 方法上要重复类型参数\n  return Pair[U, T]{p.Second, p.First}\n}\n\nn, _ := Largest([]int{1, 2, 3})\ns, _ := Largest([]string{\"a\", \"b\"})",
