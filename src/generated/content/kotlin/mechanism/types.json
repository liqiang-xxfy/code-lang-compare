      "code": "var n = 1                    // 编译期推断为 Int，之后再赋值也只能给 Int\n// n = \"text\"                // —— ⚠ 编译错误：静态类型，值不能换门类\n\nval t = n::class             // JVM 运行时还带着类型：KClass 上能看到 Int\n\n// is 检查之后，编译器自动把变量当更具体的类型用，不用强转\nval x: Any = \"hello\"\nif (x is String) {\n  println(x.length)          // 这里 x 已经是 String，可以点出 .length\n}",
