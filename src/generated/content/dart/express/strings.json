      "code": "var a = '单引号';\nvar b = \"双引号等价\";              // 两种引号完全一样，选一种即可\nvar c = 'It\\'s';                   // 里面要用同种引号就转义，或者换另一种\n\nvar name = \"Ada\";\nvar greet = \"你好，$name\";          // $ 后直接跟变量名\nvar long = \"共 ${name.length} 个字符\";   // 表达式要加花括号\n\nvar raw = r'C:\\Users\\new';         // r 前缀：反斜杠不再转义\n\nvar multi = '''\n第一行\n第二行\n''';                               // 三引号：跨行，且**不处理转义**\n\nvar joined = 'Hello, '\n             'World';              // ⚠ 相邻字面量自动拼接，不需要 +\n\nvar dollar = '价格 \\$5';            // 普通字符串里 $ 要转义\nvar repeated = 'ab' * 3;           // \"ababab\"：字符串能乘",
